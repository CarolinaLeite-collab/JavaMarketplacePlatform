@startuml

'==== Title ====
title Genre Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura-Bold
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ArrowFontSize 14
skinparam PackageBorderColor #4B9DA9
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
Package "DOMAIN" {

    Package "VALUEOBJECT" <<Folder>> #d4b0b0 {
        class GenreId <<ValueObject>> #LightPink {
            -_id : String
            +toString() : String
        }
    }

    Package "GENRE" <<Folder>> #b0c4d4 {

        class Genre <<Entity>> <<Root>> #lightgrey {
            -_genre : String
            +getGenre() : String
            +identity() : GenreId
            +sameAs(Object) : boolean
        }

        class GenreFactory {
            +createGenre(String) : Genre
            +createGenre(GenreId, String) : Genre
        }

    }

    Package "REPOSITORY" <<Folder>> #d4c4b0 {
        interface IGenreRepo
    }

}

' ===== Persistence =====
Package "PERSISTENCE" {
    object MemoGenreRepo
}

' ===== Relations =====
Genre "1" -right-> "1 ID " GenreId : has

IGenreRepo "1" --> "*" Genre : manages
MemoGenreRepo ..right|> IGenreRepo

GenreFactory ..> Genre : <<create>>

@enduml