@startuml

'==== Title ====
title Country Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura-Bold
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ArrowFontSize 14
skinparam PackageBorderColor #4B9DA9
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
Package "DOMAIN" {

    Package "VALUEOBJECT" <<Folder>> #d4b0b0 {
        class CountryId <<ValueObject>> #LightPink {
            -_id : String
            +toString() : String
        }

        class CountryName <<ValueObject>> #LightYellow {
            -_name : String
            +toString() : String
        }
    }

    Package "COUNTRY" <<Folder>> #b0c4d4 {

        class Country <<Entity>> <<Root>> #lightgrey {
            -_countryId : CountryId
            -_countryName : CountryName
            +identity() : CountryId
            +sameAs(Object) : boolean
            +isNamed(CountryName) : boolean
        }

        class CountryFactory {
            +createCountry(String) : Country
            +createCountry(CountryId, CountryName) : Country
        }

    }

    Package "REPOSITORY" <<Folder>> #d4c4b0 {
        ' Declare the generic interface label in quotes to preserve angle brackets
        interface "IRepository<ID, T>" as IRepository {
            +save(T) : T
            +findAll() : Iterable<T>
            +ofIdentity(ID) : Optional<T>
            +containsOfIdentity(ID) : boolean
        }

        ' Country-specific repository extends generic repository (visualized)
        interface ICountryRepo {
            +save(Country) : Country
            +findAll() : Iterable<Country>
            +ofIdentity(CountryId) : Optional<Country>
            +containsOfIdentity(CountryId) : boolean
        }
    }

}

' ===== Persistence =====
Package "PERSISTENCE" {
    object MemoCountryRepo
}

' ===== Relations =====
Country "1" -right-> "1 ID" CountryId : has
Country *-- CountryName : has

ICountryRepo ..|> IRepository
ICountryRepo "1" --> "*" Country : manages
MemoCountryRepo ..|> ICountryRepo

CountryFactory ..> Country : <<create>>

@enduml

