@startuml

'==== Title ====
title Publication Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura-Bold
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ArrowFontSize 14
skinparam PackageBorderColor #4B9DA9
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
Package "DOMAIN" {

    Package "PUBLICATION" <<Folder>> #b0c4d4 {

        class Publication <<Entity>> <<Root>> #lightgrey {
            -_releaseYear : Year
            +isByAuthor(AuthorId) : boolean
            +isByGenre(GenreId) : boolean
            +identity() : PublicationId
            +sameAs(Object) : boolean
        }

        class PublicationFactory {
            +createPublication(Title, AuthorId, Year, PublicationTypeId, GenreId) : Publication
            +createPublication(PublicationId, Title, AuthorId, Year, PublicationTypeId, GenreId) : Publication
        }

    }

    ' ===== Value Objects próprios ====
    class PublicationId <<ValueObject>> #LightPink {
        -_id : String
        +toString() : String
    }

    class Title <<ValueObject>> #LightYellow {
    }

    '==== Cross-aggregate ID references ====
    class AuthorId <<ValueObject>> #LightYellow {
    }

    class GenreId <<ValueObject>> #LightYellow {
    }

    class PublicationTypeId <<ValueObject>> #LightYellow {
    }

    Package "REPOSITORY" <<Folder>> #d4c4b0 {
        interface IPublicationRepo
    }

}

' ===== Persistence =====
Package "PERSISTENCE" {
    object MemoPublicationRepo
}

' ===== Relations =====
Publication "1" --> "ID 1" PublicationId : has
Publication *-- Title : has
Publication ..> AuthorId : references
Publication ..> GenreId : references
Publication ..> PublicationTypeId : references

IPublicationRepo "1" --> "*" Publication : manages
MemoPublicationRepo ..|> IPublicationRepo

PublicationFactory ..> Publication : <<create>>

@enduml