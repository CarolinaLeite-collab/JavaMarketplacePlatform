@startuml

'==== Title ====
title Publication Aggregate


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction
' ===== Domain =====
Package "DOMAIN" {

    Package "PUBLICATION"  {

        class Publication <<Entity>> <<Root>> #lightgrey {
            -_releaseYear : Year
            +isByAuthor(AuthorId) : boolean
            +isByGenre(GenreId) : boolean
            +identity() : PublicationId
            +sameAs(Object) : boolean
        }

        class PublicationFactory <<Factory>> {
            +createPublication(Title, AuthorId, Year, PublicationTypeId, GenreId) : Publication
            +createPublication(PublicationId, Title, AuthorId, Year, PublicationTypeId, GenreId) : Publication
        }

    }

    Package "VALUEOBJECT"  {

        class PublicationId <<ValueObject>> #LightPink {
            -_id : String
            +toString() : String
        }

        class Title <<ValueObject>> #LightYellow {
        }

        class AuthorId <<ValueObject>> #LightYellow {
        }

        class GenreId <<ValueObject>> #LightYellow {
        }

        class PublicationTypeId <<ValueObject>> #LightYellow {
        }

    }

    Package "REPOSITORY" <<Folder>>  {
        interface IPublicationRepo <<Interface>>
    }

    Publication -[hidden]right- IPublicationRepo
    PublicationId -[hidden]right- IPublicationRepo

}

' ===== Persistence =====
Package "PERSISTENCE" {
     package "Memo" #c0d8d8 {
     class MemoPublicationRepo
    }
}

' ===== Relations =====
Publication "1" --> "ID 1" PublicationId : has
Publication --> Title : has
Publication ..> AuthorId : references
Publication ..> GenreId : references
Publication ..> PublicationTypeId : references


MemoPublicationRepo ..|> IPublicationRepo
Publication "*" <-- "1" MemoPublicationRepo : persists
PublicationFactory "1"<-- "1" MemoPublicationRepo : invokes
PublicationFactory ..> Publication : <<create>>

@enduml