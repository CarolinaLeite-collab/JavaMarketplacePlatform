@startuml
title US014 - "As a User, I want to get the list of official publication types" - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox

actor User

participant "UI : UserPublicationTypeList" as UI
participant "Ctrl : GetPublicationTypeListController" as CTRL
participant "_Ptr : IPublicationTypeRepo" as PTR

User -> UI : 1. I want to know all publication types
Activate UI
UI -> CTRL : 2. getListOfPublicationTypes()
Activate CTRL
CTRL -> PTR : 3. getAll()
Activate PTR

PTR --> CTRL : 4. PublicationTypeList
Deactivate PTR
CTRL --> UI : 5. PublicationTypeList
Deactivate CTRL
UI --> User : 6. Here's the list!
Deactivate UI

@enduml
