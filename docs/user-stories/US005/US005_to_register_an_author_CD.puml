@startuml

'==== Title ====
title US005 - "As an Administrator, I want to register an Author in the system, so that publications of that author can be added." - CD
top to bottom direction


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
class CreateAuthorUI {
}

package "controller" {

    class CreateAuthorController {
        +createAuthor(authorName : String) : Author

    }

}

package "persistence" {

    package "mem" {

        class MemoAuthorRepo {

        }

    }

}

package "domain" {

    package "repository" {

        interface IAuthorRepo <<Interface>> {
        + addAuthor(authorName : String) : Auhtor

        }

    }

    package author #b0c4d4 {

        class Author <<Root>> <<Entity>>{

            +identity() : AuthorId
            +sameAs(Object) : boolean
            +getName() : Name
            +getLowerCaseName() : String

        }

        class AuthorFactory <<Factory>> {
            +createAuthor(authorName : String) : Author
        }

    }

    Package "valueobject"  {

        '== Value Objects (Ids) ==
        class AuthorId <<ValueObject>> #LightPink {
        -_id : String

        }

    }

}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(T) : T
    findAll() : Iterable<T>
    findAllKeys() : List<ID>
    ofIdentity(ID) : Optional <T>
    containsOfIdentity(ID) : boolean
    }

}


'==== Interactions ====

CreateAuthorUI "1" ..> "1" CreateAuthorController : invokes

CreateAuthorController "1" ..> "1" IAuthorRepo : calls
CreateAuthorController "1" .> "*" Author : <<use>>

MemoAuthorRepo "1" --> "1" AuthorFactory : invokes

AuthorFactory "1" ..> "*" Author : <<create>>

Author "1" -> "ID 1" AuthorId : has

IAuthorRepo <|.. MemoAuthorRepo

IAuthorRepo ---|> IRepository

@enduml