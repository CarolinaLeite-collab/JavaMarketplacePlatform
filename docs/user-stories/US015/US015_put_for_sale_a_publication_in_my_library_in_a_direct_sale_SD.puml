@startuml
title US015 -"As a User, I want to put for sale a publication %n() in my library in a direct sale" - SD
hide footbox

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

actor User
participant ":PublicationInLibrary\nForDirectSaleUI" as UI
participant ":PublicationInLibrary\nForDirectSaleController" as Ctl
participant ":ILibraryRepo" as LibraryRepo
'participant "userLibrary:Library" as userLibrary
participant ":MemoDirectSaleRepo" as DirectSaleRepo
participant ":DirectSaleFactory" as DirectSaleFactory
participant "directSale:DirectSale" as directSale

User -> UI: I want to put for direct sale\nan item in my library!
activate UI

UI -> Ctl: getItemsIdInLibraryByUserId\n(userId)
activate Ctl

Ctl -> LibraryRepo: getItemsIdInLibraryByUserId\n(userId)
activate LibraryRepo
LibraryRepo --> Ctl: ListOfUserLibraryItemsId
deactivate LibraryRepo

Ctl --> UI: ListOfUserLibraryItemsId
deactivate Ctl
UI --> User: Which item\nwould you like to sell?
deactivate UI

User -> UI: item
activate UI

UI --> User: What is the price \nand time limit for this sale?
deactivate UI
User -> UI: price, time limit
activate UI

UI -> Ctl: addItemIdForDirectSale\n(itemID, price, timeLimit)
activate Ctl

Ctl -> DirectSaleRepo: addDirectSale\n(itemID, price, timeLimit)
activate DirectSaleRepo

DirectSaleRepo -> DirectSaleFactory: createDirectSale\n(itemID, price, timeLimit)
activate DirectSaleFactory
create directSale
DirectSaleFactory -->> directSale: <<create>>
DirectSaleFactory --> DirectSaleRepo: directSale
deactivate DirectSaleFactory

DirectSaleRepo -> DirectSaleRepo: add(directSale)
DirectSaleRepo --> Ctl: true
deactivate DirectSaleRepo

Ctl --> UI: true
deactivate Ctl
UI --> User: Your item was\nsuccessfully put up on a direct sale!
deactivate UI

@enduml