@startuml
'https://plantuml.com/class-diagram
title US009 – "As a user, I want to create my library" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class CreateLibraryUI {
}

class CreateLibraryController {
  + createLibrary(user:User) : Library
}

interface ILibraryRepo {
    +addLibrary(user:User) : Library
    +findLibraryByUser(user:User) : Library
}

class MemoLibraryRepo {
  - libraryExists(user:User) : boolean
  + addLibrary(user:User) : Library
  +findLibraryByUser(user:User) : Library

}
class LibraryFactory {
+ createLibrary(user:User) : Library
}

class Library {
  - _owner:User
  + Library(user:User)
  +belongsTo(user:User)
}

CreateLibraryUI "1" ..> "1" CreateLibraryController : invokes
CreateLibraryController "1" ..> "1" ILibraryRepo : calls
MemoLibraryRepo "1" ..|> "1" ILibraryRepo
MemoLibraryRepo "1" --> "1" LibraryFactory : uses
LibraryFactory "1" ..> "*" Library : <<create>>
MemoLibraryRepo "1" --> "*" Library : manages

@enduml