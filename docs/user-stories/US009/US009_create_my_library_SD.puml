@startuml
title US009 - "As a user, I want to create my library" - Level 2 SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant ":CreateLibraryUI" as UI
participant ":CreateLibraryController" as CTL
participant ":MemoLibraryRepo" as LR
participant ":LibraryFactory" as LF

' --- UI interaction ---
User -> UI: I want to create my library
activate UI


' --- Use case execution ---
UI -> CTL: createLibrary(userId)
activate CTL

CTL -> LR: addLibrary(userId)
activate LR

LR -> LR: LibraryId.fromUserId(userId)

    opt containsOfIdentity(libraryId) == false
        LR -> LF: createLibrary(libraryId)
        activate LF
        create "myLibrary:Library"
        LF -->> "myLibrary:Library": <<create>>
        LF --> LR: myLibrary
        deactivate LF

        LR -> LR: save(myLibrary)


    end

LR --> CTL: myLibrary
deactivate LR

CTL --> UI: myLibrary
deactivate CTL

UI --> User: done!
deactivate UI

@enduml