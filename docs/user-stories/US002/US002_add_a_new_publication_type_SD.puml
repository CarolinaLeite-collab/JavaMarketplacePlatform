@startuml
title US002 - "As an administrator, I want to add a publication type to the official type list, %n() so that new publications can be of this type" %n()SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor "Administrator" as Admin
participant ":AddPublicationTypeUI" as UI
participant ":AddPublicationTypeCtl" as Ctl
participant ":MemoPublicationTypeRepo" as REPO
participant ":PublicationTypeFactory" as FACTORY

' --- System dialog ---
Admin -> UI: I want to add a %n()new publication type.
activate "UI"
UI --> Admin: What type would %n()you like to add?
deactivate "UI"
Admin -> UI: publicationTypeName
activate "UI"
UI -> Ctl: addPublicationType %n() (publicationTypeName)
activate "Ctl"
Ctl -> REPO: addPublicationType %n() (publicationTypeName)
activate "REPO"
REPO -> FACTORY: createPublicationType%n()(publicationTypeName)
activate FACTORY
create "newPublicationType %n() :PublicationType" as instance
FACTORY -->> instance: <<create>>
FACTORY --> REPO: newPublicationType
deactivate FACTORY
note right of REPO
  assuming happy path:
  containsOfIdentity(newPublicationType.identity())
   == false
end note
REPO -> REPO: save(newPublicationType)
REPO --> Ctl: newPublicationType
deactivate "REPO"
Ctl --> UI: newPublicationType
deactivate "Ctl"
UI --> Admin: publicationTypeName %n()was successfully added %n()to the official type list as %n()newPublicationType.
deactivate "UI"

@enduml