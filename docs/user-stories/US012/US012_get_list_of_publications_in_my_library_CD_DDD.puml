@startuml
'https://plantuml.com/class-diagram
title US012 – "As a User, I want to get the list (title, author, type \nand ISBN/ISSN) of publications in my library" - CD DDD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

class ListOfItemsInMyLibraryUI {
}

package "CONTROLLER" {

    class ListOfItemsInMyLibraryController {
      + getListOfItemDetails(userId : UserId) : List<PublicationDetails>
    }

}

package "DOMAIN" {

package "REPOSITORY" {

    interface ILibraryRepo <<Interface>> {
        +findLibraryByUserId(userId : UserId) : Library
    }

}

package "VALUE OBJECT" {

together {
        class LibraryId <<Value Object>> #lightpink {
        +fromUserId(userId : UserId) : LibraryId
        }
        class UserId <<Value Object>>
    }
    class PublicationDetails <<Value Object>>
    class ItemId <<Value Object>>

}

package "LIBRARY" #b0c4d4 {

    class Library <<Root>> <<Entity>> {
      +getItemIdDetails() : List <PublicationDetails>
    }

}

}

package "PERSISTENCE"  {

    package "MEM" {

        class MemoLibraryRepo {
        }

    }

}

Package "DDD" {

    interface IRepository<ID, T> <<Interface>> {
'    save(T) : T
    findAll() : Iterable<T>
    ofIdentity(ID) : Optional <T>
    containsOfIdentity(ID) : boolean
    }

}

ListOfItemsInMyLibraryUI "1" ..> "1" ListOfItemsInMyLibraryController : invokes

ListOfItemsInMyLibraryController "1" ..> "1" ILibraryRepo : calls
ListOfItemsInMyLibraryController "1" ..> "*" Library : <<use>>
ListOfItemsInMyLibraryController "1" ..> "*" UserId : <<use>>
ListOfItemsInMyLibraryController  "1" .....> "*" PublicationDetails : receives

MemoLibraryRepo ....|> ILibraryRepo
MemoLibraryRepo "1" ---> "*" Library: persists

Library "1" --> "1" LibraryId: has
Library "1" ..> "*" PublicationDetails: returns
Library "1" o-- "*" ItemId : aggregates
LibraryId "1" .> "1" UserId: <<use>>

ILibraryRepo --|> IRepository

@enduml