@startuml
title "US003 - As an Administrator, I want to add a publication genre to the official \ngenre list, so that new publications can be of this genre - CD"

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'==== Classes ====
class AddGenreUI {

}

class AddGenreController {
    - _admin : User
    + addGenre(genreName : String) : Genre
}

interface IGenreRepo {
    + addGenre(genreName : String) : Genre
}

class MemoGenreRepo {
    - genreExists(genreName : String) : boolean
}

class GenreFactory {
    + createGenre(genreName : String) : Genre
}

class Genre {
    - _genre : String
    + Genre(genre : String)
}

'==== Relationships ====
AddGenreUI "1" ..> "1" AddGenreController : uses
AddGenreController "1" --> "1" IGenreRepo : uses
MemoGenreRepo "1" ..|> "1" IGenreRepo
MemoGenreRepo "1" --> "_genreFactory 1" GenreFactory : uses
MemoGenreRepo "1" -----> "_genresList *" Genre : manages
GenreFactory "1" --> "*" Genre : creates

note right of AddGenreController
    Right now, User is simply
    required for Controller's
    constructor
endNote

@enduml