@startuml
'https://plantuml.com/class-diagram
title US026 - As a Buyer, I want to get the list of items on auction of a given author - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetItemsOnAuctionOfAGivenAuthorUI {

}

class GetItemsOnAuctionOfAGivenAuthorCtl {
-_iAuctionRepo : IAuctionRepo
+ getAuctionItemsIdByAuthorId(authorID: AuthorID) : List<ItemId>
}

interface IAuctionRepo{

+ getAuctionItemsIdByAuthorId(authorID: AuthorID) : List<ItemId>
}

class MemoAuctionRepo {
- _itemsOnAuction : List<AuctionID>
}

class Auction {
+ isByAuthorId(authorID: AuthorID) : boolean
+ getItemId() : ItemId
}

class Item {

+ isByAuthorId(authorID: AuthorID) : boolean

}

class Publication {

+ isByAuthorId(authorID: AuthorID) : boolean

}

class Author {

- authorID : AuthorID

}

GetItemsOnAuctionOfAGivenAuthorUI "1" ..> "1" GetItemsOnAuctionOfAGivenAuthorCtl : invokes
GetItemsOnAuctionOfAGivenAuthorCtl "1" ..> "1" IAuctionRepo : calls
MemoAuctionRepo ..|> IAuctionRepo
MemoAuctionRepo "1" --> "*" Auction : accesses
Auction "1" --> "1" Item : contains
Item "1" --> "1" Publication : contains
Publication "1" --> "1" Author : contains

@enduml