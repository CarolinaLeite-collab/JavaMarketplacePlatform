@startuml
'https://plantuml.com/class-diagram

title US022 "As a Buyer, I want to get the list of items on auction of a given genre"  - CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class getAuctionItemsUI{}

package "CONTROLLER" {
    class GetAuctionItemsByGenreController {
        -_iAuctionRepo : IAuctionRepo
        +getAuctionItemsByGenreId(genreId: GenreId): List<ItemId>
    }
}

package "PERSISTENCE" {
    package "MEM" {
        class MemoAuctionRepo {
            -_itemsOnAuction : List<Auction>
        }
    }
}

package "DDD" {
    interface IRepository<ID, T> <<Interface>> {
        save(T) : T
        findAll() : Iterable<T>
        ofIdentity(ID) : Optional <T>
        containsOfIdentity(ID) : boolean
    }
}

package "DOMAIN" {
    package "REPOSITORY" {
        interface IAuctionRepo {
            +getAuctionItemsByGenreId(genreId: GenreId): List<ItemId>
        }
    }


    package "VALUE OBJECT" {
        class GenreId <<Value Object>>
    }



    package "AUCTION" #b0c4d4 {
        class Auction <<Root>> <<Entity>> {
            +isByGenreId(genreId:GenreId)
        }
    }
}

getAuctionItemsUI "1".>"1" GetAuctionItemsByGenreController:invokes
GetAuctionItemsByGenreController "1"..> "1" IAuctionRepo : uses
IAuctionRepo <|.. MemoAuctionRepo
MemoAuctionRepo "1" --> "*"Auction : persists
IAuctionRepo --|> IRepository
Auction "1" -> "1" GenreId : references


@enduml