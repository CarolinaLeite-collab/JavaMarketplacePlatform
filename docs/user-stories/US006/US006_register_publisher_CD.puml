@startuml
'https://plantuml.com/class-diagram
title US006 – "As an Administrator, I want to register a Publishing Company in the system" %n() CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class RegisterPublishingCompanyUI {
}

package "persistence" {
    package "memo" {
        class MemoPublishingCompanyRepo {
        + registerPublishingCompany(publishingCompanyName: String) : PublishingCompany
        }
    }
}

package "controller" {
    class RegisterPublishingCompanyController {
    + registerPublishingCompany(publishingCompanyName: String) : PublishingCompany
    }
}

package "domain" {
    package "publishingcompany" #b0c4d4 {
        class PublishingCompany <<Root>> <<Entity>> {
        }
        class PublishingCompanyFactory <<Factory>> {
        + createPublishingCompany(publishingCompanyName : String) : PublishingCompany
        }

    }
    package "repository" {
        interface IPublishingCompanyRepo {
        }
    }

    package "valueobject" {
        class PublishingCompanyId <<Value Object>> #LightPink {
        }
    }

}

package "ddd" {
    interface IRepository <ID, T> <<Interface>> {
        save(entity : T) : T
        findAll() : Iterable<T>
        ofIdentity(id : ID) : Optional <T>
        containsOfIdentity(id : ID) : boolean
    }
}

RegisterPublishingCompanyUI "1" ..> "1" RegisterPublishingCompanyController: invokes
RegisterPublishingCompanyController "1" --> "1" IPublishingCompanyRepo: calls
MemoPublishingCompanyRepo ..|> IPublishingCompanyRepo
IPublishingCompanyRepo --|> IRepository
MemoPublishingCompanyRepo "1" --> "1" PublishingCompanyFactory: <<use>>
PublishingCompanyFactory "1" ..> "*" PublishingCompany: <<create>>
MemoPublishingCompanyRepo "1" --> "*" PublishingCompany: persists
PublishingCompany "1" --> "1" PublishingCompanyId: has

@enduml