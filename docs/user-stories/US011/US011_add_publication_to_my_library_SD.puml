@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title US011 - to add a publication to my library.

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off


actor User
participant ":AddPublicationUI" as UI
participant ":AddPublicationOnLibraryCtl" as CTL
participant ":ILibraryRepo" as LIBREPO
participant "myLibrary:Library" as LIB
participant ":IItemRepo" as ITEMREPO

User -> UI : I want to add an Item to my library
activate UI
UI -> CTL : getListOfAvailableItems(userId)
activate CTL
CTL -> LIBREPO : getMyLibrary(userId)
activate LIBREPO
LIBREPO --> CTL : myLibrary
deactivate LIBREPO
CTL -> LIB : getAllItems()
activate LIB
LIB -> LIB : copyList
LIB --> CTL : List<Items>
deactivate LIB
CTL -> ITEMREPO : getDifferentOf(existentItems)
activate ITEMREPO
ITEMREPO -> ITEMREPO : copyList
ITEMREPO --> CTL : List<Items>
deactivate ITEMREPO
CTL --> UI : List<Items>
deactivate CTL
UI --> User : Select what available items you want to add
deactivate UI
User -> UI : Selection
activate UI
UI -> CTL : addItemToLibrary(selectedItem, userId)
activate CTL
CTL -> LIB : addItemToLibrary(selectedItem, userId)
activate LIB
LIB -> LIB : addItemToLibrary(selectedItem)
LIB --> CTL : true
deactivate LIB
CTL --> UI : true
deactivate CTL
UI --> User : Done!
deactivate UI

@enduml