@startuml
'https://plantuml.com/sequence-diagram

autonumber
title US028 "As a Buyer, I want to get the list of items on auction of a given publisher" - SD

hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---'
actor Buyer
participant ":GetAuctionItems\nByPublisherUI" as UI
participant ":GetAuctionItems\nByPublisherController" as Ctl
participant ":MemoAuctionRepo" as MemoRepo
participant "_auction:Auction" as auction

' --- Initial UI interaction ---'
Buyer -> UI:  I want to get the list of items\n on auction of a given publisher
activate UI
UI --> Buyer: What is the publisher?
deactivate UI
Buyer -> UI: publisherID
activate UI

' --- Get auction items ---'
UI -> Ctl: getAuctionItems\nByPublisher(publisherID)
activate Ctl
Ctl -> MemoRepo: getAuctionItems\nByPublisher(publisherID)
activate MemoRepo

'--- Loop through items and select by Publisher ---'
create "listOfAuctionItems\nByPublisher: List<Item>" as List
MemoRepo -->> List : <<create>>
loop for each Auction in MemoAuctionRepo
     MemoRepo -> auction: isByPublisher(publisherID)
    opt isByPublisher == true
        MemoRepo -> List: add(auction.getItem())
        activate List
        List --> MemoRepo :true
        Deactivate List
    end
end

'--- Make a copy of the list of selected items ---'
create "copyListOfAuctionItems\nByPublisher: List<Item>" as Copy
MemoRepo -->> Copy : <<create>>
MemoRepo --> Ctl : copyListOfAuctionItems\nByPublisher
deactivate MemoRepo
Ctl --> UI: copyListOfAuctionItems\nByPublisher
deactivate Ctl

'--- Response ---'
UI --> Buyer: Here's the list!
deactivate UI

@enduml