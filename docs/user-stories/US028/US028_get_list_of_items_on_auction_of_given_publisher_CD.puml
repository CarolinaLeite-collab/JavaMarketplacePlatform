@startuml
'https://plantuml.com/class-diagram

title US028 "As a Buyer, I want to get the list of items\non auction of a given publisher" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class getAuctionItemsByPublisherUI{}

class GetAuctionItemsByPublishingCompanyController {
-_iAuctionRepo : IAuctionRepo
+getAuctionItemsByPublishingCompany(publisherID : PublisherID) : List<Item>
}

Interface IAuctionRepo {
-_auctionList : List<Auction>
+getAuctionItemsByPublishingCompany(publisher : Publisher) : List<Item>
}

class MemoAuctionRepo {
-_auctionList : List<Auction>
}

class Auction {
+ isByPublisher(publisherID : PublisherID) : boolean
+ getItem(): Item
}

class Item {
+ isByPublisher(publisherID : PublisherID) : boolean
}

class Publication {
+ isByPublisher(publisherID : PublisherID) : boolean
}

class Publisher {
- publisherID : PublisherID
}

'--- Interactions ---'

getAuctionItemsByPublisherUI "1"..>"1" GetAuctionItemsByPublishingCompanyController: invokes
GetAuctionItemsByPublishingCompanyController "1"..> "1" IAuctionRepo : uses
MemoAuctionRepo "1" ..|> "1" IAuctionRepo: relies on
MemoAuctionRepo "1" --> "*" Auction : accesses
Auction "1" --> "1" Item : contains
Item "1" --> "1" Publication : has
Publication "1" --> "1" Publisher : has


@enduml