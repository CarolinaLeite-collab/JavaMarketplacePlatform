@startuml
'https://plantuml.com/class-diagram
title US024 - "As a Buyer, I want to get the list of items on auction of a given publication" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam ArrowColor #57595BAA


class GetAuctionItemsByPublicationUI {

}

class GetAuctionItemsByPublicationController {
- _iar : IAuctionRepo
+ getAuctionItemsByPublication(publicationID : PublicationID) : List<Item>
}

interface IAuctionRepo{
+ getAuctionItemsByPublication(publicationID: publicationID) : List<Item>
}

class MemoAuctionRepo {
- _itemsOnAuction : List<Auction>
}

class Auction {
+isByPublication(publicationID : PublicationID) : boolean
+ getItem() : Item
}

class Item {
+ isByPublication(publicationID : PublicationID) : boolean
}

class Publication {
- publicationID : PublicationID
}

GetAuctionItemsByPublicationUI "1" ..> "1" GetAuctionItemsByPublicationController : invokes
GetAuctionItemsByPublicationController "1" ..> "1" IAuctionRepo : calls
MemoAuctionRepo ..|> IAuctionRepo
MemoAuctionRepo "1" --> "*" Auction : contains
Auction "1" --> "1" Item : contains
Item "1" --> "1" Publication : contains

@enduml