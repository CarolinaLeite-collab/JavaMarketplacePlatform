@startuml
'https://plantuml.com/class-diagram
title US024 - "As a Buyer, I want to get the list of items on auction of a given publication" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetAuctionItemsByPublicationUI{}

package "controller" {
    class GetAuctionItemsByPublicationController {
        +getAuctionItemsByPublicationId(publicationId : PublicationId) : List<ItemId>
        +findAllKeys() : List<PublicationId>
    }
}

package "ddd" {
    interface IRepository<ID, T> <<Interface>>
}

package "domain" {
    package "repository" {
        interface IPublicationRepo <<Interface>> {
            +findAllKeys() : List<PublicationId>
        }
        interface IAuctionRepo <<Interface>> {
            +findAll() : Iterable<Auction>
        }
        interface IItemRepo <<Interface>> {
            +ofIdentity(id : ItemId) : Optional<Item>
        }
        interface IEditionRepo <<Interface>> {
            +ofIdentity(id : EditionId) : Optional<Edition>
        }
    }

    package "valueobject" {
        class ItemId <<Value Object>>
        class EditionId <<Value Object>>
        class PublicationId <<Value Object>>
    }

    package "auction" #b0c4d4 {
        class Auction <<Root>> <<Entity>> {
            getItemsId() : List<ItemId>
        }
    }

    package "item" {
        class Item <<Root>> <<Entity>> {
            +getEditionId() : EditionId
        }
    }

    package "edition" {
        class Edition <<Root>> <<Entity>> {
            +isByPublicationId() : boolean
        }
    }
}

GetAuctionItemsByPublicationUI "1".>"1" GetAuctionItemsByPublicationController : invokes

GetAuctionItemsByPublicationController "1" ..> "1" IAuctionRepo : <<use>>
GetAuctionItemsByPublicationController "1" ..> "1" IItemRepo : <<use>>
GetAuctionItemsByPublicationController "1" ..> "1" IEditionRepo : <<use>>
GetAuctionItemsByPublicationController "1" ..> "1" IPublicationRepo : <<use>>

IAuctionRepo ---|> IRepository
IItemRepo ---|> IRepository
IEditionRepo ---|> IRepository
IPublicationRepo ---|> IRepository

IAuctionRepo "1" --> "*" Auction : manages
IItemRepo "1" --> "*" Item : manages
IEditionRepo "1" --> "*" Edition : manages

Auction "1" o-- "1..*" ItemId : aggregates
Item "1" --> "1" EditionId : has
Item "1" --> "1" ItemId : has
Edition "1" --> "1" PublicationId : has
Edition "1" --> "1" EditionId : has


@enduml