@startuml
'https://plantuml.com/class-diagram
title US024 - "As a Buyer, I want to get the list of items on auction of a given publication" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetAuctionItemsByPublicationUI {

}

package "CONTROLLER" {
    class GetAuctionItemsByPublicationController {
        - _iar : IAuctionRepo
        + getAuctionItemsByPublicationId(publicationId : PublicationId) : List<Item>
    }
}

package "PERSISTENCE" {
    package "MEM" {
        class MemoAuctionRepo
    }
}

package "DDD" {
    interface IRepository <ID, T> <<Interface>> {
        save(T) : T
        findAll() : Iterable<T>
        ofIdentity(ID) : Optional <T>
        containsOfIdentity(ID) : boolean
    }
}

package "DOMAIN" {
    package "REPOSITORY" {
        interface IAuctionRepo{
            + getAuctionItemsByPublicationId(publicationId: PublicationId) : List<ItemId>
        }
    }

    package "VALUE OBJECT" {
        class PublicationId <<Value Object>>
        class ItemId <<Value Object>>
    }

    package "AUCTION" #b0c4d4 {
        class Auction <<Root>> <<Entity>> {
            +isByPublicationId(publicationId : PublicationId) : boolean
            + getItemId() : List<ItemId>
        }
    }

    package "ITEM" {
        class Item <<Entity>> {
            + isByPublicationId(publicationId : PublicationId) : boolean
        }
    }
}

GetAuctionItemsByPublicationUI "1" .> "1" GetAuctionItemsByPublicationController : invokes
GetAuctionItemsByPublicationController "1" ..> "1" IAuctionRepo : uses
MemoAuctionRepo ..|> IAuctionRepo
MemoAuctionRepo "1" --> "*" Auction : persists
Auction "1" --> "1..*" ItemId : has
Item "1" --> "1" ItemId : has
Item "1" --> "1" PublicationId : references
IAuctionRepo ---|> IRepository

@enduml