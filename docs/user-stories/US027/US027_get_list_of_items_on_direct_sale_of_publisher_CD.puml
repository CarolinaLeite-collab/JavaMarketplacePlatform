@startuml
'https://plantuml.com/class-diagram
title US027 - As a Buyer, I want to get the list of items on direct sale of a given publisher - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class GetItemsOnDirectSaleOfAGivenPublisherUI {

}

class GetItemsOnDirectSaleOfAGivenPublisherCtl {
- _dsr : DirectSaleRepo
+ getDirectSaleItemsByPublisher(publisherName) : List<Item>
}

class DirectSaleRepo {
+ getDirectSaleItemsByPublisher(publisherName) : List<Item>
}

class DirectSale {
+isByPublisher(publisherName) : boolean
}

GetItemsOnDirectSaleOfAGivenPublisherUI "1" ..> "1" GetItemsOnDirectSaleOfAGivenPublisherCtl : invokes
GetItemsOnDirectSaleOfAGivenPublisherCtl "1" ..> "1" DirectSaleRepo : calls
DirectSaleRepo "1" --> "*" DirectSale : contains
@enduml