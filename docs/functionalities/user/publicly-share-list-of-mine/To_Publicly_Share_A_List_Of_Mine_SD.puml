@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title To publicly share a List of mine.


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black


actor User
participant "UI1:ShareListPubliclyUI"
participant "Ctl:ShareListPubliclyController"
participant ":IListOfPublicationsRepo"
participant "selectedList:ListOfPublications"


User -> "UI1:ShareListPubliclyUI" : I want to publicly share one List of mine.
"UI1:ShareListPubliclyUI" -> "Ctl:ShareListPubliclyController" : findListsByUser()
"Ctl:ShareListPubliclyController" -> ":MemoListOfPublicationsRepo" : findListsByUser()
":MemoListOfPublicationsRepo" -> ":MemoListOfPublicationsRepo" : copy
":MemoListOfPublicationsRepo" --> "Ctl:ShareListPubliclyController" : listOfLists
"Ctl:ShareListPubliclyController" --> "UI1:ShareListPubliclyUI" : listOfLists
"UI1:ShareListPubliclyUI" --> User : What List do you want to share?
User -> "UI1:ShareListPubliclyUI" : Selected List
"UI1:ShareListPubliclyUI" -> "Ctl:ShareListPubliclyController" : shareListPublicly(selectedList)
"Ctl:ShareListPubliclyController" -> "selectedList:ListOfPublications" : switchVisibility()
"Ctl:ShareListPubliclyController" --> "UI1:ShareListPubliclyUI" : true
"UI1:ShareListPubliclyUI" --> User : List is now public




@enduml