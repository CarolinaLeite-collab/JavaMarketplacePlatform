@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title To publicly share a List of mine.


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black


actor User
participant ":ShareListPubliclyUI" as UI
participant ":ShareListPublicly\nController" as Ctl
participant ":IListOfItems\nRepo" as IListsRepo
participant ":MemoListOfItems\nRepo" as MemListsRepo
participant "selectedList:ListOfItems" as list


User -> UI : I want to publicly share one List of mine.
activate UI
UI -> Ctl : findListsByUser(userId)
activate Ctl
Ctl -> MemListsRepo : findListsByUser(userId)
activate MemListsRepo
MemListsRepo -> MemListsRepo : copy
MemListsRepo --> Ctl : copyListOfLists
deactivate MemListsRepo
Ctl --> UI : copyListOfLists
deactivate Ctl
UI --> User : What List do you want to share?
deactivate UI
User -> UI : listsOfItemsId
activate UI
UI -> Ctl : shareListPublicly\n(listsOfItemsId)
activate Ctl
Ctl -> list: switchVisibility()
Ctl --> UI : true
deactivate Ctl
UI --> User : List is now public
deactivate UI




@enduml