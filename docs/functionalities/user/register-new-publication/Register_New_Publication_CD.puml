@startuml
'https://plantuml.com/class-diagram
title "As a User, I want to register a new publication in the system" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'==== classes ====
class RegisterPublicationUI {}

package "controller" {
class RegisterNewPublicationController {
  + registerPublication(Title title, AuthorId authorId, Year releaseYear,\nGenreId genreId) : Publication
}
}

package "domain"{

    package "valueobject"{
        class PublicationId <<ValueObject>> #lightpink {
        }
        class Title <<ValueObject>>{
        }
        class AuthorId <<ValueObject>>{
        }
        class GenreId <<ValueObject>>{
        }
    }

    package "repository" {
        interface IPublicationRepo <<Interface>> {
         }
    }

    package "publication" #b0c4d4 {

        class Publication  <<Root>> <<Entity>> {
            - _publicationYear: Year
             +sameAs(object : Object)
             +identity() : PublicationId
        }

        class PublicationFactory <<Factory>> {
            + createPublication(Title title, AuthorId authorId, Year releaseYear,\n GenreId genreId) : Publication
        }
    }
}
    package "persistence"  {
       package "mem" {
          class MemPublicationRepo{
          }
       }
    }


  package ddd {

       interface IRepository<ID, T> <<Interface>> {
          save(entity:T) : T
          findAll() : Iterable<T>
          findAllKeys () : List <ID>
          ofIdentity(id: ID) : Optional <T>
          containsOfIdentity(id: ID) : boolean
          }

       interface AggregateRoot <ID >{
                }
        interface DomainEntity<ID, T> <<Interface>> {
                       +identity() : ID
                       +sameAs(object:Object) : boolean
               }

  }

'==== relations ====
RegisterPublicationUI "1" ..> "1" RegisterNewPublicationController : invokes

RegisterNewPublicationController "1" ..> "1" IPublicationRepo: <<use>>
RegisterNewPublicationController "1" ..> "*" Publication : <<use>>

MemPublicationRepo .|> IPublicationRepo
RegisterNewPublicationController "1" ---> "1" PublicationFactory : invokes
MemPublicationRepo "1" -----> "*" Publication : persists

PublicationFactory "1" ..> "*" Publication : <<create>>


Publication "1" --> "1" PublicationId: has
Publication "*" ..> "1" AuthorId : references
Publication "*" --> "1" Title : has
Publication "*" ..> "1" GenreId : references

IPublicationRepo --|> IRepository

AggregateRoot -|> DomainEntity
Publication .|> AggregateRoot

@enduml