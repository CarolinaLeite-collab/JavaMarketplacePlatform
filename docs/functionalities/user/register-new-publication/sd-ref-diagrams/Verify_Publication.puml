@startuml
'==== Title ====
title "As a User, I want to register a new publication in the system" - SD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber


' ==== Actor and participants ====
participant ":Register\nNewPublication\nController" as CTL
participant "publication:Publication" as Publication
participant ":IPublication\nRepo" as IREPO
participant ":IPublication\nSpringDataRepo" as SDREPO
database "DB" as DB

activate CTL
CTL -> Publication : identity()
activate Publication
Publication --> CTL : publicationId
deactivate Publication
CTL -> IREPO: containsOfIdentity\n(publicationId)
activate IREPO
IREPO -> SDREPO : containsOfIdentity\n(publicationId.toString())
activate SDREPO
SDREPO -> DB : select
activate DB
DB --> SDREPO : false
deactivate DB
SDREPO --> IREPO : false
deactivate SDREPO
IREPO --> CTL : false
deactivate IREPO

ref over CTL
[[../Register_New_Publication_SD.puml Back to Main Diagram]]
end ref

'deactivate CTL

@enduml