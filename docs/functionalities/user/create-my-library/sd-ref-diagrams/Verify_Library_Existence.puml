@startuml
title "Verify Library Existence"

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

hide footbox
autonumber

participant ":CreateLibraryController" as CTL
participant "myLibrary:Library" as LIB
participant ":JpaLibraryRepo" as JPAREPO
participant ":ILibrarySpringDataRepo" as SDREPO

activate CTL
CTL -> LIB : identity()
activate LIB
LIB --> CTL : libraryId
deactivate LIB

CTL -> JPAREPO : containsOfIdentity(libraryId)
activate JPAREPO

JPAREPO -> SDREPO : existsById(libraryId.toString())
activate SDREPO
SDREPO --> JPAREPO : boolean
deactivate SDREPO

JPAREPO --> CTL : exists
deactivate JPAREPO
@enduml