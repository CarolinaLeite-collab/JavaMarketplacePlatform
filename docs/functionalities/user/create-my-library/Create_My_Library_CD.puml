@startuml
'https://plantuml.com/class-diagram
title "As a user, I want to create my library" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

class CreateLibraryUI {
}

package "controller" {

    class CreateLibraryController {
        + createLibrary(userId : UserId) : boolean
    }

}

package "domain" {

    package "repository" {

        interface ILibraryRepo <<Interface>> {
        }

    }

    package "valueobject" {

        class LibraryId <<Value Object>> #lightpink {
            +fromUserId(userId : UserId) : LibraryId
        }
        class UserId <<Value Object>>

    }

    package "library" #b0c4d4 {

        class Library <<Root>> <<Entity>> {
        }

        class LibraryFactory <<Factory>> {
            + createLibrary(userId : UserId) : Library
            + createLibrary(id : LibraryId, items : List<ItemId>) : Library
        }

    }

}

package "persistence"  {
    package "jpa" {

            class JpaLibraryRepo {
                - _iSpringDataRepo : ILibrarySpringDataRepo
                - _libraryAssembler : LibraryAssembler
            }

            interface ILibrarySpringDataRepo <<Interface>> {}

            class LibraryAssembler <<Component>> {
                + toDataModel(library : Library) : LibraryDataModel
                + toDomain(dm : LibraryDataModel) : Library
            }

            class LibraryDataModel <<Entity>> {
                - libraryId : String
                - itemIds : List<String>
            }
        }

    package "mem" {

        class MemLibraryRepo {
        }

    }

}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(T) : T
'    findAll() : Iterable<T>
'    ofIdentity(ID) : Optional <T>
    containsOfIdentity(ID) : boolean
    }
    interface DomainEntity<ID> <<Interface>>{
    +identity() : ID
    +sameAs(Object) : boolean
    }
    interface AggregateRoot<ID> <<Interface>>{}

}

CreateLibraryUI "1" .> "1" CreateLibraryController : invokes

CreateLibraryController "1" ..> "1" ILibraryRepo : calls
CreateLibraryController "1" ..> "*" Library : <<use>>
CreateLibraryController "1" ..> "*" UserId : <<use>>
CreateLibraryController "1" -> "1" LibraryFactory : <<use>>

MemLibraryRepo ..|> ILibraryRepo

MemLibraryRepo "1" -> "*" Library: persists

LibraryFactory "1" ..> "*" Library : <<create>>

Library "1" -> "1" LibraryId: has
Library ..|> AggregateRoot
LibraryId "1" .> "1" UserId: <<use>>

ILibraryRepo --|> IRepository
AggregateRoot --|> DomainEntity

JpaLibraryRepo ..|> ILibraryRepo
JpaLibraryRepo --> ILibrarySpringDataRepo : uses
JpaLibraryRepo --> LibraryAssembler : uses
LibraryAssembler ..> LibraryFactory : uses
LibraryAssembler ..> LibraryDataModel : <<use>>


@enduml