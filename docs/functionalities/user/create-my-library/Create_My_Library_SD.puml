@startuml
title "As a user, I want to create my library" - Level 2 SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber

' --- Actor and participants ---
actor User
participant ":CreateLibraryUI" as UI
participant ":CreateLibraryController" as CTL
participant ":LibraryFactory" as LF
participant ":ILibraryRepo" as IREPO

User -> UI: I want to create my library
activate UI

UI -> CTL: createLibrary(userId)
activate CTL

CTL -> LF: createLibrary(userId)
activate LF
create "myLibrary:Library"
LF -->> "myLibrary:Library": <<create>>
LF --> CTL: myLibrary
deactivate LF

' Use Ref to handle existence check via JPA
ref over CTL, IREPO
[[Verify_Library_Existence.puml Verify if a library for this user already exists]]
end ref

opt !exists
    CTL -> IREPO: save(myLibrary)
    activate IREPO

    ' Use Ref to handle the Assembler/JPA logic
    ref over IREPO
    [[Save_Library.puml Convert to Data Model, persist, and return domain object]]
    end ref

    IREPO --> CTL: reconstructedLibrary
    deactivate IREPO
end

CTL --> UI: true
deactivate CTL

UI --> User: done!
deactivate UI

@enduml