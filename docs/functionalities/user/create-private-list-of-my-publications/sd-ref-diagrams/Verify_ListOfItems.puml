@startuml
title Verify the existence of newList in persistence
hide footbox

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

participant ":CreateListOfItemsController" as Ctl
participant ":IListOfItemsRepo" as IRepo
participant ":IListOfItemsSpringDataRepo" as jpa

activate Ctl
Ctl -> "newList:ListOfItems" : identity()
activate "newList:ListOfItems"
"newList:ListOfItems" --> Ctl : listOfItemsId
deactivate "newList:ListOfItems"

Ctl -> IRepo : containsOfIdentity(listOfItemsId)
activate IRepo

IRepo -> jpa : existsById(listOfItemsId.toString())
activate jpa
database "DB" as DB
jpa -> DB : select
activate DB
DB --> jpa : false
deactivate DB
jpa --> IRepo : false
deactivate jpa

IRepo --> Ctl : false
deactivate IRepo

ref over Ctl
[[../To_Create_A_Private_List_Of_My_Publications_SD.puml Back to Main Diagram]]
end ref

@enduml