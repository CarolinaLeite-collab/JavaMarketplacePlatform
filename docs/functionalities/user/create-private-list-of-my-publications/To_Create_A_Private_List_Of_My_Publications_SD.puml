@startuml
hide footbox
title "As a User, I want to create a private list of my publications, give it a name and set a genre" - SD

'==== basic style ===='
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off

'==== Actor and Participants ===='
actor "User"

participant ":CreatePrivateListOfItemsUI" as UI
participant ":CreatePrivateListOfItemsController" as CTL
participant ":IListOfItemsRepo" as IRepo
participant ":ListOfItemsFactory" as Factory
participant ":IGenreRepo" as IGenreRepo

'==== UI interaction ===='
"User" -> UI: I want to create a private list
activate UI

"User" <-- UI: What is the list's name?
deactivate UI
"User" -> UI: name
activate UI

UI -> CTL: getListOfOfficialGenres()
activate CTL
CTL -> IGenreRepo: getListOfOfficialGenres()
activate IGenreRepo
CTL <-- IGenreRepo: copyListOfOfficialGenres
deactivate IGenreRepo
UI <-- CTL: copyListOfOfficialGenres
deactivate CTL

"User" <-- UI: What genre?
deactivate UI
"User" -> UI: genreId
activate UI

'==== Use case execution ===='
UI -> CTL: createListOfItems\n(userId, name, genreId)
activate CTL
CTL -> Factory: createListOfItems\n(userId, name, genreId)
activate Factory
create "listOfItems:ListOfItems" as listOfItems
Factory -->> listOfItems: <<create>>
Factory --> CTL : newList
deactivate Factory

' Orchestration of duplicate check and persistence
CTL -> IRepo : isRepeated = containsOfIdentity(newList.identity())
activate IRepo

opt !isRepeated
    CTL -> IRepo: save(newList)
    IRepo --> CTL: newList
    deactivate IRepo
end


UI <-- CTL: true
deactivate CTL
"User" <-- UI: Private list successfully created!
deactivate UI

@enduml