@startuml
title To add an item to my library - Level 2 SD
hide footbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber

' ==== participants ====
actor User
participant ":AddPublicationUI" as UI
participant ":AddPublicationOnLibraryCtl" as CTL
participant ":IItemRepo" as ITEMREPO
participant ":ILibraryRepo" as LIBREPO
participant "myLibrary:Library" as LIB

User -> UI : I want to add an Item to my library
activate UI
UI -> CTL : getListOfAvailableItemsIds()
activate CTL

' Reference to Item Discovery
ref over CTL, ITEMREPO : [[Get_Available_Items.puml Get list of items not yet in any library]]

CTL --> UI : availableItemIds
deactivate CTL

UI --> User : Select what item you want to add
deactivate UI
User -> UI : selectedItemId
activate UI

UI -> CTL : addItemIdToLibrary(selectedItemId, userId)
activate CTL

' Retrieval Phase
create "libraryId:LibraryId"
CTL -->> "libraryId:LibraryId" : LibraryId.fromUserId(userId)

CTL -> LIBREPO : ofIdentity(libraryId)
activate LIBREPO
ref over LIBREPO : [[Retrieve_Library.puml Retrieve Library from Persistence via JPA]]
LIBREPO --> CTL : myLibrary
deactivate LIBREPO

' Domain Logic
CTL -> LIB : addItemIdToLibrary(selectedItemId)
activate LIB
LIB --> CTL : true
deactivate LIB

' Persistence Phase
CTL -> LIBREPO : save(myLibrary)
activate LIBREPO
ref over LIBREPO : [[Save_Library.puml Save Library via Assembler and Spring Data]]
LIBREPO --> CTL : reconstructedLibrary
deactivate LIBREPO

CTL --> UI : true
deactivate CTL
UI --> User : Done!
deactivate UI
@enduml