@startuml
'https://plantuml.com/class-diagram
title "As a user, I want to add a publication to my library" CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class AddPublicationOnLibraryUI

class AddPublicationOnLibraryController {
    + getListOfAvailableItems(user : User) : List<Item>
    + addItemToLibrary(selectedItem : Item, user : User) : boolean
}

interface IItemRepo {
    + getDifferentOf(existentItems : List<Item>) : List<Item>
}

class Library {
    - _items : List<Item>
    + getAllItems() : List<Item>
    + addItemToLibrary(selectedItem : Item) : boolean
    - copyList() : List<Item>
    - verifyUnique(selectedItem : Item) : boolean
}

interface ILibraryRepo {
     + getMyLibrary(user : User) : Library
}

class Item {}

class MemLibraryRepo {
}

class MemItemRepo {
}


AddPublicationOnLibraryUI "1" ..> "1" AddPublicationOnLibraryController : request
AddPublicationOnLibraryController "1" ..> "1" IItemRepo : queries
AddPublicationOnLibraryController "1" ..> "1" Library : addItemTo
AddPublicationOnLibraryController "1" ..> "1" ILibraryRepo : queries
Library "1" --> "*" Item : stores
IItemRepo <|.. MemItemRepo
ILibraryRepo <|.. MemLibraryRepo
@enduml