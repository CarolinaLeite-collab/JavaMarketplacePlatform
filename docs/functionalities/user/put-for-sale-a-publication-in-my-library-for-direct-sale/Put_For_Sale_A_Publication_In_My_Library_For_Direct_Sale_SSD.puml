@startuml
title "As a User, I want to put for sale a publication %n() in my library in a direct sale" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant ":MiteLovers" as System

' --- System dialog ---
User -> System: I want to put an item in %n()my library on direct sale.
activate "System"
System --> User: Which item?
deactivate "System"
User -> System: item
activate "System"
System --> User: What is the price and %n()time limit for this sale?
deactivate "System"
User -> System: price, timeLimit
activate "System"
System --> User: Your item was successfully %n()put up in a direct sale!
deactivate "System"

@enduml
