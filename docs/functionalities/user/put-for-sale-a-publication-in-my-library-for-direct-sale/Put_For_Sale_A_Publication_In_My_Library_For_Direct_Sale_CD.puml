@startuml
title "As a User, I want to put for sale a publication %n() in my library in a direct sale" CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

class PublicationInLibraryForDirectSaleUI {
}

package "controller"{
class PublicationInLibraryForDirectSaleController {
  + getItemsIdInLibraryByUserId(userId: UserId): List<ItemId>
  + putItemIdOnDirectSale(itemIds: List<ItemId>, price: Price, timeLimit: Duration): DirectSale
}
}

package "ddd"{
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface AggregateRoot <ID >{
     }
    interface DomainEntity<ID, T> <<Interface>> {
           +identity() : ID
    }
}

package "domain"{
    package "repository"{
        interface ILibraryRepo {
        }
        interface IDirectSaleRepo{
        }
        interface IItemRepo{
        }
    }
    package "library" #b0c4d4 {
        class Library {
          + getItemsIdInLibrary(): List<ItemId>
        }
    }

    package "directsale" #b0c4d4 {
        class DirectSaleFactory {
          + createDirectSale(itemIds: List<ItemId>, price: Price, timeLimit: Duration): DirectSale
        }

        class DirectSale {
          - price: Price
          - timeLimit: Duration
        }
    }

    package "item" #b0c4d4 {
            class Item {
              - _editionId: EditionId
              - _condition: Condition
              - _description: Description
              - _saleStatus: SaleStatus
              + getSaleStatus(): SaleStatus
              + markAsDirectSale(): void
            }
        }

   package "valueobject"{
       class LibraryId {
        -_email : Email
        +fromUserId(userId : UserId)
       }
       class ItemId {
       - _sku : SKU
       }
       class UserId {
       - _email : Email
       }
   }
}


PublicationInLibraryForDirectSaleUI "1" ..> "1" PublicationInLibraryForDirectSaleController : invokes
PublicationInLibraryForDirectSaleController "1" --> "1" ILibraryRepo : calls
PublicationInLibraryForDirectSaleController "1" --> "1" IDirectSaleRepo : calls
PublicationInLibraryForDirectSaleController "1" --> "1" IItemRepo : calls

Library "1" --> "*" ItemId : has
Library "1" ..> "1" UserId : uses
Library "1" --> "1" LibraryId : has

IDirectSaleRepo "1     " ..|> "1" IRepository
IItemRepo "1" ..|> "1" IRepository
PublicationInLibraryForDirectSaleController "1" --> "1    " DirectSaleFactory : <<use>>
DirectSaleFactory "1" ..> "*" DirectSale : <<create>>

IDirectSaleRepo "1" --> "*" DirectSale : persists
ILibraryRepo "1" --> "*" Library : manages

Item "1" --> "1" ItemId : has
ItemId "*" --> "1" DirectSale : references

AggregateRoot -|> DomainEntity
DirectSale .|> AggregateRoot
Item .|> AggregateRoot
@enduml