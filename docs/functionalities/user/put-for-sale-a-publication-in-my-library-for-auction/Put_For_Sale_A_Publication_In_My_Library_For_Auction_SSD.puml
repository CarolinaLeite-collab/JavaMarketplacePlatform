@startuml
title "As a User, I want to put for sale a %n()publication in my library in an auction" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant ":MiteLovers" as System

' --- System dialog ---
User -> System: I want to put an item in my %n()library for sale in an auction
activate "System"
System --> User: Which item?
deactivate "System"
User -> System: itemId
activate "System"
System --> User: Please provide the start price, %n()reserve price, outright price, start %n()date, and end date
deactivate "System"
User -> System: startPrice, reservePrice, outrightPrice, %n()startDate, endDate
activate "System"
System --> User: Your item was successfully %n()put up on an auction!
deactivate "System"

@enduml