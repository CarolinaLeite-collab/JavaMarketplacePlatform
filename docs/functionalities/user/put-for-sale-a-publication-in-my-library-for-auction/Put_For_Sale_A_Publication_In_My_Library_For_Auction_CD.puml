@startuml
'https://plantuml.com/class-diagram
title "As a User, I want to put for sale a publication in my library in an auction" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'=== Classes ===
class PublicationSaleAuctionUI {
}

package "controller" {
    class PublicationSaleAuctionController {
      - _iLibraryRepo: ILibraryRepo
      - _iAuctionRepo: IAuctionRepo
      - _auctionFactory: AuctionFactory
      - _iItemRepo: IItemRepo
      + getLibraryItemsIdList(userId: UserId): List<ItemId>
      + putItemIdOnAuction(itemId: ItemId, startPrice: Price, reservePrice: Price,
        outrightPrice: Price, startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
      + putItemIdOnAuction(itemId: ItemId, startPrice: Price, reservePrice: Price,
              startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
      - addAuction(itemsId: List<ItemId>, startingPrice: Price, reservePrice: Price,
              outrightPrice: Price, auctionStartDate: ZonedDateTime, auctionEndDate: ZonedDateTime): Auction
    }
}

package "domain" {
    package "repository" {
        interface ILibraryRepo
        interface IAuctionRepo
        interface IItemRepo
    }

    package "library" {
        class Library {
          + getItemsIdInLibrary(): List<ItemId>
        }
    }

    package "auction" {
        class Auction <<Root>> <<Entity>> #b0c4d4 {
          - _auctionId: AuctionId
          - _itemsId: List<ItemId>
          - _startingPrice: Price
          - _reservePrice: Price
          - _outrightPrice: Price
          - _auctionStartDate: ZonedDateTime
          - _auctionEndDate: ZonedDateTime
        }

        class AuctionFactory <<Factory>> {
          + createAuction(itemId: ItemId, startingPrice: Price, reservePrice: Price,
                outrightPrice: Price, startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
          + createAuction(itemId: ItemId, startingPrice: Price, reservePrice: Price,
                startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
        }
    }

    package "valueobject" {
        class ItemId <<Value Object>> {
          - _itemId : ItemId
        }
    }
}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(T) : T
'    findAll() : Iterable<T>
'    ofIdentity(ID) : Optional <T>
'    containsOfIdentity(ID) : boolean
    }
    interface DomainEntity<ID> <<Interface>>{
    +identity() : ID
    +sameAs(Object) : boolean
    }
    interface AggregateRoot<ID> <<Interface>>{}

}

package "persistence" {
    class MemLibraryRepo

    class MemAuctionRepo
}


'=== Relationships ===
PublicationSaleAuctionUI "1" ..> "1" PublicationSaleAuctionController : invokes

PublicationSaleAuctionController "1" ..> "1" ILibraryRepo : <<use>>
PublicationSaleAuctionController "1" ..> "1" IAuctionRepo : <<use>>
PublicationSaleAuctionController "1" ..> "1" IItemRepo : <<use>>
PublicationSaleAuctionController "1" -> "1" AuctionFactory : <<use>>

ILibraryRepo "1" <|... "1" MemLibraryRepo : implements
IAuctionRepo "1" <|... "1" MemAuctionRepo : implements

MemLibraryRepo "1" ---> "*" Library : persists
MemAuctionRepo "1" ---> "*" Auction : persists
Library "1" --> "*" ItemId : stores

ItemId "1" --> "0..1" Auction : references

AuctionFactory "1" ..> "*" Auction : <<create>>
Auction ..|> AggregateRoot
IAuctionRepo --|> IRepository
AggregateRoot -|> DomainEntity

@enduml