@startuml
'https://plantuml.com/class-diagram
title "As a User, I want to put for sale a publication in my library in an auction" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'=== Classes ===
class PublicationSaleAuctionUI {
}

package "controller" {
    class PublicationInLibraryForAuctionController {
      + getLibraryItemsIdList(userId: UserId): List<ItemId>
      + putItemOnAuction(itemId: ItemId, startPrice: Price, reservePrice: Price,
        outrightPrice: Price, startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
      - addAuction(itemsId: List<ItemId>, startingPrice: Price, reservePrice: Price,
              outrightPrice: Price, auctionStartDate: ZonedDateTime, auctionEndDate: ZonedDateTime): Auction
    }
}

package "domain" {
    package "repository" {
        interface ILibraryRepo
        interface IAuctionRepo
        interface IItemRepo
    }

    package "library" #b0c4d4{
        class Library {
          + getItemsIdInLibrary(): List<ItemId>
        }
    }

    package "auction" #b0c4d4{
        class Auction <<Root>> <<Entity>>  {
          - _auctionId: AuctionId
          - _itemsId: List<ItemId>
          - _startingPrice: Price
          - _reservePrice: Price
          - _outrightPrice: Price
          - _auctionStartDate: ZonedDateTime
          - _auctionEndDate: ZonedDateTime
        }

        class AuctionFactory <<Factory>> {
          + createAuction(itemId: ItemId, startingPrice: Price, reservePrice: Price,
                outrightPrice: Price, startDate: ZonedDateTime, endDate: ZonedDateTime): Auction
        }

    }

        package "item" #b0c4d4 {
            class Item {
              + getSaleStatus(): SaleStatus
              + markAsAuction(): void
            }
        }

    package "valueobject" {
        class ItemId <<Value Object>> {
          - _itemId : ItemId
        }
        class LibraryId {
            -_email : Email
            +fromUserId(userId : UserId)
       }
    }
}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
        }
        interface AggregateRoot <ID >{
         }
        interface DomainEntity<ID, T> <<Interface>> {
         +identity() : ID
        }

}


'=== Relationships ===
PublicationSaleAuctionUI "1" ..> "1" PublicationInLibraryForAuctionController : invokes

PublicationInLibraryForAuctionController "1" --> "1" ILibraryRepo : calls
PublicationInLibraryForAuctionController "1" --> "1" IAuctionRepo : calls
PublicationInLibraryForAuctionController "1" --> "1" IItemRepo : calls
PublicationInLibraryForAuctionController "1" -> "1" AuctionFactory : calls

Library "1" --> "*" ItemId : stores
Library "1" --> "1" LibraryId : has
Item "1" --> "1" ItemId : has

ItemId "1" <-- "0..1" Auction : references

AuctionFactory "1" ..> "*" Auction : <<create>>
Auction ..|> AggregateRoot
Item .|> AggregateRoot
Library .|> AggregateRoot
IAuctionRepo ..|> IRepository
ILibraryRepo ..|> IRepository
IItemRepo ..|> IRepository
AggregateRoot -|> DomainEntity

@enduml