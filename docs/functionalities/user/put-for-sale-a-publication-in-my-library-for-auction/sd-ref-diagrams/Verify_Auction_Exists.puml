@startuml
'==== Title ====
title "Verify auctionId is not already persisted (in JPA)" Reference SD
'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
participant ":IAuctionRepo" as AuctionRepo
participant ":JpaAuctionRepo" as JpaAuctionRepo
participant ":IAuction%n()SpringDataRepo" as SpringDataAuctionRepo
database "DB" as DB



AuctionRepo -> JpaAuctionRepo : containsOfIdentity%n()(auctionId)
activate AuctionRepo
activate JpaAuctionRepo

JpaAuctionRepo -> SpringDataAuctionRepo : existsById(auctionId.%n()toString())
activate SpringDataAuctionRepo
SpringDataAuctionRepo -> DB : select
activate DB
DB --> SpringDataAuctionRepo : false
deactivate DB

SpringDataAuctionRepo --> JpaAuctionRepo : false
deactivate SpringDataAuctionRepo

JpaAuctionRepo --> AuctionRepo : false
deactivate JpaAuctionRepo

deactivate AuctionRepo

ref over AuctionRepo
[[../Put_For_Sale_A_Publication_In_My_Library_For_Auction_SD.puml Return to main diagram]]
end ref
@enduml