@startuml
title "As a Buyer, I want to get the list of items on auction of a given publisher" - SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenPublishingCompanyController" as CTL
participant ":IAuctionRepo" as REPO

activate CTL
CTL -> REPO : findAll()
activate REPO
REPO --> CTL : auctions
deactivate REPO

ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Publishing_Company_SD.puml Back to Main Diagram]]
end ref
@enduml