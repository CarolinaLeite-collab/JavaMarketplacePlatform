@startuml
title "Get Auctions" - SD

skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenPublishingCompanyController" as CTL
participant ":JpaAuctionRepo" as JPAREPO
participant ":IAuctionSpringdataRepo" as SPRINGREPO
participant "auctionAssembler:AuctionAssembler" as ASM
database "DB" as DB

activate CTL
CTL -> JPAREPO : findAll()
activate JPAREPO


JPAREPO -> SPRINGREPO : findAll()
activate SPRINGREPO

SPRINGREPO -> DB : findAll()
activate DB

DB --> SPRINGREPO : savedAuctionDms
deactivate DB
SPRINGREPO --> JPAREPO : savedAuctionDms
deactivate SPRINGREPO

loop for savedAuctionDm : savedAuctionDms
  JPAREPO -> ASM : toDomain(savedAuctionDm)
  activate ASM
  ASM -> "savedAuctionDm:AuctionDataModel" : stringAuctionId = getAuctionId()
  ASM -> "auctionId:AuctionId" : <<create>>(stringAuctionId)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringItemsId = getItemsId()
  ASM -> "itemsId:List<ItemId>" : <<create>>(stringItemsId)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringStartingPrice = getStartingPrice()
  ASM -> "startingPrice:Price" : <<create>>(stringStartingPrice)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringReservePrice = getReservePrice()
  ASM -> "reservePrice:Price" : <<create>>(stringReservePrice)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringOutrightPrice = getOutrightPrice()
  ASM -> "outrightPrice:Price" : <<create>>(stringOutrightPrice)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringAuctionStartDate = getAuctionStartDate()
  ASM -> "auctionStartDate:ZoneDateTime" : <<create>>(stringAuctionStartDate)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringAuctionEndDate = getAuctionEndDate()
  ASM -> "auctionEndDate:ZoneDateTime" : <<create>>(stringAuctionEndDate)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringUserId = getUserId()
  ASM -> "userId:UserId" : <<create>>(stringUserId)

ASM -> "savedAuctionDm:AuctionDataModel" : stringSeller = getSeller()
ASM -> "seller:UserId" : <<create>>(stringSeller)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringFinalPrice = getFinalPrice()
  ASM -> "finalPrice:Price" : <<create>>(stringFinalPrice)

  ASM -> "savedAuctionDm:AuctionDataModel" : stringBids = getBids()
  ASM -> "bids:List<Bid>" : <<create>>(stringBids)

  ASM -> ":AuctionFactory" : createAuction(auctionId, itemsId, startingPrice, reservePrice, outrightPrice, auctionStartDate, auctionEndDate, userId, finalPrice, bids)

  ":AuctionFactory" -->> "reconstructedAuction:Auction" : <<create>>(auctionId, itemsId, startingPrice, reservePrice, outrightPrice, auctionStartDate, auctionEndDate, userId, finalPrice, bids)
  ":AuctionFactory" --> ASM : reconstructedAuction
  ASM --> JPAREPO : reconstructedAuction
  deactivate ASM
end


  JPAREPO --> CTL : reconstructedAuctions
  deactivate JPAREPO



ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Author_SD.puml Back to Main Diagram]]
end ref
@enduml