@startuml
title "Get Auction Id" - SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenPublishingCompanyController" as CTL
participant ":JpaPublishingCompanyRepo" as JPAREPO
participant ":IPublishingCompanySpringdataRepo" as SPRINGREPO
database "DB" as DB

activate CTL
CTL -> JPAREPO : findAll()
activate JPAREPO


JPAREPO -> SPRINGREPO : findAll()
activate SPRINGREPO

SPRINGREPO -> DB : findAll()
activate DB

DB --> SPRINGREPO : savedPublishingCompanyDms
deactivate DB
SPRINGREPO --> JPAREPO : savedPublishingCompanyDms
deactivate SPRINGREPO

loop for savedPublishingCompanyDm : savedPublishingCompanyDms
    JPAREPO -> "savedPublishingCompanyDm:PublishingCompanyDataModel" : getPublishingCompanyId()
    JPAREPO -> "publishingCompanyId:PublishingCompanyId" : <<create>>(stringPublishingCompanyId)
end

create "publishingCompanyIds:List<PublishingCompanyId>"
JPAREPO -> "publishingCompanyIds:List<PublishingCompanyId>" : <<create>>
JPAREPO -> "publishingCompanyIds:List<PublishingCompanyId>" : add(stringPublishingCompanyId)
"publishingCompanyIds:List<PublishingCompanyId>" --> JPAREPO : true

JPAREPO --> CTL : publishingCompanyIds
deactivate JPAREPO

ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Publishing_Company_SD.puml Back to Main Diagram]]
end ref
@enduml