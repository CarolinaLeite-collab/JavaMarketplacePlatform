@startuml
title "Get Auction Id" - SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenPublicationController" as CTL
participant ":JpaPublicationRepo" as JPAREPO
participant ":IPublicationSpringdataRepo" as SPRINGREPO
database "DB" as DB

activate CTL
CTL -> JPAREPO : findAll()
activate JPAREPO


JPAREPO -> SPRINGREPO : findAll()
activate SPRINGREPO

SPRINGREPO -> DB : findAll()
activate DB

DB --> SPRINGREPO : savedPublicationDms
deactivate DB
SPRINGREPO --> JPAREPO : savedPublicationrDms
deactivate SPRINGREPO

loop for savedPublicationDm : savedPublicationDms
    JPAREPO -> "savedPublicationDm:PublicationDataModel" : getPublicationId()
    JPAREPO -> "publicationId:PublicationId" : <<create>>(stringPublicationId)
end

create "publicationIds:List<PublicationId>"
JPAREPO -> "publicationIds:List<PublicationId>" : <<create>>
JPAREPO -> "publicationIds:List<PublicationId>" : add(stringPublicationId)
"publicationIds:List<PublicationId>" --> JPAREPO : true

JPAREPO --> CTL : publicationIds
deactivate JPAREPO

ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Publication_SD_2.puml Back to Main Diagram]]
end ref
@enduml