@startuml
title "As a Buyer, I want to get the list of items on auction of a given publication" - Level 2 SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenPublicationController" as CTL
participant "IPublicationRepo" as REPO

activate CTL
CTL -> REPO : findAllKeys()
activate REPO
REPO --> CTL : publicationIds
deactivate REPO

ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Publication_SD_2.puml Back to Main Diagram]]
end ref
@enduml