@startuml
title "As a Buyer, I want to get the list of items on auction of a given publication" - Level 2 SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor Buyer
participant ":GetAuctionItemsByPublicationUI" as UI
participant ":GetAuctionItemsByPublicationController" as CTL

participant "edition:Edition" as Edition


Buyer -> UI: I want the list of items %n() on auction of a given publication
activate UI
UI -> CTL : findAllKeys()
activate CTL
ref over CTL
[[sd-ref-diagrams/Get_Publications_Id.puml Get All Publications Ids]]
end ref

CTL --> UI : publicationIds
deactivate CTL
UI --> Buyer: Select publicationId
deactivate UI
Buyer -> UI: publicationId
activate UI


UI -> CTL: getAuctionItemsBy %n() PublicationId(publicationId)
activate CTL

ref over CTL
[[sd-ref-diagrams/Get_Auctions.puml Get All Auctions]]
end ref

create "listOfItemsOnAuction %n() ByPublication:List<ItemId>" as List
CTL -->> List : <<Create>>

loop for auction : auctions
ref over CTL
[[sd-ref-diagrams/Get_Item_Id.puml Get Items Id on Auction]]
end ref

loop for itemId : itemIds
ref over CTL
[[sd-ref-diagrams/Get_Item.puml Get Items]]
end ref

ref over CTL
[[sd-ref-diagrams/Get_Edition_Id.puml Get Edition Id]]
end ref

ref over CTL
[[sd-ref-diagrams/Get_Edition.puml Get Edition]]
end ref

CTL -> Edition : hasPublicationId = isByPublicationId(publicationId)

opt hasPublicationId
CTL -> List : add(itemId)
activate List
List --> CTL : true
deactivate List
end
end
end


CTL --> UI: listOfItemsOnAuctionByPublication
deactivate CTL

UI --> Buyer: Here's the list! done!
deactivate UI

@enduml