@startuml
title "As a Buyer, I want to get the list of items on auction of a given publication" - Level 2 SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor Buyer
participant ":GetAuctionItemsByPublicationUI" as UI
participant ":GetAuctionItemsByPublicationController" as CTL
participant ":IPublicationRepo" as PR
participant ":IAuctionRepo" as AUR
participant "auction:Auction" as Auction
participant ":IItemRepo" as IR
participant "item:Item" as Item
participant ":IEditionRepo" as ER
participant "edition:Edition" as Edition


Buyer -> UI: I want the list of items %n() on auction of a given publication
activate UI
UI -> CTL : findAllKeys()
activate CTL
CTL -> PR : findAllKeys()
activate PR

PR --> CTL : publicationIds
deactivate PR

CTL --> UI : publicationIds
deactivate CTL
UI --> Buyer: Select publicationId
deactivate UI
Buyer -> UI: publicationId
activate UI


UI -> CTL: getAuctionItemsBy %n() PublicationId(publicationId)
activate CTL

CTL -> AUR: findAll()
activate AUR

AUR --> CTL: auctions
deactivate AUR

create "listOfItemsOnAuction %n() ByPublication:List<ItemId>" as List
CTL -->> List : <<Create>>

loop for auction : auctions
CTL -> Auction : getItemIds()
activate Auction
Auction --> CTL : itemIds
deactivate Auction

loop for itemId : itemIds
CTL -> IR : ofIdentity(itemId)
activate IR
IR --> CTL : item
deactivate IR
CTL -> Item : getEditionId()
activate Item
Item --> CTL : editionId
deactivate Item

CTL -> ER : ofIdentity(editionId)
activate ER
ER --> CTL : edition
deactivate ER

CTL -> Edition : hasPublicationId = isByPublicationId(publicationId)

opt hasPublicationId
CTL -> List : add(itemId)
activate List
List --> CTL : true
deactivate List
end
end
end


CTL --> UI: listOfItemsOnAuctionByPublication
deactivate CTL

UI --> Buyer: Here's the list! done!
deactivate UI

@enduml