@startuml
'https://plantuml.com/class-diagram
title US025 – "As a Buyer, I want to get the list of items on direct sale of a given author" - CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class GetDirectSaleItemsByAuthorUI {

}

class GetDirectSaleItemsByAuthorController {

- _dsr : DirectSaleRepo
+ getDirectSaleItemsByAuthor(authorName: Author) : List<Item>
}

class DirectSaleRepo {

- _directSales : List<DirectSale>
+getDirectSaleItemsByAuthor(authorName: Author) : List<Item>

}

class DirectSale {
-item : Item
+isByAuthor(authorName: Author) : boolean
+getItem() : Item

}

GetDirectSaleItemsByAuthorUI "1" ..> "1" GetDirectSaleItemsByAuthorController : invokes
GetDirectSaleItemsByAuthorController "1" ..> "1" DirectSaleRepo : calls
DirectSaleRepo "1" --> "*" DirectSale : contains

@enduml