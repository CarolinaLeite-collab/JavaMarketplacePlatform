@startuml
title "Get Auction Id" - SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":GetItemsOnAuctionOfA\nGivenAuthorController" as CTL
participant ":JpaAuthorRepo" as JPAREPO
participant ":IAuthorSpringdataRepo" as SPRINGREPO
database "DB" as DB

activate CTL
CTL -> JPAREPO : findAll()
activate JPAREPO


JPAREPO -> SPRINGREPO : findAll()
activate SPRINGREPO

SPRINGREPO -> DB : findAll()
activate DB

DB --> SPRINGREPO : savedAuthorDms
deactivate DB
SPRINGREPO --> JPAREPO : savedAuthorDms
deactivate SPRINGREPO

loop for savedAuthorDm : savedAuthorDms
    JPAREPO -> "savedAuthorDm:AuthorDataModel" : getAuthorId()
    JPAREPO -> "authorId:AuthorId" : <<create>>(stringAuthorId)
end

create "authorIds:List<AuthorId>"
JPAREPO -> "authorIds:List<AuthorId>" : <<create>>
JPAREPO -> "authorIds:List<AuthorId>" : add(stringAuthorId)
"authorIds:List<AuthorId>" --> JPAREPO : true

JPAREPO --> CTL : authorIds
deactivate JPAREPO

ref over CTL
[[../Get_List_Of_Items_on_Auction_Of_Given_Author_SD.puml Back to Main Diagram]]
end ref
@enduml