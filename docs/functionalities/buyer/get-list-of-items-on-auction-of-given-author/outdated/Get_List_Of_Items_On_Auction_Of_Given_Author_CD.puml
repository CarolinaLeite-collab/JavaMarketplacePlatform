@startuml
'https://plantuml.com/class-diagram
title As a Buyer, I want to get the list of items on auction of a given author - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetItemsOnAuctionOfAGivenAuthorUI {

}

class GetItemsOnAuctionOfAGivenAuthorCtl {
- ar : AuctionRepo
+ getAuctionItemsByAuthor(authorName: Author) : List<Item>
}

class AuctionRepo {
- _itemsOnAuction : List<Auction>
+ getAuctionItemsByAuthor(authorName: Author) : List<Item>
}

class Auction {
+ isByAuthor(authorName: Author) : boolean
}

GetItemsOnAuctionOfAGivenAuthorUI "1" ..> "1" GetItemsOnAuctionOfAGivenAuthorCtl : invokes
GetItemsOnAuctionOfAGivenAuthorCtl "1" ..> "1" AuctionRepo : calls
AuctionRepo "1" --> "*" Auction : accesses

@enduml
