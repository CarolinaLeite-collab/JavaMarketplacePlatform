@startuml
title "Find all PublicationIds from persistence (via JPA)" Reference SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":IPublicationRepo" as Repo
participant ":JpaPublicationRepo" as JpaRepo
participant ":IPublicationSpringDataRepo" as PublicationSpringRepo
database "DB" as DB


Repo -> JpaRepo : findAllKeys()
activate Repo
activate JpaRepo


JpaRepo -> PublicationSpringRepo : findAll()
activate PublicationSpringRepo

PublicationSpringRepo -> DB : retrieve Publication %n()Data Models
activate DB

DB --> PublicationSpringRepo : publicationDMs
deactivate DB
PublicationSpringRepo --> JpaRepo : publicationDMs
deactivate PublicationSpringRepo

create "publicationIds%n():List<PublicationId>"
JpaRepo -> "publicationIds%n():List<PublicationId>" : <<create>>


loop for publicationDM : publicationDMs
    JpaRepo -> "publicationDM%n():PublicationDataModel" : titleString = getTitle()
    activate "publicationDM%n():PublicationDataModel"
    deactivate "publicationDM%n():PublicationDataModel"
    create "title:Title"
    JpaRepo -->> "title:Title" : createTitle(titleString)

    JpaRepo -> "publicationDM%n():PublicationDataModel" : authorIdString = getAuthorId()
    activate "publicationDM%n():PublicationDataModel"
    deactivate "publicationDM%n():PublicationDataModel"
    create "authorId:AuthorId"
    JpaRepo -->> "authorId:AuthorId" : createAuthorId(authorIdString)

    JpaRepo -> "publicationDM%n():PublicationDataModel" : releaseYearString = getReleaseYear()
    activate "publicationDM%n():PublicationDataModel"
    deactivate "publicationDM%n():PublicationDataModel"
    JpaRepo -> Year : releaseYear = parse(releaseYearString)
    activate Year
    deactivate Year

    create "publicationId%n():PublicationId"
    JpaRepo -->> "publicationId%n():PublicationId" : createPublicationId(title, authorId, releaseYear)

    JpaRepo -> "publicationIds%n():List<PublicationId>" : add(publicationId)
    activate "publicationIds%n():List<PublicationId>"
    deactivate "publicationIds%n():List<PublicationId>"

end

JpaRepo --> Repo : publicationIds
deactivate JpaRepo

ref over Repo
[[../Get_List_Of_Items_On_Direct_Sale_Of_Given_Publication_SD.puml Back to Main Diagram]]
end ref
@enduml