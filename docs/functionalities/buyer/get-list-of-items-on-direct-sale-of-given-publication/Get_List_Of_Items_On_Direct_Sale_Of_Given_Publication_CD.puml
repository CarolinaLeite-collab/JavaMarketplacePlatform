@startuml
'https://plantuml.com/class-diagram
title "As a Buyer, I want to get the list of items on direct sale of a given publication" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetDirectSaleItemsByPublicationUI{}

package "controller" {
    class GetDirectSaleItemsByPublicationController {
        +getDirectSaleItemsByPublicationId(publicationId : PublicationId) : List<ItemId>
        +findAllKeys() : List<PublicationId>
    }
}

package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +findAllKeys() : List<ID>
        +ofIdentity(id : ID) : Optional <T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface AggregateRoot<ID, T> <<Interface>>

    interface DomainEntity<ID> <<Interface>>{

    }
}

package "domain" {
    package "repository" {
        interface IPublicationRepo <<Interface>> {
        }
        interface IDirectSaleRepo <<Interface>> {
        }
        interface IItemRepo <<Interface>> {
        }
        interface IEditionRepo <<Interface>> {
        }
    }

    package "valueobject" {
        class ItemId <<Value Object>>
        class EditionId <<Value Object>>
        class PublicationId <<Value Object>>
    }

    package "directsale" #b0c4d4 {
        class DirectSale <<Root>> <<Entity>> {
            +getItemsId() : List<ItemId>
        }
    }

    package "item" #b0c4d4 {
        class Item <<Root>> <<Entity>> {
            +getEditionId() : EditionId
        }
    }

    package "edition" #b0c4d4 {
        class Edition <<Root>> <<Entity>> {
            +isByPublicationId(publicationId : PublicationId) : boolean
        }
    }
}

GetDirectSaleItemsByPublicationUI "1".>"1" GetDirectSaleItemsByPublicationController : invokes

GetDirectSaleItemsByPublicationController "1" ..> "1" IDirectSaleRepo : <<use>>
GetDirectSaleItemsByPublicationController "1" ..> "1" IItemRepo : <<use>>
GetDirectSaleItemsByPublicationController "1" ..> "1" IEditionRepo : <<use>>
GetDirectSaleItemsByPublicationController "1" ..> "1" IPublicationRepo : <<use>>

IDirectSaleRepo ...|> IRepository
IItemRepo ...|> IRepository
IEditionRepo ...|> IRepository
IPublicationRepo ...|> IRepository

IDirectSaleRepo "1" --> "*" DirectSale : manages
IItemRepo "1" --> "*" Item : manages
IEditionRepo "1" --> "*" Edition : manages

DirectSale "1" o-- "1..*" ItemId : aggregates
Item "1" --> "1" EditionId : has
Item "1" --> "1" ItemId : has
Edition "1" --> "1" PublicationId : has
Edition "1" --> "1" EditionId : has

AggregateRoot --|> DomainEntity
DirectSale .|> AggregateRoot
Item .|> AggregateRoot
Edition .|> AggregateRoot

@enduml