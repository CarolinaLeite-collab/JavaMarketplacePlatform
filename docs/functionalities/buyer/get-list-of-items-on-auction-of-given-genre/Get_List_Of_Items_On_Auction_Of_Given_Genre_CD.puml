@startuml
'https://plantuml.com/class-diagram

title "Get items on auction of a given genre, sorted ascendingly by deadline" CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class GetAuctionItemsByGenreUI{}

package "controller" {
    class GetAuctionItemsByGenreController {
        +getAuctionItemsByGenreId(genreId: GenreId): List<ItemId>
        +findAllKeys() : List<GenreId>
    }
}

package "ddd" {
    interface IRepository<ID, T> <<Interface>>
}

package "domain" {
    package "repository" {
        interface IGenreRepo <<Interface>>
        interface IAuctionRepo <<Interface>> {
             +findByItemsIdSorted(itemIds : List<ItemId>) : List<ItemId>
        }
        interface IItemRepo <<Interface>> {
             +findAllKeys() : List<ItemId>
             +ofIdentity(id : ItemId) : Optional<Item>
        }
        interface IEditionRepo <<Interface>> {
            +ofIdentity(id : EditionId) : Optional<Edition>
        }
        interface IPublicationRepo <<Interface>> {
            +ofIdentity(id : PublicationId) : Optional<Publication>
        }
    }

    package "valueobject" {
        class GenreId <<Value Object>>
        class ItemId <<Value Object>>
        class EditionId <<Value Object>>
        class PublicationId <<Value Object>>
    }

    package "auction" #b0c4d4 {
        class Auction <<Root>> <<Entity>> {
            -auctionEndDate: ZonedDateTime
            +getItemsId() : List<ItemId>
            +getAuctionEndDate() : Instant
        }
    }

    package "item" {
        class Item <<Root>> <<Entity>> {
            +getEditionId() : EditionId
        }
    }

    package "edition" {
        class Edition <<Root>> <<Entity>> {
            +getPublicationId() : PublicationId
        }
    }

    package "publication" {
        class Publication <<Root>> <<Entity>> {
            +isByGenreId(genreId : GenreId) : boolean
        }
    }
}

GetAuctionItemsByGenreUI "1".>"1" GetAuctionItemsByGenreController : invokes

'--- Controller Dependencies ---
GetAuctionItemsByGenreController "1" ..> "1" IAuctionRepo : <<use>>
GetAuctionItemsByGenreController "1" ..> "1" IItemRepo : <<use>>
GetAuctionItemsByGenreController "1" ..> "1" IEditionRepo : <<use>>
GetAuctionItemsByGenreController "1" ..> "1" IPublicationRepo : <<use>>
GetAuctionItemsByGenreController "1" ..> "1" IGenreRepo : <<use>>

'--- Repository Hierarchy ---
IAuctionRepo ---|> IRepository
IItemRepo ---|> IRepository
IEditionRepo ---|> IRepository
IPublicationRepo ---|> IRepository
IGenreRepo ---|> IRepository

'--- Management Relationships ---
IAuctionRepo "1" --> "*" Auction : manages
IItemRepo "1" --> "*" Item : manages
IEditionRepo "1" --> "*" Edition : manages
IPublicationRepo "1" --> "*" Publication : manages

'--- Domain Logic Links ---
Auction "1" o-- "1..*" ItemId : references
Item "1" --> "1" ItemId : has
Edition "1" --> "1" PublicationId : references
Edition "1" --> "1" EditionId : has
Publication "1" --> "1" GenreId : references
Publication "1" --> "1" PublicationId : has

note bottom of IAuctionRepo
  findByItemsIdSorted returns ItemIds
  ordered by Auction::auctionEndDate
end note

@enduml