@startuml
title "As an Administrator, I want to register a new city in the system" SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":RegisterCityController" as CTL
participant ":ICountryRepo" as REPO

activate CTL
CTL -> REPO : findAllKeys()
activate REPO
REPO --> CTL : countryIds
deactivate REPO

ref over CTL
[[../Register_City_SD.puml Back to Main Diagram]]
end ref
@enduml