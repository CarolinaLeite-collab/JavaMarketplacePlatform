@startuml
'==== Title ====
title "As an Administrator, I want to register a new city in the system" SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
participant ":RegisterCityController" as CTL
participant "city:City" as CITY
participant ":ICityRepo" as IREPO
participant ":ICitySpringDataRepo" as SDREPO
database "DB" as DB

activate CTL
CTL -> CITY : identity()
activate CITY
CITY --> CTL : cityId
deactivate CITY
CTL -> IREPO: containsOfIdentity(cityId)
activate IREPO
IREPO -> SDREPO : containsOfIdentity(cityId.toString())
activate SDREPO
SDREPO -> DB : select
activate DB
DB --> SDREPO : false
deactivate DB
SDREPO --> IREPO : false
deactivate SDREPO
IREPO --> CTL : false
deactivate IREPO

ref over CTL
[[../Register_City_SD.puml Back to Main Diagram]]
end ref
@enduml