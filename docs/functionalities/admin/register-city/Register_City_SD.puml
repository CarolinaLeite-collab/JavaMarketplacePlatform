@startuml
title "As an Administrator, I want to register a new city in the system" SD

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

' ==== Actor and participants ====
actor Administrator as Admin
participant ":RegisterCityUI" as UI
participant ":RegisterCityController" as CTL
participant ":ICityRepo" as IREPO
participant ":CityFactory" as FCT

'==== UI interaction ====
Admin -> UI: I want to register a new City.
activate UI


'==== Get Countries Id's ====
UI -> CTL: getAllCountries()
activate CTL
ref over CTL
[[sd-ref-diagrams/Get_Country_Ids.puml Get All Country Ids]]
end ref
UI <-- CTL: countryIds
deactivate CTL


'==== Create City ====
UI --> Admin: Please choose a country \n and provide the city name.
deactivate UI
Admin -> UI: countryId, cityName
activate UI
UI -> CTL: registerCity(cityName, countryId)
activate CTL
CTL -> FCT : creacteCity(cityName, countryId)
activate FCT
create city
FCT -> city : creacteCity(cityName, countryId)
FCT --> CTL : city
deactivate FCT
ref over CTL
[[sd-ref-diagrams/Verify_City.puml Verify the existence of city in persistence]]
end ref

'==== Save City ====
CTL -> IREPO : save(city)
activate IREPO
ref over IREPO
[[sd-ref-diagrams/Save_City.puml Save City and return saved domain object]]
end ref
IREPO --> CTL : reconstructedCity
deactivate IREPO
CTL --> UI : reconstructedCity
deactivate CTL
UI --> Admin : done
deactivate UI
@enduml
