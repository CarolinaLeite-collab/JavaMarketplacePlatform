@startuml

'==== Title ====
title "As an Administrator, I want to register a new city in the system" CD
top to bottom direction


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
class RegisterCityUI {
}

package "controller" {

    class RegisterCityController {

        + registerCity(cityName : String, countryId : CountryId

    }

}

package "domain" {
    package "repository" {

        interface ICityRepo <<Interface>> {

        }

        interface ICountryRepo <<Interface>> {

        }

    }

    package "City"" #b0c4d4 {

        class City <<Root>> <<Entity>>{
            +identity() : CityId
            +sameAs(Object) : boolean
            +getName() : Name
            +getCountryId() : List<CountryId>
        }

        class CityFactory <<Factory>> {
        + createCity(cityName : String, countryId : CountryId) : City
        + createCity(id : CityId, cityName : String, countryId : CountryId) : City

        }

    }

    Package "valueobject"  {

        '== Value Objects (Ids) ==
        class CityId <<ValueObject>> #LightPink {
        -_id : String

        }

        class CountryId <<ValueObject>> {

        }

    }

}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(T) : T
    findAll() : Iterable<T>
    findAllKeys() : List<ID>
    ofIdentity(ID) : Optional <T>
    containsOfIdentity(ID) : boolean
    }

    interface AggregateRoot {

    }

}


'==== Interactions ====
RegisterCityUI "1" ..> "1" RegisterCityController : invokes

RegisterCityController "1" ..> "1" ICountryRepo : calls
RegisterCityController "1" ..> "1" ICityRepo : calls
RegisterCityController "1" ....> "*" City : <<use>>
RegisterCityController "1" --> "1" CityFactory : invokes

CityFactory "1" ..> "*" City : <<create>>

City "1" --> "ID 1" CityId : has
City "1..*" o-- "1" CountryId : references
City "*" <- "1" ICityRepo : persists
City ..|> AggregateRoot

ICityRepo -|> IRepository
ICountryRepo -|> IRepository

@enduml