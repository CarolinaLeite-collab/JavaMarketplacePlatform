@startuml
title As an Administrator, I want to register a new country in the system - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' Control the layout flow
top to bottom direction

class RegisterCountryUI {
}

package "controller" {
    class RegisterCountryController {
      + registerCountry(countryName : String) : Country
    }
}

package "domain" {

    package "country" #b0c4d4 {
        class Country <<Root>> <<Entity>> {
          + identity() : CountryId
          + name() : CountryName
          + sameAs(object : Object) : boolean
          + getCountryName() : String
        }

        class CountryFactory <<Factory>> {
          + createCountry(countryName : String) : Country
        }
    }

    package "valueobject" {
        class CountryId <<Value Object>> #lightpink {
            - _code : String
        }
        class CountryName <<Value Object>> {
            - _value : String
        }
    }

    package "repository" {
        interface ICountryRepo <<Interface>> {
        }
    }
}

package "persistence" {
    package "mem" {
        class MemoCountryRepo <<Repo>> {
        }
    }
}

package "ddd" {
    interface "IRepository<ID, T>" as IRepository <<Interface>> {
        + save(T) : T
        + findAll() : Iterable<T>
        + ofIdentity(ID) : Optional<T>
        + containsOfIdentity(ID) : boolean
        + findAllKeys() : List<ID>
    }
}

'==== Visual Layout Alignment ====
RegisterCountryUI -[hidden]down- controller
controller -[hidden]down- domain
country -[hidden]right- valueobject
valueobject -[hidden]right- repository
domain -[hidden]down- persistence

'==== Connections ====
RegisterCountryUI "1" .> "1" RegisterCountryController : invokes

RegisterCountryController "1" --> "1" ICountryRepo : uses
RegisterCountryController "1" --> "1" CountryFactory : uses
RegisterCountryController "1" ..> "*" Country : <<manages>>

MemoCountryRepo ..|> ICountryRepo
MemoCountryRepo "1" --> "*" Country : persists

CountryFactory "1" ..> "*" Country : <<create>>

Country "1" --> "1" CountryId : has
Country "1" *-- "1" CountryName : has

ICountryRepo --|> IRepository

@enduml