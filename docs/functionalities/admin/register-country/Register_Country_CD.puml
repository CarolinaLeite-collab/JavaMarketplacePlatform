@startuml
title As an Administrator, I want to register a new country in the system - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' Control the layout flow
top to bottom direction

class RegisterCountryUI {
}

package "controller" {
    class RegisterCountryController {
      + registerCountry(countryName : String) : Country
    }
}

package "domain" {

    package "country" #b0c4d4 {
        class Country <<Root>> <<Entity>> {

          + name() : CountryName

        }

        class CountryFactory <<Factory>> {
          +createCountry(String countryName) : Country

        }
    }

    package "valueobject" {
        class CountryId <<Value Object>> #lightpink {
            -_id : Name
        }
        class CountryName <<Value Object>> {
        }
    }

    package "repository" {
        interface ICountryRepo <<Interface>> {
        }
    }
}

Package "ddd" {
    interface "IRepository<ID, T>" as IRepository <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }

    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}

'==== Visual Layout Alignment ====
RegisterCountryUI -[hidden]down- controller
controller -[hidden]down- domain
country -[hidden]right- valueobject
valueobject -[hidden]right- repository

'==== Connections ====
RegisterCountryUI "1" .> "1" RegisterCountryController : invokes

RegisterCountryController "1" ..> "1" ICountryRepo : <<use>>
RegisterCountryController "1" --> "1" CountryFactory : invokes
RegisterCountryController "1" ..> "*" Country : <<use>>

CountryFactory "1" ..> "*" Country : <<create>>

Country "1" --> "1" CountryId : has
Country "1" *-- "1" CountryName : has

ICountryRepo --|> IRepository
ICountryRepo "1" -> "*" Country : persists

Country "1" .|> "1" AggregateRoot
AggregateRoot --|> DomainEntity

@enduml