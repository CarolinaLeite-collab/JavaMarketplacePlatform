@startuml
'==== Title ====
title "As an Administrator, I want to register a new country in the system" - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ActivationBackgroundColor WhiteSmoke
hide footbox

autonumber

' ==== Actor and participants ====
actor Administrator as ADM
participant ":RegisterCountryUI" as UI
participant ":RegisterCountryController" as CTL
participant ":CountryFactory" as FACTORY
participant ":ICountryRepo" as CR

'==== UI interaction ====
ADM -> UI: I want to register a country
activate UI
UI --> ADM: What is the country's name?
deactivate UI

ADM -> UI: countryName
activate UI

'==== Use case execution ====
UI -> CTL: registerCountry(countryName)
activate CTL

CTL -> FACTORY : createCountry(countryName)
activate FACTORY
create "c1:Country" as C
FACTORY -->> C: <<Create>>
FACTORY --> CTL : c1
deactivate FACTORY

' Logic consolidated into one activation flow
CTL -> CR : isRepeated = containsOfIdentity(c1.identity())
activate CR

opt !isRepeated
    CTL -> CR: save(c1)
    CR --> CTL: c1
    deactivate CR
end

CTL --> UI: c1
deactivate CTL

UI --> ADM : Country registered successfully!
deactivate UI

@enduml