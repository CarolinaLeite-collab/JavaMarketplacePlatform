@startuml
title "As an Administrator, I want to register a Publishing Company in the system" SD
hide footbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor "Admin" as Administrator
participant ":RegisterPublishing%n()CompanyUI" as UI
participant ":RegisterPublishing%n()CompanyCtl" as Ctl
participant ":PublishingCompany%n()Factory" as Factory
participant ":MemPublishing%n()CompanyRepo" as Repo

' --- SD (Happy Path only)---

Administrator -> "UI": I want to register %n()a publishing company.
activate "UI"
"UI" --> Administrator:Name of the %n()publishing company?
Administrator -> "UI": publishingCompanyName
"UI" -> "Ctl": registerPublishingCompany%n()(publishingCompanyName)
activate "Ctl"
"Ctl" -> "Factory" : createPublishingCompany%n()(publishingCompanyName)
activate "Factory"
create "newPublishingCompany:%n()PublishingCompany"
"Factory" -->> "newPublishingCompany:%n()PublishingCompany": <<create>>
"Factory" --> "Ctl": newPublishingCompany
deactivate "Factory"
note right of Ctl
    assuming happy path:
    containsOfIdentity(newPublishingCompany.identity()) == false
end note
"Ctl" -> "Repo": save(newPublishingCompany);
deactivate "Repo"
"Ctl" --> "UI": newPublishingCompany
deactivate "Ctl"
"UI" --> Administrator: Registered successfully!
deactivate "UI"

@enduml