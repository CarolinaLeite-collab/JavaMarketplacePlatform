@startuml
title "As an administrator, I want to add a publication type to the official type list, %n() so that new publications can be of this type" CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class AddPublicationTypeUI

package "controller" {
    class AddPublicationTypeController {
      + addPublicationType(publicationTypeName : String) : PublicationType
    }
}

package "domain" {
    package "publicationtype" #b0c4d4 {
        class PublicationType <<Root>> <<Entity>> {
        }


        class PublicationTypeFactory <<Factory>>{
          + createPublicationType(publicationTypeName : String) : PublicationType
          + createPublicationType(id : PublicationTypeId) : PublicationType
        }
}

    package "repository" {
            interface IPublicationTypeRepo <<Interface>>
    }


     package "valueobject" {
             class PublicationTypeId <<Value Object>> #lightpink

     }

}

package "ddd" {
    interface IRepository <ID, T> <<Interface>> {
        save(T) : T
        containsOfIdentity(ID) : boolean
    }

    interface AggregateRoot <ID> <<Interface>> {
        }

    interface DomainEntity<ID, T> <<Interface>> {
       +identity() : ID
    }

}


' ===== RELATIONSHIPS =====
AddPublicationTypeUI "1" ..> "1" AddPublicationTypeController: invokes

AddPublicationTypeController "1" ..> "1" IPublicationTypeRepo: calls
AddPublicationTypeController "1" --> "1" PublicationTypeFactory : invokes
AddPublicationTypeController "1" .> "1" PublicationType : <<use>>

IPublicationTypeRepo --|> IRepository
PublicationTypeFactory "1" ..> "1" PublicationType: <<create>>
AggregateRoot -|> DomainEntity

PublicationType "*" <-- "1"  IPublicationTypeRepo : persists
PublicationType ...|> AggregateRoot
PublicationType "1" --> "1" PublicationTypeId: has

@enduml
