@startuml
title Verify the existence of newPublicationType in persistence - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
participant ":AddPublicationTypeController" as CTL
participant ":IPublicationTypeRepo" as REPO
participant ":IPublicationTypeSpringDataRepo" as JPA
participant "newPublicationType\n:PublicationType " as PT

' --- System dialog ---

CTL -> PT : identify()
activate PT
CTL <-- PT : publicationTypeId
deactivate PT

CTL -> REPO : containsOfIdentity(publicationTypeId)
activate REPO

REPO -> JPA : existsById(publicationTypeId.toString)
activate JPA

database "DB" as DB
JPA -> DB : select
activate DB
JPA <-- DB : select
deactivate DB

REPO <-- JPA : false
deactivate JPA

CTL <- REPO : false
deactivate JPA

ref over CTL
[[../Add_New_Publication_Type_SD.puml Back to main diagram]]
end ref

@enduml