@startuml
'==== Title ====
title "As an Administrator, I want to add a publication genre to the official \ngenre list, so that new publications can be of this genre" - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
actor Administrator
participant ":AddGenreUI" as UI
participant ":AddGenreController" as CTL
participant ":IGenreRepo" as IREPO
participant ":GenreFactory" as Factory

'==== UI interaction ====
Administrator -> UI: I want to add a publication genre
activate UI
UI --> Administrator: What is the genre name?
deactivate UI
Administrator -> UI: genreName
activate UI

UI -> CTL: addGenre(genreName)
activate CTL

CTL -> Factory: createGenre(genreName)
activate Factory
create "newGenre:Genre" as G
Factory -->> G: <<create>>(genreName)
Factory --> CTL: newGenre
deactivate Factory

ref over CTL
[[sd-ref-diagrams/Verify_Genre_Existence.puml Verify the existence of genre in persistence]]
end ref

CTL -> IREPO : save(newGenre)
activate IREPO

ref over IREPO
[[sd-ref-diagrams/Save_Genre.puml Save genre and return saved domain object]]
end ref

CTL <-- IREPO : reconstructedGenre
deactivate IREPO

CTL --> UI: reconstructedGenre
deactivate CTL
UI --> Administrator: Done!
deactivate UI

@enduml