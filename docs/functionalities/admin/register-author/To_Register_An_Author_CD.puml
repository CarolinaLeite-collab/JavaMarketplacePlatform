@startuml

'==== Title ====
title "As an Administrator, I want to register an Author in the system, so that publications of that author can be added." CD
top to bottom direction


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
class CreateAuthorUI {
}

package "controller" {

    class CreateAuthorController {
        +createAuthor(authorName : Name) : Author
    }

}

package "domain" {

    package "repository" {

        interface IAuthorRepo <<Interface>> {

        }

    }

    package author #b0c4d4 {

        class Author <<Root>> <<Entity>>{
            +getName() : Name
        }

        class AuthorFactory <<Factory>> {
            +createAuthor(authorName : Name) : Author
            +createAuthor(id : AuthorId, authorName : Name) : Author
        }

    }

    package "valueobject"  {

        '== Value Objects (Ids) ==
        class AuthorId <<ValueObject>> #LightPink {
        -_id : String

        }

    }

}

package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID > <<Interface>>

    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}


'==== Interactions ====

CreateAuthorUI "1" ..> "1" CreateAuthorController : invokes

CreateAuthorController "1" ..> "1" IAuthorRepo : calls
CreateAuthorController "1" .> "*" Author : <<use>>
CreateAuthorController "1" --> "1" AuthorFactory : invokes

AuthorFactory "1" ..> "*" Author : <<create>>

Author "1" -> "1" AuthorId : has

IAuthorRepo --|> IRepository
AggregateRoot -|> DomainEntity
Author ..|> AggregateRoot

@enduml