@startuml
title "Get All Publication Types" - SD

skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off
hidefootbox

participant ":RegisterNew\nAppraisalEntityController" as CTL
participant ":JpaGenreRepo" as JPAREPO
participant ":IGenreSpringDataRepo" as SPRINGREPO
participant ":ImplJpaGenreRepo" as IMPL
database "DB" as DB
participant "genreDm:GenreDataModel" as DM

activate CTL
CTL -> JPAREPO : findAllKeys()
activate JPAREPO

JPAREPO -> SPRINGREPO : findAll()
activate SPRINGREPO

SPRINGREPO -> IMPL : findAll()
activate IMPL

IMPL -> DB : select
activate DB

DB --> IMPL : string based data
deactivate DB

IMPL --> SPRINGREPO : savedGenreDms
deactivate IMPL

SPRINGREPO --> JPAREPO : savedGenreDms
deactivate SPRINGREPO

create "genreIds:List<GenreId>"

JPAREPO -->> "genreIds:List<GenreId>" : <<create>>

    loop for savedGenreDm : savedGenreDms

        JPAREPO -> DM : stringGenreId = getId()
        activate DM
        deactivate DM

        create "genreId:GenreId"
        JPAREPO -->> "genreId:GenreId" : <<create>>(stringGenreId)

        JPAREPO -> "genreIds:List<GenreId>" : add(genreId)

    end

  JPAREPO --> CTL : PublicationTypeIds
  deactivate JPAREPO



ref over CTL
[[../Register_New_Appraisal_Entity_SD.puml Back to Main Diagram]]
end ref
@enduml