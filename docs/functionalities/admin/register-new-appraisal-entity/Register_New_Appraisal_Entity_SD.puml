@startuml
'==== Title ====
title "As an Administrator, I want to register an Appraisal Entity, including the list of genres and publication types it can appraisal" SD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber


' ==== Actor and participants ====
actor Administrator
participant ":Register\nNewAppraisalEntity\nUI" as UI
participant ":Register\nNewAppraisalEntity\nController" as CTL
participant ":IAppraisalEntity\nRepo" as IREPO
participant ":AppraisalEntity\nFactory" as Factory



'==== UI interaction ====
Administrator -> UI: I want to register an Appraisal Entity
activate UI
UI --> Administrator: What is the Appraisal Entity's name?
deactivate UI
Administrator -> UI: name
activate UI

'==== Use case execution ====
UI -> CTL: getPublicationTypesId()
activate CTL
ref over CTL
[[sd-ref-diagrams/Get_Publication_Type_Ids.puml Retrieves the list of all Publication Type Ids]]
end ref
CTL --> UI: publicationTypeIds
deactivate CTL

UI --> Administrator: Here's the list of Publication Types, \n which one(s) can it appraise?
deactivate UI

Administrator -> UI: publicationTypesId
activate UI
UI -> CTL: getGenresId()
activate CTL

ref over CTL
[[sd-ref-diagrams/Get_Genre_Ids.puml Retrieves the list of all genre Ids]]
end ref

'CTL -> grRepo: findAllKeys()
'activate grRepo
'grRepo --> CTL: List<GenreId>
'deactivate grRepo
CTL --> UI: genreIds
deactivate CTL

UI --> Administrator: Here's the list of Genres, which \n one(s) can it appraise?
deactivate UI

Administrator -> UI: genresId
activate UI
UI -> CTL: registerNewAppraisalEntity\n(name, publicationTypeIds, genreIds)
activate CTL

CTL -> Factory: createAppraisalEntity\n(name, publicationTypeIds, genreIds)
create "appraisalEntity:AppraisalEntity"

activate Factory
Factory -->> "appraisalEntity:AppraisalEntity": <<create>>\n(name, publicationTypeIds, genreIds)
Factory --> CTL: appraisalEntity
deactivate Factory

ref over CTL
[[sd-ref-diagrams/Verify_Publication_Type.puml Verify the existence of appraisalEntity in persistence]]
end ref

CTL -> IREPO : save(appraisalEntity)
activate IREPO

ref over IREPO
[[sd-ref-diagrams/Save_Publication_Type.puml Save appraisalEntity and return saved domain object]]
end ref

CTL <-- IREPO : reconstructedAppraisalEntity
deactivate IREPO

CTL --> UI: reconstructedAppraisalEntity
deactivate CTL
UI --> Administrator: Done!
deactivate UI

@enduml