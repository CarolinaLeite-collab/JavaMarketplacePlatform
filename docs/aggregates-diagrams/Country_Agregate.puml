@startuml

title Country Aggregate

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

Package "DOMAIN" {

    Package "COUNTRY" <<Folder>> #b0c4d4 {
        class Country <<Entity>> <<Root>> {
            +identity() : CountryId
            +name() : CountryName
            +isNamed(CountryName) : boolean
            +sameAs(Object) : boolean
        }

        class CountryFactory <<Factory>> {
            +createCountry(CountryId, CountryName) : Country
        }
    }

    Package "VALUEOBJECT" <<Folder>> {
        class CountryId <<ValueObject>> #LightPink {
        }

        class CountryName <<ValueObject>> {
        }
    }

    Package "REPOSITORY" <<Folder>> {
        interface ICountryRepo <<Interface>> {
            +findByName(String) : Optional<Country>
        }
    }

    ' Layout adjustments
    COUNTRY -[hidden]right- REPOSITORY
    VALUEOBJECT -[hidden]right- REPOSITORY
    COUNTRY -[hidden]down- VALUEOBJECT
}

Package "ddd" {
    interface "IRepository<ID, T>" as IRepository <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
    }
}

Package "PERSISTENCE" {
    package "MEM" {
        class MemoCountryRepo <<Repo>> {
        -DATA : Map<CountryId, Country>
        }
    }
}

' ===== Relations =====

CountryFactory "1" <-- "1" MemoCountryRepo : invokes
Country "1" --> "1" CountryId : has
Country "1" *-- "1" CountryName : has

ICountryRepo -|> IRepository
MemoCountryRepo ..|> ICountryRepo
Country "*" <- "1" MemoCountryRepo : persists

CountryFactory ..> Country : <<create>>

@enduml