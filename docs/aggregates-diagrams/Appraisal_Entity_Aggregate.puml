@startuml

'==== Title ====
title AppraisalEntity Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #3B4953
skinparam ArrowFontSize 14
skinparam PackageBorderColor #black
skinparam classAttributeIconSize 0

' ===== Domain =====
Package "domain" {

    Package "appraisalEntity" <<Folder>> #b0c4d4 {
        class AppraisalEntity <<Root>> <<Entity>>  {
            -_publicationTypeIds : List<PublicationTypeId>
            -_genreIds : List<GenreId>

            +getName() : Name
            +getGenreIds () : List<GenreId>
            +getPublicationTypeIds() : List<PublicationTypeId>
            }

    class AppraisalEntityFactory <<Factory>> {
        +createAppraisalEntity(name : Name, genresId : List<GenreId>, \npublicationTypeId : List<PublicationTypeId>) : AppraisalEntity

        }
    }

    package "repository" <<Folder>> {
        interface IAppraisalEntityRepo <<Interface>> {

        }
    }

    Package "valueobject" {
        '== Value Objects (Ids) ==
        class AppraisalEntityId <<ValueObject>> #LightPink {
        -_id : String

       }
        class GenreId <<ValueObject>> {

        }
        class PublicationTypeId <<ValueObject>> {

        }
        ' ===== Value Objects =====
        class Name <<ValueObject>> {

        }

    }

}

' ===== Repository =====
package "persistence" <<Folder>> {

    package "mem" {
        class MemAppraisalEntityRepo {

        }

    }

}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}

' ===== Interactions =====
AppraisalEntity "1" --> "ID 1" AppraisalEntityId : has
AppraisalEntity "1" ..> "1..*" GenreId : references
AppraisalEntity "1" ..> "1..*" PublicationTypeId : references
AppraisalEntity "1" --> "1" Name : has
AppraisalEntity "*" <- "1" MemAppraisalEntityRepo : persists

AppraisalEntityFactory ..> AppraisalEntity : <<create>>


IAppraisalEntityRepo <|. MemAppraisalEntityRepo
IAppraisalEntityRepo ---|> IRepository
AggregateRoot -|> DomainEntity
AppraisalEntity .|> AggregateRoot


@enduml