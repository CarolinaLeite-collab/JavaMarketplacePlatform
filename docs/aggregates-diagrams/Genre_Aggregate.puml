@startuml

title Genre Aggregate

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

Package "domain" {

    Package "genre" <<Folder>> #b0c4d4 {
        class Genre <<Entity>> <<Root>>  {
            -_genre : String
            +getGenre() : String
            +identity() : GenreId
            +sameAs(Object) : boolean
            +equals(Object) : boolean
            +hashCode() : int
            +toString() : String
        }

        class GenreFactory <<Factory>> {
            +createGenre(name : String) : Genre
            '+createGenre(genreID: GenreID , name : String) : Genre'
        }
    }

    Package "valueobject" <<Folder>> {
        class GenreId <<ValueObject>> #LightPink {
            -_id : String
        }
    }

    Package "repository" <<Folder>> {
        interface IGenreRepo <<Interface>> {

        }
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +findAllKeys () : List <ID>
        +ofIdentity(id :ID) : Optional<T>
        +containsOfIdentity(id :ID) : boolean
    }
    interface AggregateRoot <ID >{
             }
    interface DomainEntity<ID, T> <<Interface>> {
                    +identity() : ID
                    +sameAs(object:Object) : boolean
            }


}

Package "persistence" {
    package "mem" {
        class MemGenreRepo <<Repo>> {
        }
    }
}


Genre "1" --> "1" GenreId : has
IGenreRepo -|> IRepository
MemGenreRepo .|> IGenreRepo
Genre "*" <-- "1" MemGenreRepo : persists

GenreFactory ..> Genre : <<create>>

AggregateRoot -|> DomainEntity
Genre .|> AggregateRoot

@enduml