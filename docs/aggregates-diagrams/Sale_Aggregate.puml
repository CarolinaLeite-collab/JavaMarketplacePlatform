@startuml

title Sale Aggregate

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

Package "domain" {

    Package "sale" <<Folder>> #b0c4d4 {
        class Sale <<Entity>> <<Root>> {
            -SaleId _saleId
            -UserId _buyerId
            -SaleStatus _status
            -Price _totalAmount
            -List<SaleLine> _saleLines
        }

        class SaleLine <<Entity>> {
             -SaleLineId _saleLineId
             -DirectSaleId _directSaleId
             -ItemId _itemId
             -UserId _sellerId
             -Price _priceAtSale
                }

        class SaleFactory <<Factory>> {
            +createSale() : SaleLine
            +createSale() : SaleLine
        }
        class SaleLineFactory <<Factory>> {
            +createSaleLine() : Sale
            +createSaleLine() : Sale
        }
    }

    Package "valueobject" <<Folder>> {
        class SaleId <<ValueObject>> #LightPink {
            -String _id
                    }
        class SaleLineId <<ValueObject>>{
                    -String _id
                    }

        enum SaleStatus {
            PENDING
            COMPLETED
            CANCELLED
        }

                class UserId <<Value Object>> #LightPink
                class DirectSaleId <<Value Object>> #LightPink
                class ItemId <<Value Object>> #LightPink
                class Price <<Value Object>> #LightPink
    }

    Package "repository" <<Folder>> {
        interface ISaleRepo <<Interface>> {
        }
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +findAllKeys() : List<ID>
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface AggregateRoot<ID> {}
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
}



Sale "*" <- "1" ISaleRepo : persists

ISaleRepo --|> IRepository
SaleFactory ..> Sale : <<create>>
SaleLineFactory ..> SaleLine : <<create>>
Sale "1" *-- "*" SaleLine: aggregates

Sale ..> SaleId
Sale ..> UserId
Sale ..> Price
Sale ..> SaleStatus

SaleLine ..> SaleLineId
SaleLine ..> DirectSaleId
SaleLine ..> ItemId
SaleLine ..> UserId
SaleLine ..> Price

Sale ..> SaleLineFactory : <<uses>>
Sale ..|> AggregateRoot
SaleLine ..|> DomainEntity
AggregateRoot --|> DomainEntity

AggregateRoot -|> DomainEntity
Sale .|> AggregateRoot

@enduml