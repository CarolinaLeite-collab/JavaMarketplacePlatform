@startuml

title City Aggregate

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

Package "domain" {

    Package "city" <<Folder>> #b0c4d4 {
        class City <<Entity>> <<Root>> {

            +identity() : CityId
            +getName() : String
            +getCountryId() : CountryId
            +sameAs(Object) : boolean
            +equals(Object) : boolean
            +hashCode() : int
            +toString() : String
        }

        class CityFactory <<Factory>> {
            +createCity(cityName : String, countryId : CountryId) : City
        }
    }

    Package "valueobject" <<Folder>> {
        class CityId <<ValueObject>> #LightPink {
            -_name : String
            -_countryId : CountryId
        }
    }

    Package "repository" <<Folder>> {
        interface ICityRepo <<Interface>> {
        }
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +findAllKeys() : List<ID>
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface AggregateRoot<ID> {}
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
}

Package "persistence" {
    package "mem" {
        class MemCityRepo <<Repo>> {
        }
    }
}

City "1" --> "1" CityId : has

ICityRepo -|> IRepository
MemCityRepo .|> ICityRepo
City "*" <-- "1" MemCityRepo : persists

CityFactory ..> City : <<create>>

AggregateRoot -|> DomainEntity
City .|> AggregateRoot

@enduml