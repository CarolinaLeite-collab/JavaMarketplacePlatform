@startuml

'==== Title ====
title city Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== Persistence =====
Package "persistence" {
    package "mem"  {

    class MemoCityRepo <<Repo>> {
}
    }
}

' ===== Domain =====
Package "domain" {

    Package "city" <<Folder>> #b0c4d4  {

        class City <<Entity>> <<Root>> #lightgrey {
            - _name : String
            + getName() : String
            + getCountry() : Country
        }

        class CityFactory <<Factory>> {
            + createCity(String, Country) : City
        }

    }

    Package "valueObject" {

        class CityId <<DomainId>> #LightPink {
            - _normalizedName : String
            + getNormalizedName() : String
            + getCountryId() : CountryId
            + equals(Object) : boolean
            + hashCode() : int
            + toString() : String
        }

        class CountryId <<DomainId>>  {
            - _code : String
            + equals(Object) : boolean
            + hashCode() : int
            + toString() : String
        }

    }

    Package "repository" <<Folder>> {
        interface ICityRepo <<Interface>>  {
            + addCity(City) : City
        }
    }
    }

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }


}


' ===== Relations =====
City "1" --> "ID 1" CityId : has

City "*" ..> "1" CountryId : references

ICityRepo "1" --> "*" City : manages
MemoCityRepo ..|> ICityRepo
ICityRepo -|> IRepository

CityFactory ..> City : <<create>>

AggregateRoot -|> DomainEntity
City .|> AggregateRoot

@enduml