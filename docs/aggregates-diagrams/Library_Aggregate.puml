@startuml
'https://plantuml.com/class-diagram
title Library Aggregate

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

package
package "PERSISTENCE" {

    package "JPA" {
                class JpaLibraryRepo <<Repository>> {
                    - _iSpringDataRepo : ILibrarySpringDataRepo
                    - _libraryAssembler : LibraryAssembler
                }

                interface ILibrarySpringDataRepo <<Interface>> <<SpringData>> {
                    + save(LibraryDataModel)
                    + findById(String)
                }

                class LibraryAssembler <<Component>> {
                    + toDataModel(Library) : LibraryDataModel
                    + toDomain(LibraryDataModel) : Library
                }

                class LibraryDataModel <<Entity>> <<DataModel>> {
                    - libraryId : String
                    - itemIds : List<String>
                }

    }
    package "MEM" {

        class MemoLibraryRepo <<Repo>> {

'        - _libraries : List<Library>
'        - libraryExists(libraryID : LibraryId) : boolean
        }

    }
}

package "DOMAIN" {

    package "REPOSITORY" {

        interface ILibraryRepo <<Interface>> {
            + save(Library) : Library
            + ofIdentity(LibraryId) : Optional<Library>
        }

    }

    package "VALUE OBJECT" {

        class LibraryID <<Value Object>> #LightPink {
            - _id : Email
        }
        class ItemID <<Value Object>> {}
        class UserID <<Value Object>> {}

    }

    package "LIBRARY" #b0c4d4 {

        class Library <<Root>> <<Entity>> {
          + identity() : LibraryID
          + getItemsIDInLibrary() : List<ItemID>
          + addItemIDToLibrary(itemID : ItemID) : boolean
        }

        class LibraryFactory <<Factory>> {
          + createLibrary(libraryID : LibraryID) : Library
          + createLibrary(LibraryID, List<ItemID>) : Library
        }

    }

}

Package "DDD" {

    interface IRepository<ID, T> <<Interface>> {}
    interface DomainEntity<ID> <<Interface>>{}
    interface AggregateRoot<ID> <<Interface>>{}

}

MemoLibraryRepo ...|> ILibraryRepo
ILibraryRepo --|>  IRepository
AggregateRoot --|> DomainEntity
AggregateRoot ..|> Library
MemoLibraryRepo "1" --> "1" LibraryFactory : invokes

MemoLibraryRepo "1" --> "*" Library : persists

Library "1" --> "1" LibraryID: has
Library "1" o-- "*" ItemID: aggregates
Library "1" ..> "*" PublicationDetailsID: returns

LibraryFactory "1" ..> "*" Library: <<create>>

ILibraryRepo ...> UserID : <<use>>

JpaLibraryRepo .up.|> ILibraryRepo

' JPA Internal logic
JpaLibraryRepo --> ILibrarySpringDataRepo : uses
JpaLibraryRepo --> LibraryAssembler : uses
LibraryAssembler ..> LibraryDataModel : transforms
LibraryAssembler ..> LibraryFactory : invokes re-hydration


@enduml