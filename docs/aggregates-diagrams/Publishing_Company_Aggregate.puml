@startuml
'https://plantuml.com/class-diagram
title PublishingCompany Aggregate DDD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

package "persistence" {

    package "mem" {

        class MemPublishingCompanyRepo <<Repo>> {
        }

    }
}

package "domain" {

    package "repository" {

        interface IPublishingCompanyRepo <<Interface>> {
        }

    }

    package "valueobject" {

        class PublishingCompanyId <<Value Object>> #LightPink {
        - _id : String
        }

    }

    package "publishingcompany" #b0c4d4 {

        class PublishingCompany <<Root>> <<Entity>> {
        }

        class PublishingCompanyFactory <<Factory>> {
        + createPublishingCompany(publishingCompanyName : String) : \nPublishingCompany

        }

    }

}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID> <<Interface>> {
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
}


MemPublishingCompanyRepo ..|> IPublishingCompanyRepo
IPublishingCompanyRepo --|> IRepository
MemPublishingCompanyRepo "1" --> "*" PublishingCompany : persists

PublishingCompany "1" --> "1" PublishingCompanyId: has

PublishingCompanyFactory "1" ..> "*" PublishingCompany: <<create>>

AggregateRoot -|> DomainEntity
PublishingCompany .|> AggregateRoot
@enduml