@startuml
'https://plantuml.com/class-diagram
title PublishingCompany Aggregate DDD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

package "persistence" {

    package "memo" {

        class MemoPublishingCompanyRepo <<Repo>> {
        }

    }
}

package "domain" {

    package "repository" {

        interface IPublishingCompanyRepo <<Interface>> {
        + registerPublishingCompany(publishingCompanyName : String) : \nPublishingCompany
        }

    }

    package "valueobject" {

        class PublishingCompanyId <<valueobject>> #LightPink {
        - _id : String
        }

    }

    package "publishingcompany" #b0c4d4 {

        class PublishingCompany <<Root>> <<Entity>> {
        + isSamePublishingCompany (publishingCompanyName : String) : boolean
        + getName() : String
        }

        class PublishingCompanyFactory <<Factory>> {
        + createPublishingCompany(publishingCompanyName : String) : \nPublishingCompany

        }

    }

}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}


MemoPublishingCompanyRepo ..|> IPublishingCompanyRepo
IPublishingCompanyRepo ..|> IRepository
MemoPublishingCompanyRepo "1" --> "1" PublishingCompanyFactory : invokes

MemoPublishingCompanyRepo "1" --> "*" PublishingCompany : persists

PublishingCompany "1" --> "1" PublishingCompanyId: has

PublishingCompanyFactory "1" ..> "*" PublishingCompany: <<create>>

AggregateRoot -|> DomainEntity
PublishingCompany .|> AggregateRoot
@enduml