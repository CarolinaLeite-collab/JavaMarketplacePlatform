@startuml

'==== Title ====
title User Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== Persistence =====
Package "Persistence" {
    package "mem"  {
    class MemoUserRepo <<Repo>> {
    }
   }
}

' ===== Domain =====
Package "domain" {

    Package "user" <<Folder>> #b0c4d4 {

        class User <<Entity>> <<Root>> #lightgrey {
            + hasEmail(Email) : boolean
            + hasRole(Role) : boolean
            + addRole(Role) : void
            + getName() : Name
            + getEmail() : String
            + getAddress() : Address
            + getPhone() : Phone
            + getRoles() : Set<Role>
        }

        class UserFactory <<Factory>> {
            + createUser(String, String) : User
        }

    }

    Package "valueobject" {

        class UserId <<DomainId>> #LightPink {
            + getEmail() : Email
            + equals(Object) : boolean
            + hashCode() : int
            + toString() : String
        }

        class Email <<ValueObject>> {
            - _email : String
            + getValue() : String
            + toString() : String
        }

        class Name <<ValueObject>>{
            - _name : String
            + get_Name() : String
            + toString() : String
        }

        class Address <<ValueObject>> {
        }

        class Phone <<ValueObject>> {
        }

        enum Role <<ValueObject>> {
            ADMIN
            USER
        }
    }

    Package "repository" <<Folder>> {
        interface IUserRepo <<Interface>> {
            + addUser(User) : User
        }
    }

 }

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}




' ===== Relations =====
User "1" --> "ID 1" UserId : has
User "1" --> "1" Email : has

User --> Name : has
User --> Role : has
User --> Address : has
User --> Phone : has

IUserRepo "1" --> "*" User : manages
MemoUserRepo ..|> IUserRepo

UserFactory ..> User : <<create>>

AggregateRoot -|> DomainEntity
User .|> AggregateRoot

IUserRepo -|> IRepository


@enduml