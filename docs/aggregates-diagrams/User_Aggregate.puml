@startuml

title User Aggregate

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction

Package "domain" {

    Package "user" <<Folder>> #b0c4d4 {
        class User <<Entity>> <<Root>> {
            +identity() : UserId
            +hasRole(role : Role) : boolean
            +hasEmail(email : Email) : boolean
            +addRole(role : Role) : void
            +getName() : Name
            +getEmail() : String
            +getAddress() : Address
            +getPhone() : Phone
            +sameAs(Object) : boolean
            +equals(Object) : boolean
            +hashCode() : int
            +toString() : String
        }

        class UserFactory <<Factory>> {
            +createUser(name : Name, address : Address, email : Email, phone : Phone) : User
        }
    }

    Package "valueobject" <<Folder>> {
        class UserId <<ValueObject>> #LightPink {
            -_id : Email
        }
    }

    Package "repository" <<Folder>> {
        interface IUserRepo <<Interface>> {
        }
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +findAllKeys() : List<ID>
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface AggregateRoot<ID> {}
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
}

Package "persistence" {
    package "mem" {
        class MemUserRepo <<Repo>> {
        }
    }
}

User "1" --> "1" UserId : has

IUserRepo -|> IRepository
MemUserRepo .|> IUserRepo
User "*" <-- "1" MemUserRepo : persists

UserFactory ..> User : <<create>>

AggregateRoot -|> DomainEntity
User .|> AggregateRoot

@enduml