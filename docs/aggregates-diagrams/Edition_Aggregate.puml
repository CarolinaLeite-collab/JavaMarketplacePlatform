@startuml

'==== Title ====
title Edition Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
Package "DOMAIN" {

    Package "EDITION" <<Folder>> #b0c4d4 {

        interface Edition <<Root>> <<Entity>> {
            +getPublicationId() : PublicationId
            +getPublishingCompanyId() : PublishingCompanyId
            +getPublishingYear() : Year
            +getEditionLanguage() : Language
        }

        class EditionBook <<Entity>> {
            -_bookId : BookId
            +identity() : EditionId
                +equals(Object) : boolean
                +sameAs(Object) : boolean
                +toString() : String

            +getNumberOfPages() : NumberOfPages
            +getEditionNumber() : EditionNumber
            +getBinding() : Binding
            +getDimension() : Dimension
            +getWeight() : Weight
        }


        class EditionMagazine <<Entity>> {
            -_magazineId : MagazineId
            +identity() : EditionId
                +equals(Object) : boolean
                +sameAs(Object) : boolean
                +toString() : String

                +getDimension() : Dimension
                +getWeight() : Weight
                +getIssueNumber() : IssueNumber
                +getPeriodicity() : Periodicity

        }


        class EditionFactory <<Factory>> {
            +createEditionBook : EditionBook
            +createEditionMagazine : EditionMagazine
        }

        class "EditionBook::Builder" as EditionBookBuilder <<Builder>>

        class "EditionMagazine::Builder" as EditionMagazineBuilder <<Builder>>


        EditionBook +- EditionBookBuilder
        EditionBookBuilder ..> EditionBook : builds

        EditionMagazine +- EditionMagazineBuilder
        EditionMagazineBuilder ..> EditionMagazine : builds


    }

    Package "VALUEOBJECT" <<Folder>> {

        class EditionId <<ValueObject>> #LightPink {
            +getIdentifier()
        }
        interface MagazineId {}

        interface BookId {}

        class NumberOfPages <<ValueObject>>
        class Binding <<ValueObject>>
        class IssueNumber <<ValueObject>>
        class Periodicity <<ValueObject>>
        class ISBN <<ValueObject>>
        class ISSN <<ValueObject>>
        class NoIsbnBook <<ValueObject>>
        class NoIssnMagazine <<ValueObject>>
        class Language <<ValueObject>>
        class PublicationId <<ValueObject>>
        class PublishingCompanyId <<ValueObject>>
        class EditionNumber <<ValueObject>>
    }

    Package "REPOSITORY" <<Folder>> {
        interface IEditionRepo <<Interface>>{
        +addEditionBook(): Edition
        +addEditionMagazine(): Edition
        }
    }

    EDITION -[hidden]right- REPOSITORY
    EDITION -[hidden]down- VALUEOBJECT
    VALUEOBJECT -[hidden]right- REPOSITORY

}

Package "DDD" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
    }
}

Package "PERSISTENCE" {
    package "MEM" {
        class MemoEditionRepo <<Repo>>
    }
}

' ===== Relations =====
Edition "1" --> "ID 1" EditionId : has
Edition <|.. EditionBook
Edition <|.. EditionMagazine
Edition ..> PublicationId : references
Edition ..> PublishingCompanyId : references
Edition --> Language : has
Edition --> EditionNumber : has

EditionBook --> NumberOfPages : has
EditionBook --> Binding : has
EditionMagazine --> IssueNumber : has
EditionMagazine --> Periodicity : has

EditionId <|.. BookId
EditionId <|.. MagazineId

BookId <|.. ISBN
BookId <|.. NoIsbnBook

MagazineId <|.. ISSN
MagazineId <|.. NoIssnMagazine


IEditionRepo -|> IRepository
MemoEditionRepo ..|> IEditionRepo

EditionFactory ..> Edition : <<create>>

Edition "*" <- "1" MemoEditionRepo : persists
EditionFactory "1" <-- "1" MemoEditionRepo : invokes

@enduml