@startuml

'==== Title ====
title Edition Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
package "edition" {

    package "edition" <<Folder>> #b0c4d4 {

        class Edition <<Root>> <<Entity>> {
            -_publishingYear : Year

            -isValidIdentifier(typeId : PublicationTypeId, identifier : Identifier, year : Year) : boolean
            +getPublicationTypeId() : PublicationTypeId
            +getIdentifier() : Identifier
            +getPublicationId() : PublicationId
            +getPublishingCompanyId() : PublishingCompanyId
            +getPublishingYear() : Year
            +getEditionLanguage() : Language
            +getNumberOfPages() : NumberOfPages
            +getEditionNumber() : EditionNumber
            +getBinding() : Binding
            +getDimension() : Dimension
            +getWeight() : Weight
            + isByPublishingCompanyId(publishingCompanyId : PublishingCompanyId) : boolean
            + isByPublicationId(publicationId : PublicationId) : boolean
        }


        class EditionFactory <<Factory>> {
            +createEdition(typeId : PublicationTypeId, identifier : Identifier, publicationId : PublicationId, \npublishingCompanyId : PublishingCompanyId, publishingYear : Year, editionLanguage : Language, \ndimension : Dimension, weight : Weight, numberOfPages : NumberOfPages, editionNumber : EditionNumber, \nbinding : Binding) : Edition

            +createEdition(generatedId : EditionId, typeId : PublicationTypeId, identifier : Identifier, publicationId : PublicationId, \npublishingCompanyId : PublishingCompanyId, publishingYear : Year, editionLanguage : Language, dimension : Dimension, \nweight : Weight, numberOfPages : NumberOfPages,
                editionNumber : EditionNumber, binding : Binding) : Edition
        }

    }

    package "valueobject" <<Folder>> {

        class EditionId <<ValueObject>> #LightPink {
            -_eId : String
        }

        interface Identifier <<ValueObject>> {
            +getIdentifier()
        }

        class PublicationTypeId <<ValueObject>>
        class PublicationId <<ValueObject>>
        class PublishingCompanyId <<ValueObject>>
        class Language <<ValueObject>>
        class ISBN <<ValueObject>>
        class ISSN <<ValueObject>>
        class NoIdentifier <<ValueObject>>

        class Dimension <<ValueObject>>
        class Weight <<ValueObject>>
        class NumberOfPages <<ValueObject>>
        class EditionNumber <<ValueObject>>
        class Binding <<ValueObject>>

    }

    Package "repository" <<Folder>> {
        interface IEditionRepo <<Interface>>{
            +addEdition
        }
    }

    edition -[hidden]right- repository
    edition -[hidden]down- valueobject
    valueobject -[hidden]right- repository

}

package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}

' ===== Relations =====
Edition "1" --> "ID 1" EditionId : has
Edition "*" ..> "1" PublicationId : references
Edition "*" ..> "1" PublishingCompanyId : references
Edition "*" ..> "1" PublicationTypeId : references
Edition "*" --> "1" Language : has

Edition "1" --> "1" Identifier : has
Identifier <|.. ISBN
Identifier <|.. ISSN
Identifier <|.. NoIdentifier

' optional atributes
Edition "*" --> "0..1" Dimension : has
Edition "*" --> "0..1" Weight : has
Edition "*" --> "0..1" NumberOfPages : has
Edition "*" --> "0..1" EditionNumber : has
Edition "*" --> "0..1" Binding : has



IEditionRepo -|> IRepository
Edition ..|> AggregateRoot
AggregateRoot -|> DomainEntity

EditionFactory ..> Edition : <<create>>

Edition "*" <- "1" IEditionRepo : persists

@enduml