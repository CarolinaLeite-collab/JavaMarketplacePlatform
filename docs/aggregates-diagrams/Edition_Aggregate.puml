@startuml

'==== Title ====
title Edition Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 11
skinparam classAttributeFontStyle plain

' ===== Domain =====
Package "edition" {

    Package "edition" <<Folder>> #b0c4d4 {

        class Edition <<Root>> <<Entity>> {
            -_publishingYear : Year

            -isValidIdentifier(typeId : PublicationTypeId, identifier : Identifier, year : Year) : boolean
            +getPublicationTypeId() : PublicationTypeId
            +getIdentifier() : Identifier
            +getPublicationId() : PublicationId
            +getPublishingCompanyId() : PublishingCompanyId
            +getPublishingYear() : Year
            +getEditionLanguage() : Language
            +getNumberOfPages() : NumberOfPages
            +getEditionNumber() : EditionNumber
            +getBinding() : Binding
            +getDimension() : Dimension
            +getWeight() : Weight
        }


        class EditionFactory <<Factory>> {
            +createEdition : Edition
        }

    }

    Package "valueobject" <<Folder>> {

        class EditionId <<ValueObject>> #LightPink {
            +equals()
        }

        Interface Identifier <<ValueObject>> {
            +getIdentifier()
        }

        class PublicationTypeId <<ValueObject>>
        class PublicationId <<ValueObject>>
        class PublishingCompanyId <<ValueObject>>
        class Language <<ValueObject>>
        class ISBN <<ValueObject>>
        class ISSN <<ValueObject>>

        class Dimension <<ValueObject>>
        class Weight <<ValueObject>>
        class NumberOfPages <<ValueObject>>
        class EditionNumber <<ValueObject>>
        class Binding <<ValueObject>>

    }

    Package "repository" <<Folder>> {
        interface IEditionRepo <<Interface>>{
        +addEdition(): Edition
                }
    }

    edition -[hidden]right- repository
    edition -[hidden]down- valueobject
    valueobject -[hidden]right- repository

}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +equals(Object) : boolean
        +sameAs(Object) : boolean
        +toString() : String
    }
}

Package "persistence" {
    package "mem" {
        class MemoEditionRepo <<Repo>>
    }
}

' ===== Relations =====
Edition "1" --> "ID 1" EditionId : has
Edition "*" ..> "1" PublicationId : references
Edition "*" ..> "1" PublishingCompanyId : references
Edition "*" ..> "1" PublicationTypeId : references
Edition "*" --> "1" Language : has

Edition "1" --> "1" Identifier : has
Identifier <|.. ISBN
Identifier <|.. ISSN

' optional atributes
Edition "*" --> "0..1" Dimension : has
Edition "*" --> "0..1" Weight : has
Edition "*" --> "0..1" NumberOfPages : has
Edition "*" --> "0..1" EditionNumber : has
Edition "*" --> "0..1" Binding : has



IEditionRepo ..|> IRepository
MemoEditionRepo ..|> IEditionRepo
Edition ..|> DomainEntity


EditionFactory ..> Edition : <<create>>

Edition "*" <- "1" MemoEditionRepo : persists
EditionFactory "1" <-- "1" MemoEditionRepo : invokes

@enduml