@startuml
title ListOfItems Aggregate - CD - DDD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

Package "domain" {

    Package listofitems #B0C4DE {
        Class "ListOfItems" as ListOfItemsRoot <<Root>> <<Entity>> {
            - _name: String
            - _isPrivate : boolean
            - _itemIds : List<ItemId>
            + getUserId() : UserId
            + getName() : String
            + getGenreId() : GenreId
            + isPrivate() : boolean
            + makePublic() : void
            + getItemIds() : List<ItemId>
            + addItem(itemId : ItemId) : void
        }
        Class ListOfItemsFactory <<Factory>> {
            + createListOfItems(userId : UserId, name : String, genreId : GenreId) : ListOfItems
            + createListOfItems(listOfItemsId : ListOfItemsId, userId : UserId, name : String, genreId : GenreId) : ListOfItems
            + createPublicListOfItems(userId : UserId, name : String, genreId : GenreId) : ListOfItems
        }
    }

    Package repository {
        Interface "IListOfItemsRepo" as IRepo <<Interface>> {
        }
    }

    Package valueobject {
        Class "ItemId" as ItemId <<ValueObject>> {}
        Class "UserId" as UserId <<ValueObject>> {}
        Class "GenreId" as GenreId <<ValueObject>> {}
        Class "ListOfItemsId" as Id <<ValueObject>> #LightPink {}
    }
}

Package "persistence" {

    Package "mem" {
        Class "MemListOfItemsRepo" as MemRepo <<Repo>> {
        }
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface DomainEntity<ID> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
    interface AggregateRoot<ID> <<Interface>> {}
}

' === Interactions === '

ListOfItemsFactory ..> ListOfItemsRoot : <<create>>
ListOfItemsRoot "1" o-- "*" ItemId : aggregates
ListOfItemsRoot "1" --> "1" Id : has
ListOfItemsRoot "*" ..> "1" UserId : references
ListOfItemsRoot "*" ..> "1" GenreId : references

MemRepo .|> IRepo
IRepo ---|> IRepository

AggregateRoot --|> DomainEntity
AggregateRoot ..|> ListOfItemsRoot

@enduml