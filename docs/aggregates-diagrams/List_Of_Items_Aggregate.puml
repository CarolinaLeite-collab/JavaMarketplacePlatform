@startuml
'https://plantuml.com/class-diagram

title ListOfItems Aggregate - CD - DDD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0



' === Classes === '

Package "Domain" {
    Package ListOfItems #B0C4DE {
        Class "ListOfItems" as ListOfItemsRoot <<Root>> {
            - _name: String
            - _isPrivate : boolean
            - _itemsID : List<ItemID>
            + getUserID() : UserID
            + getName() : String
            + getGenreID() : GenreID
            + isPrivate() : boolean
            + makePublic() : void
            + getItemsID() : List<ItemID>
            + addItem(ItemID itemID) : void
        }
        Class ListOfItemsFactory {
        + createListOfItems(UserID userID, String name, GenreID genreID) : List<ListOfItemsID>
        + createPublicListOfItems(UserID userID, String name, GenreID genreID) : List<ListOfItemsID>
        }
    }
    Package Repository {
    Interface "IListOfItemsRepo" as IRepo <<Interface>> {
    }
    }
    Package ValueObject {
    Class "ItemID" as Item <<ValueObject>> {}
    Class "UserID" as User <<ValueObject>> {}
    Class "GenreID" as Genre <<ValueObject>> {}
    Class "ListOfItemsID" as ID <<ValueObject>> #LightPink {}
    }
}

Package "Persistence" {
    Package "MEM" {
        Class "MemoListOfItemsRepo" as MemoRepo <<Repo>> {
            + addListOfItems(UserID userID, String name, GenreID genreID) : List<ListOfItemsID>
            + getListOfListOfItems() : List<ListOfItemsID>
            + findPublicListsByGenre(GenreID genreID) : List<ListOfItemsID>
            + findListsByUser(UserID userID) : List<ListOfItemsID>
            + findByOwnerNameAndGenre(UserID userID, String name, GenreID genreID) : List<ListOfItemsID>
        }
    }
}


' === Interactions === '

ListOfItemsFactory ..> ListOfItemsRoot : creates
ListOfItemsRoot "*" o... "1..*" Item : aggregates
ListOfItemsRoot "*" ...> "1" User : references
ListOfItemsRoot "*" ...> "1" Genre : references
ListOfItemsRoot "1" --> "1" ID : has

MemoRepo "1" ---> "1" ListOfItemsFactory :invokes
MemoRepo "1" --> "*" ListOfItemsRoot :persistes

IRepo "1" <|.. "1" MemoRepo


@enduml