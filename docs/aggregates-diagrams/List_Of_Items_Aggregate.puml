@startuml
title ListOfItems Aggregate

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

Package "domain" {

    Package listofitems #B0C4DE {
        Class "ListOfItems" as ListOfItemsRoot <<Root>> <<Entity>> {
            - _isPrivate : boolean
            + getUserId() : UserId
            + getName() : Name
            + getGenreId() : GenreId
            + getItemIds() : List<ItemId>
            + addItem(itemId : ItemId) : void
            + isPrivate() : boolean
            + makePublic() : void
            - _sharedUntil : LocalDateTime
            + makePublic(duration : SharedDuration) : void
            + getSharedUntil() : LocalDateTime
        }
        Class ListOfItemsFactory <<Factory>> {
            + createListOfItems(userId : UserId, name : Name, genreId : GenreId) : ListOfItems
            + createListOfItems(listOfItemsId : ListOfItemsId, userId : UserId, name : Name, genreId : GenreId) : ListOfItems
            + createPublicListOfItems(userId : UserId, name : Name, genreId : GenreId) : ListOfItems
            + createListOfItems(listOfItemsId : ListOfItemsId, userId : UserId, name : Name, genreId : GenreId, isPrivate : boolean, sharedUntil : LocalDateTime) : ListOfItems
            + createPublicListOfItems(userId : UserId, name : Name, genreId : GenreId, duration : SharedDuration) : ListOfItems
        }
    }

    Package repository {
        Interface "IListOfItemsRepo" as IRepo <<Interface>> {
        }
    }

    Package valueobject {
        Class "ItemId" as ItemId <<ValueObject>> {}
        Class "UserId" as UserId <<ValueObject>> {}
        Class "GenreId" as GenreId <<ValueObject>> {}
        Class "Name" as Name <<ValueObject>> {}
        Class "ListOfItemsId" as Id <<ValueObject>> #LightPink {}
        Class "SharedDuration" as SharedDuration <<ValueObject>> {}
    }
}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity : T) : T
        +findAll() : Iterable<T>
        +findAllKeys() : List<ID>
        +ofIdentity(id : ID) : Optional<T>
        +containsOfIdentity(id : ID) : boolean
    }
    interface DomainEntity<ID> <<Interface>> {
        +identity() : ID
        +sameAs(object : Object) : boolean
    }
    interface AggregateRoot<ID> <<Interface>> {}
}

ListOfItemsFactory ..> ListOfItemsRoot : <<create>>
ListOfItemsRoot "1" o-- "*" ItemId : aggregates
ListOfItemsRoot "1" --> "1" Id : has
ListOfItemsRoot "*" ..> "1" UserId : references
ListOfItemsRoot "*" ..> "1" GenreId : references
ListOfItemsRoot "1" ..> "1" Name : references
ListOfItemsRoot "*" <- "1" IRepo : persists
ListOfItemsRoot "*" ..> "1" SharedDuration : references



IRepo ---|> IRepository

ListOfItemsRoot .|> AggregateRoot
AggregateRoot --|> DomainEntity

@enduml