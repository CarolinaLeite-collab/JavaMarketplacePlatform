@startuml

'==== Title ====
title Author Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #3B4953
skinparam ArrowFontSize 14
skinparam PackageBorderColor #black
skinparam classAttributeIconSize 0

' ===== Domain =====
Package "domain" {

    Package "author" <<Folder>> #b0c4d4 {
        class Author <<Root>> <<Entity>> {
            -_name : String
            +identity() : AuthorId
            +sameAs(Object) : boolean
            +getName() : Name
            +getLowerCaseName() : Name
        }

        class AuthorFactory <<Factory>> {
            +createAuthor(authorName : String) : Author
        }
    }

    package "repository" <<Folder>>  {
        interface IAuthorRepo <<Interface>> {
        +addAuthor(authorName : String) : Author

        }
    }

    Package "valueobject"  {
        '== Value Objects (Ids) ==
        class AuthorId <<ValueObject>> #LightPink {
        -_id : String

        }

        ' ===== Value Objects =====
        class Name <<ValueObject>> {

        }

    }

}

' ===== Repository =====
package "persistence" <<Folder>> {

    package "mem"  {
        class MemoAuthorRepo {

        }
    }
}


Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >{
    }
    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}


' ===== Interactions =====
Author "1" --> "ID 1" AuthorId : has
Author "*" <--- "1" MemoAuthorRepo : persists
Author "1" --> "1" Name : has

AuthorFactory ..> Author : <<create>>


IAuthorRepo <|. MemoAuthorRepo
IAuthorRepo --|> IRepository

AggregateRoot -|> DomainEntity
Author ....|> AggregateRoot

@enduml