@startuml

'==== Title ====
title Author Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam defaultFontName Futura
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #3B4953
skinparam ArrowFontSize 14
skinparam PackageBorderColor #black
skinparam classAttributeIconSize 0

' ===== Domain =====
package "domain" {

    package "author" #b0c4d4 {
        class Author <<Root>> <<Entity>> {
            -_name : String
            +getName() : String
            +getLowerCaseName() : String
        }

        class AuthorFactory <<Factory>> {
            +createAuthor(authorName : Name) : Author
            +createAuthor(id : AuthorId, authorName : Name) : Author
        }
    }

    package "repository"  {
        interface IAuthorRepo <<Interface>>
    }

    package "valueobject"  {
        class AuthorId <<ValueObject>> #LightPink {
        -_id : String
        }
    }
}


package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(entity: T) : T
        +findAll() : Iterable<T>
        +ofIdentity(id: ID) : Optional<T>
        +containsOfIdentity(id: ID) : boolean
        +findAllKeys() : List<ID>
    }

    interface AggregateRoot <ID >

    interface DomainEntity<ID, T> <<Interface>> {
        +identity() : ID
        +sameAs(Object) : boolean
    }
}


' ===== Interactions =====
Author "1" --> "1" AuthorId : has
Author "*" <--- "1" IAuthorRepo : persists

AuthorFactory ..> Author : <<create>>

IAuthorRepo --|> IRepository

AggregateRoot -|> DomainEntity
Author ....|> AggregateRoot

@enduml