@startuml

'==== Title ====
title Publication Aggregate


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

top to bottom direction
' ===== Domain =====
Package "DOMAIN" {

    Package "PUBLICATION" #b0c4d4 {

        class Publication <<Root>> <<Entity>> {
            -_releaseYear : Year
            +isByAuthor( a : AuthorId) : boolean
            +isByGenre(g : GenreId) : boolean
            +identity() : PublicationId
            +sameAs(Object) : boolean
        }

        class PublicationFactory <<Factory>> {
            +createPublication(t : Title, a : AuthorId, y : Year, pubTypId : PublicationTypeId, gId: GenreId) : Publication
            +createPublication(p : PublicationId, t :Title, a : AuthorId, y : Year, pubTypId : PublicationTypeId, g : GenreId) : Publication
        }

    }

    Package "VALUEOBJECT"  {

        class PublicationId <<ValueObject>> #LightPink {
            -_id : String

        }

        class Title <<ValueObject>> {
        }

        class AuthorId <<ValueObject>> {
        }

        class GenreId <<ValueObject>>{
        }

        class PublicationTypeId <<ValueObject>>  {
        }

    }

    Package "REPOSITORY"   {
        interface IPublicationRepo <<Interface>>
    }

    Publication -[hidden]right- IPublicationRepo
    PublicationId -[hidden]right- IPublicationRepo

}

Package "ddd" {
    interface IRepository<ID, T> <<Interface>> {
        +save(T) : T
        +findAll() : Iterable<T>
        +ofIdentity(ID) : Optional<T>
        +containsOfIdentity(ID) : boolean
    }
}

' ===== Persistence =====
Package "PERSISTENCE" {
     package "mem"  {
     class MemoPublicationRepo <<Repo>>
    }
}

' ===== Relations =====
Publication "1" --> "ID 1" PublicationId : has
Publication --> Title : has
Publication ..> AuthorId : references
Publication ..> GenreId : references
Publication ..> PublicationTypeId : references

IPublicationRepo -|> IRepository
MemoPublicationRepo ..|> IPublicationRepo
Publication "*" <-- "1" MemoPublicationRepo : persists
PublicationFactory "1"<-- "1" MemoPublicationRepo : invokes
PublicationFactory ..> Publication : <<create>>

@enduml