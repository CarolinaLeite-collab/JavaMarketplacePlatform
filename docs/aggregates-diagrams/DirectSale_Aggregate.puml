@startuml

'==== Title ====
title DirectSale Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
Package "domain" {

    Package "directsale" #b0c4d4 {
        class DirectSale <<Entity>> <<Root>> {
            _timeLimit : Period
            +getItemIds() : List<ItemId>
            +getPrice() : Price
            +getTimeLimit() : Period
            +sameAs(object : Object) : boolean
            +identity() : DirectSaleId
            -requiresItemIdsAndPrice(itemIds : List<ItemId>, price : Price)
            -timeLimitMustBeValid(timeLimit : Period)
            }

            class DirectSaleFactory <<Factory>> {
            + createDirectSale(item : ItemId, price : Price, timeLimit : Period) : DirectSale
            }
}
    Package "repository" {
        interface IDirectSaleRepo{
        addDirectSale(item : ItemId, price : Price, timeLimit : Period) : DirectSale
        }
    }

    Package "valueobject" {
    '== Value Objects (Ids) ==
        class DirectSaleId <<ValueObject>> #LightPink{
        _directSaleId : String
        }
    ' ===== Value Objects =====
        class Price <<ValueObject>>
        class ItemId <<ValueObject>>
    }
}

Package "persistence" {
    Package "mem"{
        class MemDirectSaleRepo{
        }
    }
}

Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(entity : T) : T
    findAll() : Iterable<T>
    ofIdentity(id : ID) : Optional <T>
    containsOfIdentity(id : ID) : boolean
    findAllKeys() : List<DirectSaleId>
    }

    interface AggregateRoot <<Interface>> {
    }

    interface DomainEntity <<Interface>>{
    +identity(): T
    +sameAs(object : Object): boolean
    }
}


DirectSale "1" --> "ID 1" DirectSaleId : has

MemDirectSaleRepo "1" --> "*" DirectSaleFactory : invokes
MemDirectSaleRepo "1" --> "*" DirectSale : persists

DirectSale "*" --> "1" Price : has
DirectSale "1" o--  "1..*" ItemId : aggregates

' ===== Factory =====
DirectSaleFactory "1" ..> "*" DirectSale : <<create>>


' ===== Repository =====
AggregateRoot ..|> DomainEntity
IDirectSaleRepo --|> IRepository
MemoDirectSaleRepo ..|> IDirectSaleRepo
DirectSale ..|> AggregateRoot

@enduml