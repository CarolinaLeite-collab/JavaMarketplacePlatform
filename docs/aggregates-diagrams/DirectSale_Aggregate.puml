@startuml

'==== Title ====
title DirectSale Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
Package "domain" {

    Package "directsale" #b0c4d4 {
        class DirectSale <<Entity>> <<Root>> {
            -timeLimit : Duration
            -creationDate : Instant

            +getItemsId() : List<ItemId>
            +getSellerId() : UserId
            +getPrice() : Price
            +getTimeLimit() : Duration
            +getCreationDate() : Instant
            +getDSStatus() : DirectSaleStatus
            +markAsCompleted() : void
            +markAsExpired() : void
            +identity() : DirectSaleId
            +equals(object : Object) : boolean
            +sameAs(object : Object) : boolean
            -requiresItemAndPrice(itemsId : List<ItemId>, price : Price) : void
            -timeLimitMustBeValid(timeLimit : Duration) : void
            -ensureNoDuplicateItems(itemsId : List<ItemId>) : void
        }

            class DirectSaleFactory <<Factory>> {
            + createDirectSale(item : ItemId, price : Price, timeLimit : Period) : DirectSale
            }
}
    Package "repository" {
        interface IDirectSaleRepo {
            +findDirectSaleItemsByAuthorIdSortedByDescription(authorId : AuthorId) : List<ItemId>
            +findByItemsIdSortedByPublicationDateAsc(itemIds : List<ItemId>) : List<DirectSale>
            +findByItemsIdSortedByPublicationDateDesc(itemIds : List<ItemId>) : List<DirectSale>
            +findExpired() : List<DirectSaleId>
            +deleteDirectSale(directSaleId : DirectSaleId) : void
        }
    }

    Package "valueobject" {
    '== Value Objects (Ids) ==
        class DirectSaleId <<ValueObject>> #LightPink{
        _directSaleId : String
        }
    ' ===== Value Objects =====
        class Price <<ValueObject>>
        class ItemId <<ValueObject>>
        class UserId <<ValueObject>>
        enum DirectSaleStatus
    }
}



Package "ddd" {

    interface IRepository<ID, T> <<Interface>> {
    save(entity : T) : T
    findAll() : Iterable<T>
    ofIdentity(id : ID) : Optional <T>
    containsOfIdentity(id : ID) : boolean
    findAllKeys() : List<DirectSaleId>
    }

    interface AggregateRoot <<Interface>> {
    }

    interface DomainEntity <<Interface>>{
    +identity(): T
    +sameAs(object : Object): boolean
    }
}


DirectSale "1" --> "ID 1" DirectSaleId : has


DirectSale "*" --> "1" Price : has
DirectSale "1" o--  "1..*" ItemId : aggregates
DirectSale "1" --> "1" UserId : has
DirectSale "1" --> "1" DirectSaleStatus : has

' ===== Factory =====
DirectSaleFactory "1" ..> "*" DirectSale : <<create>>

IDirectSaleRepo "*" --> "1" DirectSale : persists

' ===== Repository =====
AggregateRoot ..|> DomainEntity
IDirectSaleRepo --|> IRepository
DirectSale ..|> AggregateRoot

@enduml