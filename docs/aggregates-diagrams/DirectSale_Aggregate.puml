@@ -0,0 +1,103 @@
@startuml

'==== Title ====
title DirectSale Aggregate
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


' ===== Domain =====
Package "DOMAIN" {

    Package "DIRECTSALE" #b0c4d4 {
        class DirectSale <<Entity>> <<Root>> {
            -_items : List<ItemId>
            -_price : Price
            -_timeLimit : Period
            +getItem() : ItemId
            +getPrice() : Price
            +getTimeLimit() : Period
            +isByAuthor(author : AuthorId) : boolean
            +isByPublication(publication : PublicationId) : boolean
            +isByPublisher(publishingCompany : PublishingCompanyId) : boolean
            +isByGenre(genre : GenreId) : boolean
            -requiresItemAndPrice(item : ItemId, price : Price)
            -timeLimitMustBeValid(timeLimit : Period)
            }

            class DirectSaleFactory {
            + createDirectSale(item : ItemId, price : Price, timeLimit : Period) : DirectSale
            }
}
Package "REPOSITORY" {
interface IDirectSaleRepo{
addDirectSale(item : ItemId, price : Price, timeLimit : Period) : DirectSale
getDirectSaleItemsByAuthor(author : AuthorId) : List<ItemId>
getDirectSaleItemsByGenre(genre : GenreId) : List<ItemId>
getDirectSaleItemsByPublication(publication : PublicationId) : List<ItemId>
getDirectSaleItemsByPublisher(publishingCompany : PublishingCompanyId) : List<ItemId>
}

}


Package "VALUEOBJECT" {
'== Value Objects (Ids) ==
class DirectSaleId <<ValueObject>> #LightPink{
}


' ===== Value Objects =====
class Price <<ValueObject>>
class Period <<ValueObject>>
class ItemId <<ValueObject>>

'==== Cross-aggregate ID references ====
class AuthorId <<ValueObject>>
class GenreId <<ValueObject>>
class PublishingCompanyId <<ValueObject>>
class PublicationId <<ValueObject>>
}
}

Package "PERSISTENCE" {
Package "MEMO"{
class MemoDirectSaleRepo{
_directSales : List<DirectSale>
}
}
}
DirectSale "1" --> "ID 1" DirectSaleId : has

MemoDirectSaleRepo "1" --> "*" DirectSaleFactory : invokes
MemoDirectSaleRepo "1" --> "*" DirectSale : persists

DirectSale "*" ..> "1" Price : references
DirectSale "*" ..> "1" Period : references
DirectSale "*" o--  "1..*" ItemId : aggregates
DirectSale "*" ..> "1..*" AuthorId : references
DirectSale "*" ..> "1..*" GenreId : references
DirectSale "*" ..> "1..*" PublicationId : references
DirectSale "*" ..> "1..*" PublishingCompanyId : references

' ===== Factory =====
DirectSaleFactory ..> DirectSale : <<create>>


' ===== Repository =====


IDirectSaleRepo <|.. MemoDirectSaleRepo

@enduml