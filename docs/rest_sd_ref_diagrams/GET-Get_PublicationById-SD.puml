@startuml
title title GET - Get Publication by ID - SD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

participant ":Publication\nRestController" as REST
participant ":PublicationService" as Service
participant ":IPublicationRepo" as REPO
participant ":IAuthorRepo" as AuthorRepo
participant ":IGenreRepo" as GenreRepo
participant ":Publication\nResponseDTOMapper" as Mapper
database DB

activate REST
REST -> Service : getPublicationById(id)

activate Service

create PublicationId
Service --> PublicationId : PublicationId = new PublicationId(id)
Service -> REPO : ofIdentity(publicationId)

activate REPO
REPO -> DB : publication = findById(publicationId)
REPO --> Service : publication
deactivate REPO

Service -> AuthorRepo : ofIdentity(publication.getAuthorId())

activate AuthorRepo
AuthorRepo --> Service : author
deactivate AuthorRepo

Service -> GenreRepo : ofIdentity(publication.getGenreId())
activate GenreRepo
GenreRepo --> Service : genre
deactivate GenreRepo

Service -> Mapper : toResponseDTO(publication, author, genre)
activate Mapper
Mapper --> Service : publicationDTO
deactivate Mapper

Service --> REST : publicationDTO
deactivate Service

REST -> REST : publication.add(selfLink)

REST --> REST : ResponseEntity.ok(publicationDTO)

ref over REST
[[../a.puml Back to Main Diagram]]
end

@enduml