@startuml

'==== Title ====
title MiteLovers – DDD - Granularity 3
top to bottom direction

'==== basic style ====

skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura-Bold
skinparam objectFontSize 14
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ArrowFontSize 14
skinparam PackageBorderColor #4B9DA9

'--- Aggregate Roots ---'

Package "DOMAIN" {

    together {
        Package "USER" <<Folder>> #b0c4d4 {

            object User <<AggregateRoot>>

        }
        Package "CITY" <<Folder>> #b0c4d4 {

            object City <<AggregateRoot>>

        }
        Package "COUNTRY" <<Folder>> #b0c4d4 {

            object Country <<AggregateRoot>>

        }

        '== Value Objects (Ids) ==
        object UserId <<ValueObject>> #LightPink
        object CityId <<ValueObject>> #LightPink
        object CountryId <<ValueObject>> #LightPink

        '== Value Objects (other) ==
        object Address <<ValueObject>> #FFE6EE
    }

    together {
        Package "EDITION" <<Folder>> #b0c4d4 {

            object Edition <<AggregateRoot>>

        }

        Package "PUBLISHINGCOMPANY" <<Folder>> #b0c4d4 {

            object PublishingCompany <<Aggregate Root>>

        }

        '== Value Object (Id) ==
        interface EditionId <<ValueObject>> #LightPink
        object PublishingCompanyId <<ValueObject>> #LightPink

        '=== Value Objects (other) ===

        object ISBN <<ValueObject>> #FFE6EE
        object ISSN <<ValueObject>> #FFE6EE
        object NoIdentifier <<ValueObject>> #FFE6EE

    }

    together {
        Package "PUBLICATION" <<Folder>> #b0c4d4 {

            object Publication <<Aggregate Root>>

        }

        Package "AUTHOR" <<Folder>> #b0c4d4 {

            object Author <<Aggregate Root>>

        }

        '== Value Objects (Ids) ==
        object AuthorId <<ValueObject>> #LightPink
        object PublicationId <<ValueObject>> #LightPink

    }

    together{
        Package "PUBLICATIONTYPE" <<Folder>> #b0c4d4 {

            object PublicationType <<Aggregate Root>>

        }

        Package "GENRE" <<Folder>> #b0c4d4 {

            object Genre <<Aggregate Root>>

        }

        Package "APPRAISALENTITY" <<Folder>> #b0c4d4 {

            object AppraisalEntity <<Aggregate Root>>

        }

        '== Value Objects (Ids) ==
        object AppraisalEntityId <<ValueObject>> #LightPink
        object GenreId <<ValueObject>> #LightPink
        object PublicationTypeId <<ValueObject>> #LightPink

    }

'=== B4 responsibilities ==

    /'Package "LIBRARY" <<Folder>> #b0c4d4 {

        object Library <<AggregateRoot>>

    }

    Package "LISTOFITEMS" <<Folder>> #b0c4d4 {

        object ListOfItems <<AggregateRoot>>

    }

    Package "ITEM" <<Folder>> #b0c4d4 {

        object Item <<AggregateRoot>>

    }

    Package "LISTING" <<Folder>> #b0c4d4 {

        object Listing <<Aggregate Root>>

    }

    Package "DIRECTSALE" <<Folder>> #b0c4d4 {

        object DirectSale <<Aggregate Root>>

    }

    Package "AUCTION" <<Folder>> #b0c4d4 {

        object Auction <<Aggregate Root>>
        object Bid <<Entity>>

    }'/

}

'=== Correlations ==='

'--- Edition ---'
Edition "*" --> "1" PublishingCompanyId : has
Edition "*" -> "1" PublicationId : has
Edition "1" --> "1" EditionId : has
ISBN ..|> EditionId
ISSN ..|> EditionId
NoIdentifier ..|> EditionId

'--- User ---'
'User "1" --- "1" Library
'User "1" --- "*" Bid
'User "1" --- "*" Listing
User "1" --> "1" UserId : has
User "1" --> "1" Address : has

'--- Publication ---'
Publication "*" --> "*" AuthorId : has
Publication "*" --> "1" PublicationTypeId : has
Publication "*" --> "1..*" GenreId : has
Publication "1" --> "1" PublicationId : has

'--- PublicationType ---'
PublicationType "1" --> "1" PublicationTypeId : has

'--- PublishingCompany ---'
PublishingCompany "1" --> "1" PublishingCompanyId : has

'--- Author ---'
Author "1" --> "1" AuthorId : has

'--- Genre ---'
Genre "1" --> "1" GenreId : has

'--- AppraisalEntity ---'
AppraisalEntity "*" ---> "1..*" PublicationTypeId : has
AppraisalEntity "*" ---> "1..*" GenreId : has
AppraisalEntity "1" --> "1" AppraisalEntityId : has

'--- City ---'
City "1" ---> "1" CityId : has
City "1" ---> "1" CountryId : has

'--- Country ---'
Country "1" --> "1" CountryId

'--- Address ---'
Address "*" --> "1" CityId : has



'=== B4 responsibilities ==

'--- Item ---'
'Item "*" --- "1" Library
'Item "1" -------- "1" Listing
'Item "*" --- "*" ListOfItems
'Item "1..*" --> "1" EditionId : has

'--- ListOfItems ---'
'ListOfItems "*" --- "1" User
'ListOfItems "*" --- "1" Genre


'--- Listing ---'
'Listing "1" --- "0..1" Auction
'Listing "1" --- "0..1" DirectSale
'Auction "1" --- "*" Bid


@enduml