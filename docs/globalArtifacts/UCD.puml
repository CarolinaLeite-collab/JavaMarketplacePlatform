@startuml
'==== Title ====
title MiteLovers – UCD
left to right direction

'==== basic style ====

'hides unwanted text
hide stereotype

skinparam monochrome false

skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

'undefined objects
skinparam object {
  BackgroundColor<<highlight>> 91C6BCAA
  BorderColor<<highlight>> 4B9DA9AA
  FontColor<<highlight>> 547792AA
}
skinparam shadowing<<highlight>> false


'==== entities ====
actor Buyer
actor User
actor Administrator

'==== Administrator ====

usecase "UC001: To register a user in the system" as UC1
usecase "UC002: To add a publication type to the official type list, so that new publications can be of this type" as UC2
usecase "UC003: To add a publication genre to the official genre list, so that new publications can be of this genre" as UC3
usecase "UC004: To register an Appraisal Entity, including the list of genres and publication types it can appraisal" as UC4
usecase "UC005: To register an Author in the system, so that publications of that author can be added" as UC5
usecase "UC006: To register a Publishing Company in the system, so that publications of that company can be added" as UC6
usecase "UC007: To register a new country in the system" as UC7
usecase "UC008: To register a new city in the system. A city must be in a country." as UC8


'==== User  ====

usecase "UC009: To create my library" as UC9
usecase "UC010: To register a new publication in the system" as UC10
usecase "UC011: To add a publication to my library" as UC11
usecase "UC012: To get the list (title, author, type and ISBN/SSN) of publications in my library" as UC12
usecase "UC013: To get the list of official genres" as UC13
usecase "UC014: To get the list of official publication types" as UC14
usecase "UC015: To put for sale a publication in my library in a direct sale" as UC15
usecase "UC016: To put for sale a publication in my library in an auction" as UC16
usecase "UC017: To create a private list of my publications, give it a name and a set a genre" as UC17
usecase "UC018: To add one of my publications to a list of mine" as UC18
usecase "UC019: To publicly share a list of mine" as UC19
usecase "UC020: To get a list (name and user) of the publicly published lists of a given genre" as UC20


'==== Buyer  ====

usecase "UC021: To get the list of items on direct sale of a given genre" as UC21
usecase "UC022: To get the list of items on auction of a given genre" as UC22
usecase "UC023: To get the list of items on direct sale of a given publication" as UC23
usecase "UC024: To get the list of items on auction of a given publication" as UC24
usecase "UC025: To get the list of items on direct sale of a given author" as UC25
usecase "UC026: To get the list of items on auction of a given author" as UC26
usecase "UC027: To get the list of items on direct sale of a given publisher" as UC27
usecase "UC028: To get the list of items on auction of a given publisher" as UC28

Administrator -- UC1
Administrator -- UC2
Administrator -- UC3
Administrator -- UC4
Administrator -- UC5
Administrator -- UC6
Administrator -- UC7
Administrator -- UC8

User -- UC9
User -- UC10
User -- UC11
User -- UC12
User -- UC13
User -- UC14
User -- UC15
User -- UC16
User -- UC17
User -- UC18
User -- UC19
User -- UC20

Buyer -- UC21
Buyer -- UC22
Buyer -- UC23
Buyer -- UC24
Buyer -- UC25
Buyer -- UC26
Buyer -- UC27
Buyer -- UC28

@enduml
