@startuml
'==== Title ====
title "As a User, I want to add one of my publications to a list of mine." - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
actor User
participant ":Client" as CLI
participant ":Server" as SER
database ":DataBase" as DB

User -> CLI : Add one of my publications \nto a list of mine
activate CLI
CLI -> SER : GET /my-lists {...}
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
CLI --> User : Show user's lists
deactivate CLI

User -> CLI : Select the receiving list
activate CLI
CLI -> SER : GET /my-lists/{listId}
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
CLI --> User : Show the chosen list
deactivate CLI

User -> CLI : Press add item button
activate CLI
CLI -> SER : GET /my-library/items
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
CLI --> User : Show items in user's library
deactivate CLI

User -> CLI : Select item
activate CLI
CLI -> SER : POST /my-lists/{listId}/items/{itemId}
activate SER
SER -> DB : insert
DB --> SER : data
SER --> CLI : HTTP STATUS 201 {...}
deactivate SER

CLI -> SER : GET /my-lists/{listId}
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
CLI --> User : Item added successfully.
deactivate CLI

@enduml
