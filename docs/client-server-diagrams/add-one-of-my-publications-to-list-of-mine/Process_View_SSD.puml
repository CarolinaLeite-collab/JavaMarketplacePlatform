@startuml
'==== basic style ====
hide stereotype
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox

autonumber

title "As a User, I want to add one of my publications to a list of mine." - SSD

' --- Actor and participants ---

actor User
participant ":Mitelovers" as mite



User -> mite : Add one of my publications to a list of mine
activate mite
mite --> User : Show user's lists
deactivate mite

User -> mite : Select the receiving list
activate mite
mite --> User : Show the chosen list
deactivate mite

User -> mite : Press add item button
activate mite
mite --> User : Show items in user's library
deactivate mite

User -> mite : Select item
activate mite
mite --> User : Item added successfully.
deactivate mite

@enduml