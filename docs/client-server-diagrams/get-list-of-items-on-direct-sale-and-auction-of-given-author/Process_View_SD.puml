@startuml
'==== Title ====
title "As a Buyer, I want to use the Web UI to list of items on sale of a given author %n()(direct sales and auctions)." %n() SD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
actor "Buyer"
participant ":Frontend" as Client
participant ":Backend" as Server
participant ":Database" as db

Buyer -> Client : Selects an author from the Web UI
activate Client
Client -> Server : GET /direct-sales
activate Server
Server -> db : FETCH
db --> Server : DATA
Server --> Client : 200 OK + DirectSaleResponseDTO + direct-sales link
deactivate Server

Client -> Server : GET /auctions
activate Server
Server -> db : FETCH
db --> Server : DATA
Server --> Client : 200 OK + AuctionResponseDTO + auctions links
deactivate Server

Client -> Server : GET /items/{itemId}
activate Server
note right of Client
For each unique itemId
from direct sales and auctions
end note
Server -> db : FETCH
db --> Server : DATA
Server --> Client : 200 OK + ItemResponseDTO + item link
deactivate Server

note over Client
Filters results where
item.authorName matches
the selected author
end note

deactivate Server
Client --> Buyer : Displays direct sales and %n()auctions of the selected author
deactivate Client

@enduml