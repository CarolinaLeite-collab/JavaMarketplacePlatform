@startuml
'==== Title ====
title "As a Buyer, I want to use the Web UI to bid on an auction." - SD %n()

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
actor Buyer
participant ":Frontend" as FE
participant ":Backend" as BE

note over FE
Assumes the buyer already opened an Auction
via GET /auctions/{auctionId}, whose response
includes a "bids" link pointing to
/auctions/{auctionId}/bids.

That href is what Frontend follows below, not a
hardcoded URL.
end note

Buyer -> FE : I want to place a bid on an auction.
activate FE

FE -> BE : OPTIONS {bids href}
activate BE

ref over BE
[[rest-sd-ref-diagrams/OPTIONS_Place_Bid_SD.puml OPTIONS for buyer on /auctions/{auctionId}/bids]]
end ref

BE --> FE : 200 OK + Allow: [GET, POST]

deactivate BE

FE -> BE : POST {bids href} + %n(){placeBidRequestDTO}
activate BE

ref over BE
[[rest-sd-ref-diagrams/POST_Place_Bid_SD.puml POST new bid on /auctions/{auctionId}/bids]]
end ref

BE --> FE : 201 Created + bidResponseDTO %n() + auction link + bids link
deactivate BE
FE --> Buyer : Bid successfully placed on auction.
deactivate FE

@enduml