@startuml

'==== Title ====
title "As a Buyer, I want to use the Web UI to place a bid on an auction." - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

actor Buyer as USER
participant ":Frontend" as FRONTEND
participant ":Backend" as rest
participant ":Database" as DB

note over FRONTEND
  Assumes the Buyer already opened an Auction via
  GET /auctions/{auctionId}, whose response included a
  "bids" link pointing to /auctions/{auctionId}/bids.
  That href is what frontend follows below, not a hardcoded URL.
end note

USER -> FRONTEND : I want to place a bid on this auction with a value of x.
activate FRONTEND

note over FRONTEND
Currency is predetermined
by the currency of the auction
end note

FRONTEND -> rest : POST {bids href}\n{placeBidRequestDTO}
activate rest

rest -> DB : INSERT
activate DB
DB --> rest : DATA
deactivate DB

rest --> FRONTEND : 201 Created + bidResponseDTO %n() + auction link + bids link
deactivate rest

FRONTEND --> USER : Bid successfully placed on auction.
deactivate FRONTEND

@enduml