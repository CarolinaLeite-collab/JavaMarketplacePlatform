@startuml
'==== basic style ====
hide stereotype
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox

autonumber

title "As a User, I want to get the list (title, author, type and ISBN/SSN) \nof publications in my library - SSD"

' --- Actor and participants ---

actor User
participant ":Mitelovers" as mite


User -> mite : I want to access "My Library"
activate mite
mite --> User : Items of your library
deactivate mite

User -> mite : I want to see the \ndetails of the Item
activate mite
mite --> User : here is the details!
deactivate mite

@enduml