@startuml
title GET user's library sorted by criterion %n()ref SD

skinparam backgroundColor CornSilk
skinparam noteBackgroundColor #FFFFE0
skinparam shadowing false
skinparam defaultFontName Futura
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

participant "Router" as router
participant ":LibraryRestController" as REST
participant ":LibrarySortRequestMapper" as SortMapper
participant ":LibraryService" as Service
participant ":ILibraryRepo" as LibraryRepo
participant ":IItemRepo" as ItemRepo
participant ":IEditionRepo" as EditionRepo
participant ":IPublicationRepo" as PublicationRepo
participant ":IPublicationTypeRepo" as PublicationTypeRepo
participant ":IAuthorRepo" as AuthorRepo
participant ":LibraryItemResponseDTOMapper" as DTOMapper
participant ":LibraryLinkProvider" as LinkProvider

[o-> router : GET {library href expanded with sort={sort}}\nX-User-Id: {email}
activate router

router -> REST : getMyLibrary(userIdFromHeader, sortCriterion)
activate REST

create "email2:Email" as Email2
REST -->> Email2 : new Email(userIdFromHeader)

create "userId2:UserId" as UserId2
REST -->> UserId2 : new UserId(email2)

REST -> SortMapper : toDomain(sortCriterion)
activate SortMapper
SortMapper -> SortMapper : map API sort criterion\nto LibrarySort

alt sortCriterion = "title"
    SortMapper --> REST : LibrarySort.TITLE
else sortCriterion = "author"
    SortMapper --> REST : LibrarySort.AUTHOR
else sortCriterion = "type"
    SortMapper --> REST : LibrarySort.PUBLICATION_TYPE
else sortCriterion = "identifier" / "isbn" / "issn"
    SortMapper --> REST : LibrarySort.IDENTIFIER
else missing or unsupported
    SortMapper --> REST : LibrarySort.NONE
end
deactivate SortMapper

REST -> Service : getListOfItemInfoInMyLibrary(\nuserId, librarySort)
activate Service

Service -> Service : LibraryId.fromUserId(userId)

Service -> LibraryRepo : ofIdentity(libraryId)
activate LibraryRepo
LibraryRepo ->o] : FETCH
LibraryRepo <--o] : DATA
LibraryRepo --> Service : Optional<Library>
deactivate LibraryRepo

alt library does not exist or is empty
    Service --> REST : empty List<LibraryItemDetails>
else library contains items
    Service -> Service : library.getItemsIdInLibrary()

    loop for each itemId
        Service -> ItemRepo : ofIdentity(itemId)
        activate ItemRepo
        ItemRepo ->o] : FETCH
        ItemRepo <--o] : DATA
        ItemRepo --> Service : item
        deactivate ItemRepo

        Service -> EditionRepo : ofIdentity(item.editionId)
        activate EditionRepo
        EditionRepo ->o] : FETCH
        EditionRepo <--o] : DATA
        EditionRepo --> Service : edition
        deactivate EditionRepo

        Service -> PublicationRepo : ofIdentity(edition.publicationId)
        activate PublicationRepo
        PublicationRepo ->o] : FETCH
        PublicationRepo <--o] : DATA
        PublicationRepo --> Service : publication
        deactivate PublicationRepo

        Service -> AuthorRepo : ofIdentity(publication.authorId)
        activate AuthorRepo
        AuthorRepo ->o] : FETCH
        AuthorRepo <--o] : DATA
        AuthorRepo --> Service : author
        deactivate AuthorRepo

        Service -> PublicationTypeRepo : ofIdentity(edition.publicationTypeId)
        activate PublicationTypeRepo
        PublicationTypeRepo ->o] : FETCH
        PublicationTypeRepo <--o] : DATA
        PublicationTypeRepo --> Service : publicationType
        deactivate PublicationTypeRepo
    end

    alt LibrarySort.TITLE
        Service -> Service : sort by title\nascending, case-insensitive
    else LibrarySort.AUTHOR
        Service -> Service : sort by authorName\nascending, case-insensitive
    else LibrarySort.PUBLICATION_TYPE
        Service -> Service : sort by publicationType\nascending, case-insensitive
    else LibrarySort.IDENTIFIER
        Service -> Service : sort by identifier\nascending, case-insensitive
    else LibrarySort.NONE
        Service -> Service : preserve original order
    end

    Service --> REST : List<LibraryItemDetails>
end

deactivate Service

loop for each LibraryItemDetails
    REST -> DTOMapper : toDTO(item, publication, edition,\nauthor, publicationType)
    activate DTOMapper
    DTOMapper --> REST : LibraryItemResponseDTO
    deactivate DTOMapper
end
loop for each DTO
    REST -> REST : add item self link
end

REST -> REST : create CollectionModel<LibraryItemResponseDTO>\nwith self link

REST -> LinkProvider : getSortLink()
activate LinkProvider
LinkProvider -> LinkProvider : create sort link\nwith rel "sort"
LinkProvider --> REST : sortLink
deactivate LinkProvider
REST -> REST : add(sortLink)

create "response:ResponseEntity<CollectionModel<LibraryItemResponseDTO>>" as response
REST -->> response : build ResponseEntity\nstatus = 200 OK,\nbody = collectionModel

REST --> router : response
deactivate REST

[o<-- router : 200 OK + sorted LibraryItemResponseDTO list %n()+ links
deactivate router

ref over router
Process_View_Level_SD_3.puml]
end ref

@enduml