@startuml
'==== Title ====
title "As a User, I want to use a Web UI to create a private list of my publications, \n give it a name, set a genre and, eventually, share it." - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
participant ":Client" as CLI
participant ":Server" as SER
database "DB" as DB

CLI -> SER : GET /user-area/my-lists {...}
activate CLI
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
deactivate CLI

CLI -> SER : GET /genres/ {...}
activate CLI
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
deactivate CLI

CLI -> SER : POST /user-area/my-lists/ {...}
activate CLI
activate SER
SER -> DB : insert
DB --> SER : data
SER --> CLI : HTTP STATUS 201 {...}
deactivate SER
deactivate CLI

CLI -> SER : GET /user-area/my-lists {...}
activate CLI
activate SER
SER -> DB : select
DB --> SER : data
SER --> CLI : HTTP STATUS 200 {...}
deactivate SER
deactivate CLI

@enduml