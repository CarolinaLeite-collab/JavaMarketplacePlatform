@startuml

'==== Title ====
title "As a User, I want to use a Web Ul to buy an item in a direct sale." - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
participant ":apiClient" as FRONTEND
participant ":Server" as SERVER
participant ":Database" as DB

note over FRONTEND
  Assumes the client already opened a DirectSale via
  GET /direct-sales/{id}, whose response included an
  "add-to-cart" link pointing to /shoppingCarts/shoppingCartLines.
  That href is what FRONTEND follows below, not a hardcoded URL.
end note

 [-> FRONTEND : I want to add a Direct Sale to my Shopping Cart
activate FRONTEND

FRONTEND -> SERVER : OPTIONS {shopping-cart href}
activate SERVER

SERVER --> FRONTEND : 200 OK + [GET, POST]
deactivate SERVER

FRONTEND -> SERVER : POST {... + shopping-cart href}
activate SERVER

SERVER -> DB : select
activate DB
DB -> SERVER : data
deactivate DB

SERVER --> FRONTEND : 201 Created + self link (shoppingCart) \n+ self link (shoppingCartLine)
deactivate SERVER

FRONTEND ->x[ : Direct Sale successfully added to cart!
deactivate FRONTEND

[-> FRONTEND : I want to access my Shopping Cart
activate FRONTEND

FRONTEND -> SERVER : OPTIONS {shopping-cart self link}
activate SERVER

SERVER --> FRONTEND : 200 OK + [GET, PATCH]
deactivate SERVER

FRONTEND -> SERVER : GET {shopping-cart self link}
activate SERVER

SERVER -> DB : select
activate DB
DB -> SERVER : data
deactivate DB

SERVER --> FRONTEND : 200 OK + self link (shopping-cart) \n+ {...} + links to each shopping-cart-line \n+ sales link (if shopping-cart-lines is not empty)
deactivate SERVER

loop for each shoppingCartLine href received above

FRONTEND -> SERVER : OPTIONS {shopping-cart-line href}
activate SERVER

SERVER --> FRONTEND : 200 OK + [GET, DELETE]
deactivate SERVER

FRONTEND -> SERVER : GET {shoppingCartLine href}
activate SERVER

SERVER -> DB : select
activate DB
DB -> SERVER : data
deactivate DB

SERVER --> FRONTEND : 200 OK + {...} + self link +\n + direct-sale link
deactivate SERVER

FRONTEND -> SERVER : OPTIONS {direct-sale href}
activate SERVER

SERVER --> FRONTEND : 200 OK + [GET]
deactivate SERVER

FRONTEND -> SERVER : GET {direct-sale href}
activate SERVER

SERVER -> DB : select
activate DB
DB -> SERVER : data
deactivate DB

SERVER --> FRONTEND : 200 OK + {...} + self link \n+ links to each item
deactivate SERVER

end loop

FRONTEND ->x[ : Shopping Cart displayed!
deactivate FRONTEND

[-> FRONTEND : I want to checkout my ShoppingCart
activate FRONTEND

FRONTEND -> SERVER : OPTIONS {sales link}
activate SERVER

SERVER --> FRONTEND : 200 OK + [GET, POST]
deactivate SERVER

FRONTEND -> SERVER : POST {... + sales link}
activate SERVER

SERVER -> DB : select
activate DB
DB -> SERVER : data
deactivate DB

SERVER --> FRONTEND : 201 Created + self link (sale)
deactivate SERVER

FRONTEND ->x[ : Purchase completed!
deactivate FRONTEND

@enduml