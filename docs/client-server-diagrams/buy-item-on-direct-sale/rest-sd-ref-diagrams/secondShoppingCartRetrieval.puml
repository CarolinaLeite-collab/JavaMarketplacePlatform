@startuml
title createSaleFromCart — second shopping cart retrieval (ref SD)

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

participant ":SaleService" as Service
participant ":ShoppingCartService" as CartService

activate Service

Service -> CartService : findCartByCartId(shoppingCartId)
activate CartService

ref over CartService
[[./shoppingCartFetch.puml Shopping Cart Fetching]]
end ref

CartService --> Service : cart
deactivate CartService

ref over Service
[[./POST_sale.puml Back to main diagram]]
end ref

@enduml