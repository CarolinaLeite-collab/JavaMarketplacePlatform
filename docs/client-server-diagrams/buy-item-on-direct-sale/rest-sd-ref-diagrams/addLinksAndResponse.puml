@startuml
title createSaleFromCart — add links and response (ref SD)

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

participant ":SaleRestController" as REST
participant ":SaleLinkProvider" as Link

activate REST

create "model:RepresentationModel" as Model
REST -->> Model : new RepresentationModel<>()

REST -> Link : addLinksForCreatedSale(%n()model, user.identity(), returnedNewSale.get_saleId())
activate Link
deactivate Link
note right of Link
  Adds self link pointing to
  GET /sales/{saleId}
end note

create "response:ResponseEntity" as Response
REST -->> Response : new ResponseEntity<>(model, 201 Created)

ref over REST
[[./POST_sale.puml Back to main diagram]]
end ref

@enduml