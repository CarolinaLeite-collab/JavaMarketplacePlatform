@startuml

'==== basic style ====
hide stereotype
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox

autonumber

title "As a User, I want to use a Web Ul to buy an item in a direct sale." - SSD

' --- Actor and participants ---

actor User
participant ":Mitelovers" as mite

User -> mite : I want to add a Direct Sale to my Shopping Cart
activate mite
mite --> User : Direct Sale successfully added to cart!
deactivate mite

User -> mite : I want to access my Shopping Cart
activate mite
mite --> User : Shopping Cart displayed!
deactivate mite

User -> mite : I want to checkout my ShoppingCart
activate mite
mite --> User : Purchase completed!
deactivate mite

@enduml