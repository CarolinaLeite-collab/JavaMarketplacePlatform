@startuml
'==== Title ====
title "As a User, I want to use a Web UI to register a new publication\nin the system and add the publication to my library." - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
hidefootbox
autonumber

' ==== Actor and participants ====
actor User
participant ":Client" as CLI
participant ":Server" as SER
participant ":Database" as DB

User -> CLI : Register a new publication\nand add it to my library
activate CLI
CLI --> User : display publication form
deactivate CLI

User -> CLI : publication data
activate CLI
CLI -> SER : POST /publications {...}
activate SER

SER --> CLI : HTTP STATUS 200/201
deactivate SER
CLI --> User : display edition form
deactivate CLI

User -> CLI : edition data
activate CLI
CLI -> SER : POST /editions {...}
activate SER

ref over SER
[[rest-sf-ref-diagrams/POST_Register_Editions_SD.puml POST (create edition)]]
end ref

SER --> CLI : HTTP STATUS 200/201
deactivate SER
CLI --> User : display item form
deactivate CLI

User -> CLI : item data
activate CLI
CLI -> SER : POST /items {...}
activate SER

SER --> CLI : HTTP STATUS 201
deactivate SER

CLI --> User : Successful registration\nand item added to library
deactivate CLI

@enduml