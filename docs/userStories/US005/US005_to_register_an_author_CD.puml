@startuml
title US005 - Class Diagram (aligned with CreateAuthorController + AuthorRepository)

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam backgroundColor CornSilk
skinparam classBackgroundColor WhiteSmoke
skinparam classAttributeIconSize 0


class UICreateAuthor {
  +requestAuthorRegistration()
  +displayAuthorRegistrationForm()
  +submitAuthorName(authorName: String)
  +displayResult()
}

class CreateAuthorController {
  -authorRepo: AuthorRepo
  +CreateAuthorController(ar: AuthorRepo)
  +createAuthor(authorName: String): Author
}

note right of CreateAuthorController
Validates authorName (null/blank)
Trims before delegating to AuthorRepo
end note

class AuthorRepo {
  -authors: List<Author>
  +create(authorName: String): Author
  +existsByName(name: String): boolean
  +findAll(): List<Author>
}

class Author {
  -name: String
  +Author(authorName: String)
  +getName(): String
}

UICreateAuthor --> CreateAuthorController : uses
CreateAuthorController --> AuthorRepo : delegates to
AuthorRepo --> Author : creates/returns

@enduml