@startuml
title US005 - "As an Administrator, I want to register an Author in the system, \n so that publications of that Author can be added" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

actor Administrator as Admin
participant "MiteLovers" as System

Admin -> System: I want to register an Author
System --> Admin: Done!


deactivate System
@enduml