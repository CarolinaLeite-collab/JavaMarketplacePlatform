@startuml
title "US023 - As a Buyer, I want to get the list of items on \ndirect sale of a given publication - SSD"


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class UIGetDirectSaleItemsByPublication {

}

class GetDirectSaleItemsByPublicationsController {
    - _dsr : DirectSaleRepo
    + getDirectSaleItemsByPublication(publication : Publication) : List<Item>
}

class DirectSaleRepo {
    - _directSales : List<DirectSale>
    + getDirectSaleItemsByPublication(publication : Publication) : List<Item>
}

class DirectSale {
_item : Item
+ isByPublication(publication : Publication) : boolean
}

UIGetDirectSaleItemsByPublication "1" ..> "1" GetDirectSaleItemsByPublicationsController : uses
GetDirectSaleItemsByPublicationsController "1" ..> "1" DirectSaleRepo : uses
DirectSaleRepo "1" --> "*" DirectSale : manages

@enduml