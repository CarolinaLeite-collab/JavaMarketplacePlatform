@startuml
title "US023 - As a Buyer, I want to get the list of items on direct sale of a given publication" - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ActivationBackgroundColor WhiteSmoke


autonumber
autoactivate off

' --- Actor and participants ---
actor Buyer
participant ":UIGetDirectSaleItemsByPublications" as UI
participant ":GetDirectSaleItemsByPublicationsController" as Ctl
participant "_dsRepo:DirectSaleRepo" as dsr
participant "_ds:DirectSale" as ds

Buyer -> UI: I want to get a list of items on direct sale of a publication
activate UI
UI --> Buyer: Which publication?
deactivate UI

'publication object
Buyer -> UI: publication
activate UI
UI -> Ctl: getDirectSaleItemsByPublication(publication)
activate Ctl
Ctl -> dsr: getDirectSaleItemsByPublication(publication)
activate dsr
create "listOfDirectSaleItemsByPublication: List<Item>" as list

dsr -> list: create()
loop for each _ds in _dsRepo
        dsr -> ds: isByPublication(publication)
        opt isByPublication == true
            dsr -> list: add(_ds.getItem())
            activate list
            list --> dsr: true
            deactivate list
        end
end

create "copyOfListOfDirectSaleItemsByPublication: List<Item>" as copy
dsr -> copy: List.copyof(ListOfDirectSaleItemsByPublication)
dsr --> Ctl: copyOfListOfDirectSaleItemsByPublication
deactivate dsr
Ctl --> UI: copyOfListOfDirectSaleItemsByPublication
deactivate Ctl
UI --> Buyer: Items list of a publication on direct sale displayed
deactivate UI
@enduml