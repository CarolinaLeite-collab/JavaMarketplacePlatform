@startuml
title US006 – "As an Administrator, I want to register a %n()Publishing Company in the system" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant "Mitelovers" as System

' --- System dialog ---
User -> System: I want to register a publishing company.
activate "System"
System --> User: Name of the publishing company?
User -> System: New Publishing Co.
System --> User: Registered successfully!
deactivate "System"

@enduml