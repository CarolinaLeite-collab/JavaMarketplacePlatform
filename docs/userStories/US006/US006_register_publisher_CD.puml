@startuml
'https://plantuml.com/class-diagram
title US006 – "As an Administrator, I want to register a Publishing Company in the system" %n() CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class RegisterPublishingCompanyUI {
}

class RegisterPublishingCompanyController {
- _iPublishingCompanyRepo: IPublishingCompanyRepo
+ registerPublishingCompany(publishingCompanyName: String) : PublishingCompany
}

interface IPublishingCompanyRepo {
+ registerPublishingCompany(publishingCompanyName: String) : PublishingCompany
}

class MemoPublishingCompanyRepo {
- _publishingCompanies: List<PublishingCompany>
- _publishingCompanyFactory: PublishingCompanyFactory
+ registerPublishingCompany(name: String): PublishingCompany
}

class PublishingCompanyFactory {
+ createPublishingCompany(publishingCompanyName: String)
}

class PublishingCompany {
  - publishingCompanyName: String
  + PublishingCompany(publishingCompanyName: String)
}

RegisterPublishingCompanyUI "1" ..> "1" RegisterPublishingCompanyController: invokes
RegisterPublishingCompanyController "1" ..> "1" IPublishingCompanyRepo : uses
IPublishingCompanyRepo "1" ..|> "                           1" MemoPublishingCompanyRepo : calls
MemoPublishingCompanyRepo "1" --> "1" PublishingCompanyFactory : uses
PublishingCompanyFactory "1" --> "*" PublishingCompany : creates

@enduml