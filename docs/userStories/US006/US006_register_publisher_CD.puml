@startuml
'https://plantuml.com/class-diagram
title US006 – "As an Administrator, I want to register a Publishing Company in the system" %n() CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

class RegisterPublisherController {
  + registerPublisher(publisherName: String) : Publisher
}

class PublisherRepo {
  '+ registerPublisher(publisherName: String) : Publisher
  - publisherExists(publisherName: String) : boolean
  + createPublisher(publisherName: String) : Publisher
}

class Publisher {
  - publisherName: String
  + Publisher(publisherName: String)
  + getPublisherName(): String
}
' NOTE: getPublisherName() to be used in unit tests

RegisterPublisherController "1" --> "1" PublisherRepo : uses
PublisherRepo "1" --> "*" Publisher : creates

/'note right of RegisterPublisherController
  This registerPublisher() calls
  PublisherRepo's method of the
  same name
end note'/

/'note right of PublisherRepo
  This registerPublisher() orchestrates:
  publisherExists() → createPublisher() %n()→ new Publisher()
end note'/


@enduml