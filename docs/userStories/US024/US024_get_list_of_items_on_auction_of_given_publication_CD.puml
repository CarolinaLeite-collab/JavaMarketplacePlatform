@startuml
'https://plantuml.com/class-diagram
title US024 - "As a Buyer, I want to get the list of items on auction of a given publication" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam ArrowColor #57595BAA


class GetAuctionItemsByPublicationUI {

}

class GetAuctionItemsByPublicationController {

- _ar : AuctionRepo
+ getAuctionItemsByPublication(publicationName : Publication) : List<Item>
}

class AuctionRepo {
- _itemsOnAuction : List<Auction>
+getAuctionItemsByPublication(publicationName : Publication) : List<Item>

}

class Auction {

-_startingPrice : Price
-_outrightPrice : Price
-_finalPrice : Price
- _auctionStartDate : ZonedDateTime
-_auctionEndDate : ZonedDateTime
-_buyer : User
-_bids : Bids
+isByPublication(publication : Publication) : boolean

}

GetAuctionItemsByPublicationUI "1" ..> "1" GetAuctionItemsByPublicationController : invokes
GetAuctionItemsByPublicationController "1" ..> "1" AuctionRepo : calls
AuctionRepo "1" --> "*" Auction : contains

@enduml