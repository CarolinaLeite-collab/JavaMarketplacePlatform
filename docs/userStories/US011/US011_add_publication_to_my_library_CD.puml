@startuml
'https://plantuml.com/class-diagram
title US011 – "As a user, I want to add a publication to my library" - CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class AddPublicationOnLibraryUI

class AddPublicationOnLibrary {
    + getListOfAvailableItems(user : User) : List<Item>
    + addItemToLibrary(selectedItem : Item, user : User) : boolean
}

class ItemRepo {
    + getDifferentOf(existentItems : List<Item>) : List<Item>
}

class Library {
    - _items : List<Item>
    + getAllItems() : List<Item>
    + addItemToLibrary(selectedItem : Item) : boolean
    - copyList() : List<Item>
    - verifyUnique(selectedItem : Item) : boolean
}

class LibraryRepo {
     + getMyLibrary(user : User) : Library
}

class Item


AddPublicationOnLibraryUI "1" .. "1" AddPublicationOnLibrary : request >
AddPublicationOnLibrary "1" .. "1" ItemRepo : queries >
AddPublicationOnLibrary "1" .. "1" Library : addItemTo >
AddPublicationOnLibrary "1" .. "1" LibraryRepo : queries >
Library "1" -- "*" Item : stores >

@enduml