@startuml
title US002 - "As an administrator, I want to add a publication type to the official type list, %n() so that new publications can be of this type" - CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== UI =====
class AddPublicationTypeUI

' ===== ENTITY =====
class PublicationType {
  - _publicationTypeName : String
  PublicationType (publicationTypeName : String)
  + isSamePublicationType(publicationTypeName : String) : boolean
}

' ===== FACTORY =====

class PublicationTypeFactory {
  + createPublicationType(publicationTypeName : String) : PublicationType
}

' ===== INTERFACE =====
Interface IPublicationTypeRepo {
  + addPublicationType(publicationTypeName : String) : PublicationType
}

' ===== REPOSITORY =====
class MemoPublicationTypeRepo {
  + addPublicationType(publicationTypeName : String) : PublicationType
  - publicationTypeExists(publicationTypeName : String) : boolean
}

' ===== CONTROLLER =====
class AddPublicationTypeController {
  + addPublicationType(publicationTypeName : String) : PublicationType
}

' ===== RELATIONSHIPS =====
AddPublicationTypeUI "1" ..> "1" AddPublicationTypeController: invokes
AddPublicationTypeController "1" ..> "1" IPublicationTypeRepo: uses
MemoPublicationTypeRepo "1" ..|> "1" IPublicationTypeRepo: implements
MemoPublicationTypeRepo "1" --> "1" PublicationTypeFactory: uses
PublicationTypeFactory "1" --> "*" PublicationType: creates
MemoPublicationTypeRepo "1"--> "*" PublicationType: manages

@enduml
