@startuml
title US002 - Add Publication Type to Official List - CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== UI =====
class AddPublicationTypeUI

' ===== ENTITY =====
class PublicationType {
  - publicationTypeName : String
  + PublicationType (publicationTypeName : String)
  + isSamePublicationType(publicationTypeName : String) : boolean
}

' ===== FACTORY =====

class PublicationTypeFactory {
  createPublicationType(publicationTypeName : String) : PublicationType
}

' ===== REPOSITORY =====
class PublicationTypeRepo {
  + addPublicationType(publicationTypeName : String) : PublicationType
}

' ===== CONTROLLER =====
class AddPublicationTypeController {
'  - ptr : PublicationTypeRepo
'  + createPublicationTypeController(repo : PublicationTypeRepo)
  + addPublicationType(publicationTypeName : String) : PublicationType
}

' ===== RELATIONSHIPS =====
AddPublicationTypeUI "1" ..> "1" AddPublicationTypeController: invokes
AddPublicationTypeController "1" ..> "1" PublicationTypeRepo: calls
PublicationTypeRepo "1" --> "1" PublicationTypeFactory: uses
PublicationTypeFactory "1" --> "*" PublicationType: creates
PublicationTypeRepo "1"--> "*" PublicationType: manages

@enduml
