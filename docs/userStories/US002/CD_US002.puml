@startuml
title US002 - "As an administrator, I want to add a publication type to the official type list, %n() so that new publications can be of this type" - Class Diagram

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== ENTITY =====
class PublicationType {
  - typeName : String
  - bindingDescription : String

  + PublicationType(typeName : String, bindingDescription : String)
}

' ===== REPOSITORY =====
class PublicationTypeRepo {
  + publicationTypeExists(typeName : String) : boolean
  + addPublicationType(typeName : String, bindingDescription : String) : PublicationType
}

' ===== RELATIONSHIPS =====
PublicationTypeRepo --> PublicationType

@enduml