@startuml
'==== Title ====
title US008 - "As an Administrator, I want to register a new city in the system" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953

autonumber
autoactivate off

actor Administrator
participant "UI1:RegisterCity" as UI
participant "Ctl1:CityRegisterController" as Ctl

' -- User interaction --
Administrator -> UI: I want to register a city
activate UI

' -- UI triggers controller --
UI -> Ctl: registerCity(cityName, countryId)
activate Ctl

' -- Controller returns result to UI and user --
Ctl --> UI: success / error
deactivate Ctl
UI --> Administrator: confirmation / error message
deactivate UI

@enduml

