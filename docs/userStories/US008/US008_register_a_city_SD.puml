@startuml
title US008 - "As an Administrator, I want to register a new city in the system" - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off

actor Administrator as Adm
participant "UI1:RegisterCityUI" as UI
participant "Ctl1:CityRegisterController" as Ctl
participant "_cr:CountryRepo" as CountryRepo
participant "_cir:CityRepo" as CityRepo

' 1. Admin requests to register a new city
Adm -> UI: select "Register city"
activate UI

UI -> Ctl: getCountries()
activate Ctl
Ctl -> CountryRepo: getAllCountries()
activate CountryRepo
Ctl <-- CountryRepo: listOfCountries
deactivate CountryRepo
UI <-- Ctl: listOfCountries
deactivate Ctl

UI -> Adm: show form (city name, listOfCountries)
deactivate UI
Adm -> UI: select country; enter cityName
activate UI

' 3. UI submits city creation (passes selected country, already validated by list)
UI -> Ctl: registerCity(cityName, country)
activate Ctl

Ctl -> Ctl: validate inputs
Ctl -> CityRepo: existsByNameAndCountry(cityName, country)
CityRepo --> Ctl: boolean

' 5. Persist city when valid
Ctl -> CityRepo: save(new City(cityName, country))
activate CityRepo
create "c1:City" as c1
CityRepo -> c1: create(cityName, country)
activate c1
c1 --> CityRepo: new city
deactivate c1
CityRepo --> Ctl: c1
deactivate CityRepo

' 6. UI feedback (mirror US007: object then message)
Ctl --> UI: c1
deactivate Ctl
UI --> Adm: City registered successfully!
deactivate UI
@enduml
