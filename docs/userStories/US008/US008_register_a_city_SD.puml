@startuml
title US008 - "As an Administrator, I want to register a new city in the system" - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

autonumber
autoactivate off

actor Administrator as Adm
participant "UI1:RegisterCityUI" as UI
participant "Ctl1:CityRegisterController" as Ctl
participant "Ctl2:CountryRepo" as CountryRepo
participant "Ctl3:CityRepo" as CityRepo

' 1. Admin requests to register a new city
Adm -> UI: select "Register city"
activate UI

UI -> Adm: show form (city + country)
Adm -> UI: submit(cityName, countryId)

UI -> Ctl: registerCity(cityName, countryId)
activate Ctl

' 2. Controller validates country existence
Ctl -> CountryRepo: findById(countryId)
CountryRepo --> Ctl: country / null

Ctl -> Ctl: validate inputs
Ctl -> CityRepo: existsByNameAndCountry(cityName, country)
CityRepo --> Ctl: boolean
Ctl -> CityRepo: save(new City(cityName, country))
activate CityRepo
create "c1:City" as c1
CityRepo -> c1: create(cityName, country)
activate c1
c1 --> CityRepo: new city
deactivate c1
CityRepo --> Ctl: saved city
deactivate CityRepo
Ctl --> UI: success / error
deactivate Ctl
UI --> Adm: confirmation / error
@enduml
