@startuml
'==== Title ====
title US008 - "As an Administrator, I want to register a new city in the system" - CD
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

Class User {
- _name : Name
- _address : Address
- _email : Email
- _phone : Phone
}

Class Country {
- _countryName : String
- _admin : User
- _createdDate : LocalDate
+ create(String countryName, User admin, LocalDate createdDate) : Country
}

Class City {
- _name : String
- _country : Country
- _createdDate : LocalDate
+ create(String name, Country country, LocalDate createdDate) : City
}

Class CityRepository {
- _cities : List<City>
+ existsByNameAndCountry(name : String, country : Country) : boolean
+ save(city : City) : City
}

Class CityRegisterController {
+ registerCity(name : String, countryId : String) : City
}

'==== connections ====
User "1" -- "*" City: creates >
City "*" <-- "1" CityRepository: persists <
CityRepository "1" <-- "1" CityRegisterController: uses <
City "*" -- "1" Country: located in >

@enduml

