@startuml

title "US003 - As an Administrator, I want to add a publication genre to the official \ngenre list, so that new publications can be of this genre" - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam ActivationBackgroundColor WhiteSmoke
hidefootbox

autonumber

actor Administrator
participant "U1:UIAddGenre" as UI
participant "Ctl1:AddGenreController" as Ctl
participant "_gr:GenreRepo" as gr

Administrator -> UI: I want to add a publication genre
activate UI

UI --> Administrator: What is the genre name?
Administrator -> UI: genreName

UI -> Ctl: addGenre(genreName)
activate Ctl

Ctl -> gr: addGenre(genreName)
activate gr
gr --> gr: existsGenre(genreName)

create "genre:Genre"
gr -> "genre:Genre": add(genreName)
gr --> Ctl: genreAdded
deactivate gr

Ctl --> UI: genreAdded
deactivate Ctl

UI --> Administrator: genre added successfully to the \nofficial genre list!
deactivate UI

@enduml