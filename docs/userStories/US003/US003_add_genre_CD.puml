@startuml
title "US003 - As an Administrator, I want to add a publication genre to the official \ngenre list, so that new publications can be of this genre - CD"

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'==== Classes ====
class AddGenreUI {

}

class AddGenreController {
    - _genreRepo : GenreRepo
    - _admin : User
    + addGenre(genreName : String) : Genre
}

class GenreRepo {
    - _genresList : List<Genre>
    - _genreFactory : GenreFactory
    - genreExists(genreName : String) : boolean
    + addGenre(genreName : String) : Genre
}

class GenreFactory {
    + createGenre(genreName : String) : Genre
}

class Genre {
    - _genre : String
    + Genre(genre : String)
}

'==== Relationships ====
AddGenreUI "1" ..> "1" AddGenreController : uses
AddGenreController "1" --> "1" GenreRepo : uses
GenreRepo "1" --> "1" GenreFactory : uses
GenreRepo "1" --> "*" Genre : manages
GenreFactory "1" --> "*" Genre : creates

note right of AddGenreController
    Right now, User is simply
    required for Controller's
    constructor
endNote

@enduml