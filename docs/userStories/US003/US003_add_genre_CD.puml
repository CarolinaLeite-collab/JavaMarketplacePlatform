@startuml
title "US003 - As an Administrator, I want to add a publication genre to the official \ngenre list, so that new publications can be of this genre - CD"

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

'==== Classes ====
class UIAddGenre {

}

class AddGenreController {
    - _genre : GenreRepo
    + addGenre(genreName : String) : Genre
}

class GenreRepo {
    - _genres : List<Genre>
    - existsGenre(genreName : String) : boolean
    + create(genreName : String) : Genre
}

class Genre {
    - _genre : String
    + Genre(genre : String)
}

'==== Relationships ====
UIAddGenre "1" ..> "1" AddGenreController : uses
AddGenreController "1" ..> "1" GenreRepo : uses
GenreRepo "1" --> "*" Genre : manages

@enduml