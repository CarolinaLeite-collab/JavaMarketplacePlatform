@startuml

title US014 - "As a User, I want to get the list of official publication types" - CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam backgroundColor CornSilk
skinparam classBackgroundColor WhiteSmoke
skinparam classAttributeIconSize 0

class UIPublicationTypeList {
}

class GetPublicationTypeListController {
    - publicationTypeRepo : MemoPublicationTypeRepo
    + getListOfPublicationTypes() : List<PublicationType>
}

interface IPublicationTypeRepo {
+ getAll() : List<PublicationType>
}

class MemoPublicationTypeRepo {
    - publicationTypes : List<PublicationType>
}

UIPublicationTypeList "1" ..> "1" GetPublicationTypeListController : invokes
GetPublicationTypeListController "1" ..> "1" IPublicationTypeRepo : use
IPublicationTypeRepo "1" <|.. "1" MemoPublicationTypeRepo
@enduml
