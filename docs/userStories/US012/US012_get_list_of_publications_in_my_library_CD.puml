@startuml
'https://plantuml.com/class-diagram
title US012 – "As a User, I want to get the list (title, author, type \nand ISBN/ISSN) of publications in my library" - CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class UIgetListOfPublications {
}

class ListOfPublicationsInMyLibraryController {
    -_libraryRepo : LibraryRepo
    +ListOfPublicationsInMyLibraryController(libraryRepo: LibraryRepo)
    +getListOfPublications(userId: String) : List<PublicationDetails>
}

class LibraryRepo {
  -_libraries : List<Library>
      +create(userID: String) : Library
      +findByUser(userID: String) : Library
}

class Library {
  -_owner : String
  -publications : List<Publication>
      +getUserID() : String
      +getPublicationsInLibrary() : List<PublicationDetails>
}

class PublicationDetails{
-_title : Title
  -_author : Author
  -_publicationType : PublicationType
  -_isbn : ISBN
  -_issn : ISSN
}

UIgetListOfPublications "1"--> "1"ListOfPublicationsInMyLibraryController :uses
ListOfPublicationsInMyLibraryController "1"--> "1"LibraryRepo : uses
LibraryRepo "1" --> "*" Library : manages
Library "1" --> "*" PublicationDetails


@enduml