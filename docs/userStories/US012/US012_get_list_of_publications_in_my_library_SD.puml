@startuml
'==== basic style ====

'hides unwanted text
hide stereotype

skinparam monochrome false

skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
hidefootbox

'undefined objects
skinparam object {
  BackgroundColor<<highlight>> 91C6BCAA
  BorderColor<<highlight>> 4B9DA9AA
  FontColor<<highlight>> 547792AA
}
skinparam shadowing<<highlight>> false

autonumber

title US012 - "As a User, I want to get the list (title, author, type and ISBN/ISSN) of publications in my library" - SD


' --- Actor and participants ---'

actor User
participant "UI1: GetListOfPublicationsUI" as UI
participant "Ctl1:ListOfPublicationsInMyLibraryController" as Ctl
participant "_ilr:ILibraryRepo" as LibRepo
participant "library:Library" as Lib



User -> UI: Display List of my Publications
activate UI

UI -> Ctl: getListOfPublicationDetails(user)
activate Ctl

Ctl -> LibRepo: findByUser(user)
activate LibRepo
LibRepo --> Ctl: library
deactivate LibRepo

Ctl -> Lib: getPublicationDetails()

create "listWithDetails: List<PublicationsDetails>" as listOfPubs
activate Lib
Lib -->> listOfPubs: <<Create>>



loop for each item in library

create "pDetails:PublicationDetails" as list
    Lib -->> list: <<Create>>

    Lib -> listOfPubs: add(pDetails)
activate listOfPubs
listOfPubs --> Lib :true
end

deactivate listOfPubs
Lib --> Ctl: listWithDetails
deactivate Lib

Ctl --> UI: listWithDetails
deactivate Ctl

UI --> User: Publications list displayed\n with details
deactivate UI



@enduml