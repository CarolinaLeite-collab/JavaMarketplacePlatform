@startuml
'https://plantuml.com/class-diagram
title US004 – "As an administrator, I want to register a new Appraisal Entity, including the genres and publication types it can appraise" - CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class AddPublicationToListUI {
}

class AddPublicationToListController {
- _user : User
- _libraryRepo : LibraryRepo
- _listOfPublicationsRepo : ListOfPublicationsRepo
+ getMyLists(user : User)
+ getPublicationsInMyLibrary(user : User)
+ addPublicationToList(listOfPublications : ListOfPublications, publication : Publication) : ListOfPublications
}

class ListOfPublicationsRepo {
-_user : User
+ addPublicationToList(listOfPublications : ListOfPublications, publication : Publication) : ListOfPublications
}

class LibraryRepo {
- _user : User
- _library : Library
+ getPublicationsInMyLibrary(user : User) : List<Publication>
}

class Library {
-_publications : List<Publication>
+ getPublicationsInMyLibrary(user : User) : List<Publication>
}

class ListOfPublications{
- _publications : List<Publication>
+ addPublication(publication : Publication)
}

AddPublicationToListUI "1" ..> "1" AddPublicationToListController : uses
AddPublicationToListController "1" ..> "1" LibraryRepo : accesses
LibraryRepo "1" -> "*" Library : uses
AddPublicationToListController "1" ..> "1"ListOfPublicationsRepo : uses >
ListOfPublicationsRepo "1" --> "*" ListOfPublications : updates

@enduml