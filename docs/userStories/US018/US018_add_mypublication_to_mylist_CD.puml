@startuml
'https://plantuml.com/class-diagram
title US018 - "As a User, I want to add one of my publications to a list of mine" - CD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class AddPublicationToListUI {
}

class AddPublicationToListController {
- _user : User
- _libraryRepo : LibraryRepo
- _listOfPublicationsRepo : ListOfPublicationsRepo
+ getMyLists(user : User)
+ getItemsInMyLibrary(user : User)
+ addItemToList(user : User, listName : String, genre : Genre, item : Item)
}

interface IListOfPublicationsRepo {
+ getMyLists(user : User)
}

class MemoListOfPublicationsRepo{
+ getMyLists(user : User)
}

class Library {
-_items : List<Item>
+ getItemsInLibrary() : List<Item>
}

class ListOfPublications{
- _items : List<Item>
+ addItem(item : Item)
}

interface ILibraryRepo {
+ findLibraryByUser(user)
}

class MemoLibraryRepo {
+ findLibraryByUser(user)
}


AddPublicationToListUI "1" ..> "1" AddPublicationToListController : uses
AddPublicationToListController "1" ..> "1" IListOfPublicationsRepo : uses >
AddPublicationToListController "1" ..> "1" ILibraryRepo : uses >
IListOfPublicationsRepo "1" --> "*" ListOfPublications : updates
AddPublicationToListController "1" --> Library : request
IListOfPublicationsRepo <|.. MemoListOfPublicationsRepo
ILibraryRepo <|.. MemoLibraryRepo

@enduml