@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title US018 - As a User, I want to add one of my publications to a list of mine.

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

actor User
participant "UI1:AddPublicationToListUI" as UI
participant "Ctl1:AddPublicationToListController" as Ctl
participant "_lr:ListOfPublicationsRepo" as ListRepo
participant "_lr:LibraryRepo" as LibraryRepo
participant "myLibrary:Library" as myLibrary
participant "_lop:ListOfPublications" as ListOfPublications


User -> UI : I want to add one of my publications to one of my lists
activate UI
UI -> Ctl : getMyLists(user)
activate Ctl
Ctl -> ListRepo : getMyLists(user)
activate ListRepo
ListRepo --> Ctl : myLists
deactivate ListRepo
Ctl --> UI : myLists
deactivate Ctl
UI --> User : Select what list you want to add them to
deactivate UI

User -> UI : listOfPublications
activate UI
UI -> Ctl : getPublicationsInMyLibrary(user)
activate Ctl
Ctl -> LibraryRepo : getPublicationsInMyLibrary(user)
activate LibraryRepo
LibraryRepo -> myLibrary : getPublicationsInMyLibrary(user)
activate myLibrary
myLibrary --> LibraryRepo : publicationsInMyLibrary
deactivate myLibrary
LibraryRepo --> Ctl : publicationsInMyLibrary
deactivate LibraryRepo
Ctl --> UI : publicationsInMyLibrary
deactivate Ctl
UI --> User : Select what available publications you want to add
deactivate UI

User -> UI: publicationToAdd
activate UI
UI -> Ctl : addPublicationToList(listOfPublications, publicationToAdd)
activate Ctl
Ctl -> ListRepo : addPublicationToList(listOfPublications, publicationToAdd)
activate ListRepo
ListRepo -> ListOfPublications : addPublicationToList(listOfPublications, publicationToAdd)
activate ListOfPublications
ListOfPublications -> ListOfPublications : addPublication(publicationToAdd)
ListOfPublications --> ListRepo : true
deactivate ListOfPublications
ListRepo --> Ctl: true
deactivate ListRepo
Ctl --> UI : true
deactivate Ctl
UI --> User : Done!
deactivate UI



@enduml