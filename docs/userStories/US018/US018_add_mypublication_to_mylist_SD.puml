@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title US018 - "As a User, I want to add one of my publications to a list of mine" - SD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

actor User
participant "UI1:AddPublicationToListUI" as UI
participant "Ctl1:AddPublication\nToListController" as Ctl
participant "_lr:IListOfPublications\nRepo" as ListRepo
participant "_lr:ILibraryRepo" as LibraryRepo
participant "myLibrary:Library" as myLibrary
participant "_lop:ListOfPublications" as ListOfPublications


User -> UI : I want to add one of my publications to one of my lists
activate UI
UI -> Ctl : getMyLists(user)
activate Ctl
Ctl -> ListRepo : findListsByUser(user)
activate ListRepo
ListRepo --> Ctl : List<ListOfPublications>
deactivate ListRepo
Ctl --> UI : List<ListOfPublications>
deactivate Ctl
UI --> User : Select what list you want to add them to
deactivate UI

User -> UI : listOfItems
activate UI
UI -> Ctl : getItemsInMyLibrary(user)
activate Ctl
Ctl -> LibraryRepo : findLibraryByUser(user)
activate LibraryRepo
LibraryRepo -> Ctl : myLibrary
deactivate LibraryRepo
Ctl -> myLibrary : getItemsInLibrary()
activate myLibrary
myLibrary --> Ctl : List<Item>
deactivate myLibrary
Ctl --> UI : List<Item>
deactivate Ctl
UI --> User : Select what available Item you want to add
deactivate UI

User -> UI: itemToAdd
activate UI
UI -> Ctl : addItemToList(user, myList, genre, item)
activate Ctl
Ctl  -> ListOfPublications : addItemToList(user, myList, genre, item)
activate ListOfPublications
ListOfPublications -> ListOfPublications : addItem(item)
ListOfPublications --> Ctl: true
deactivate ListOfPublications
deactivate ListRepo
Ctl --> UI : true
deactivate Ctl
UI --> User : Done!
deactivate UI



@enduml