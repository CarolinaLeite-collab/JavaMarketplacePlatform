@startuml
title US001 - "As an Administrator, I want to register a user in the system" - CD

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class RegisterNewUserUI

class RegisterNewUserController {
  - _userRepo: UserRepo
  + registerNewUser(name: String, email: String): User
}

class UserRepo {
  - _users: List<User>
  + registerNewUser(name: String, email: String): User
  - userExists(email: String): boolean
}

class UserFactory {
  + createUser(name: Name, email: Email): User
}

class User {
  - _name: Name
  - _email: Email
}

class Name {
  - _name: String
}

class Email {
  - _email: String
}

' === RELAÇÕES ===

RegisterNewUserUI "1" ..> "1" RegisterNewUserController : invokes
RegisterNewUserController "1" ..> "1" UserRepo : calls
UserRepo "1" --> "1" UserFactory : uses
UserFactory "1" --> "*" User : instantiates
User "1" --> "1" Name : has
User "1" --> "1" Email : has

@enduml