@startuml
title US001 – "As an Administrator, I want to register a user in the system" %n() SD
hide footbox

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

actor "Admin" as Administrator
participant ":RegisterNewUserUI" as UI
participant ":RegisterNewUserController" as Ctl
participant ":UserRepo" as Repo
participant ":UserFactory" as Factory

Administrator -> "UI": I want to register a user in the system.
activate "UI"
"UI" --> Administrator: What is the name and the email?
Administrator -> "UI": name, email
"UI" -> "Ctl": registerNewUser(name, email)
activate "Ctl"
"Ctl" -> "Repo": registerNewUser(name, email)
activate "Repo"

opt userExists(email) == false
    create "newName:Name"
    "Repo" -> "newName:Name": create(name)

    create "newEmail:Email"
    "Repo" -> "newEmail:Email": create(email)

    "Repo" -> "Factory": createUser(newName, newEmail)
    activate "Factory"
    create "newUser:User"
    "Factory" -> "newUser:User": create(newName, newEmail)
    "Factory" --> "Repo": newUser
    deactivate "Factory"

    "Repo" -> "Repo": add(newUser)
end

"Repo" --> "Ctl": newUser
deactivate "Repo"
"Ctl" --> "UI": newUser
deactivate "Ctl"
"UI" --> Administrator: Registered successfully!
deactivate "UI"

@enduml