@startuml
title US020 - As a user, I want to get a list (name and user) \n of the publicly published lists of a given genre
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off


actor User as U
participant "UI:GetPublicListsByGenreControllerUI" as UI
participant "Ctl:GetPublicListsByGenreController" as C
participant ":IListOfPublicationsRepo" as R
participant ":ListOfPublications" as lop


U -> UI: I want to get a list (name and user) of the \npublicly published lists of a given genre
activate UI
UI --> U: What genre?
deactivate UI

U -> UI: Genre
activate UI

UI -> C: getPublicListsByGenre\n(Genre)
activate C

C -> R: findPublicListsByGenre\n(Genre)
activate R

create " publicLists : List <ListOfPublications>" as List
R -> List: <<create>>


loop for each _lop in _lopr
    R -> lop: isPrivate()
    activate lop
    R -> lop: getGenre()
    opt !isPrivate && getGenre(genre)==true

        R -> List : add
        activate List
        List --> R : true
        deactivate List

    end
end
deactivate lop



create "copyOfPublicLists: List<ListOfPublications> <<Create>>" as Copy
R -> Copy: List.copyOf(publicList)
R --> C: copyOfPublicLists
deactivate R

C --> UI: copyOfPublicLists
deactivate C

UI --> U: shows list (name, user)
deactivate UI

@enduml