@startuml
title US020 - Class Diagram (Get Public Lists by Genre)

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam backgroundColor CornSilk
skinparam classBackgroundColor WhiteSmoke
skinparam classAttributeIconSize 0

class UI {
  +requestPublicListsByGenre()
  +displayGenrePrompt()
  +selectGenre(genre: String)
  +displayPublicLists(lists: List<PublicList>)
}

class GetPublicListsByGenreController {
  -_repo: PublicListRepo
  +GetPublicListsByGenreController(repo: PublicListRepo)
  +getPublicListsByGenre(genre: String): List<PublicList>
}

class PublicListRepo {
  -_lists: List<PublicList>
  +add(list: PublicList)
  +findPublicListPublishedByGenre(genre: String): List<PublicList>
}

class PublicList {
  -_listName: String
  -_ownerUsername: String
  -_genre: String
  -_isPublic: boolean
  -_isPublished: boolean

  +PublicList(listName: String,
              ownerUsername: String,
              genre: String,
              isPublic: boolean,
              isPublished: boolean)

  +getListName(): String
  +getOwnerUsername(): String
  +getGenre(): String
  +isPublic(): boolean
  +isPublished(): boolean
}

UI --> GetPublicListsByGenreController : uses
GetPublicListsByGenreController --> PublicListRepo : delegates to
PublicListRepo --> PublicList : manages
UI ..> PublicList : displays (name, owner)

@enduml