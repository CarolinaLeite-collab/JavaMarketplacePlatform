@startuml
title US020 - As a user, I want to get a list (name and user) \n of the publicly published lists of a given genre

skinparam defaultFontName Futura
skinparam backgroundColor CornSilk
skinparam classBackgroundColor WhiteSmoke
skinparam classAttributeIconSize 0


class GetPublicListsByGenreUI {
}

class GetPublicListsByGenreController {

  +getPublicListsByGenre(genre: Genre): List<ListOfPublications>
}

class ListOfPublicationsRepo {
  +findPublicListsByGenre(genre: Genre): List<ListOfPublications>
}

class ListOfPublications {
  +getUser(): User
  +getName(): String
  +getGenre(): Genre
  +isPrivate(): boolean
}


GetPublicListsByGenreUI "1"..> "1" GetPublicListsByGenreController : invokes
GetPublicListsByGenreController "1" ..> "1" ListOfPublicationsRepo : calls
ListOfPublicationsRepo "1"--> "*"ListOfPublications : stores


@enduml