@startuml
title US020 - As a user, I want to get a list (name and user) \n of the publicly published lists of a given genre

skinparam defaultFontName Futura
skinparam backgroundColor CornSilk
skinparam classBackgroundColor WhiteSmoke
skinparam classAttributeIconSize 0


class GetPublicListsByGenreUI {
}

class GetPublicListsByGenreController {
  - _repo : IListOfPublicationsRepo
  +getPublicListsByGenre(genre: Genre): List<ListOfPublications>
}

interface IListOfPublicationsRepo {
  +findPublicListsByGenre(genre: Genre): List<ListOfPublications>
}

class MemoListOfPublicationsRepo {
  +findPublicListsByGenre(genre: Genre): List<ListOfPublications>
}

class ListOfPublications {
  +getUser(): User
  +getName(): String
  +getGenre(): Genre
  +isPrivate(): boolean
}


GetPublicListsByGenreUI "1"..> "1" GetPublicListsByGenreController : invokes
GetPublicListsByGenreController "1" ..> "1" IListOfPublicationsRepo : calls
IListOfPublicationsRepo "1"--> "*"ListOfPublications : stores
IListOfPublicationsRepo <|.. MemoListOfPublicationsRepo


@enduml