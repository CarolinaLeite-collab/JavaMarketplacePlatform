@startuml
title US021 – "As a Buyer, I want to get the list of items on direct sale of a given genre" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0


class GetDirectSaleItemsByGenreUI {
}

class GetDirectSaleItemsByGenreController {
  - _directSaleRepo : DirectSaleRepo
  +getDirectSaleItemsByGenre(genreName : Genre) : List<Item>
}

class DirectSaleRepo {
  +getDirectSaleItemsByGenre(genreName : Genre) : List<Item>
}

class DirectSale {
+ isByGenre(genreName : Genre) : boolean
}

GetDirectSaleItemsByGenreUI "1"..>"1" GetDirectSaleItemsByGenreController : invokes
GetDirectSaleItemsByGenreController "1"..>"1" DirectSaleRepo : calls
DirectSaleRepo "1" --> "*" DirectSale : acesses

@enduml
