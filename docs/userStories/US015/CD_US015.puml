@startuml
title Class Diagram - US015 -"As a User, I want to put for sale a publication %n() in my library in a direct sale"

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

' ===== ENUM =====
enum Condition {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

' ===== VALUE OBJECT =====
class Price {
  - _value : double
  - _currency : Currency

  + Price(value : double, currency : Currency)
  + getValue() : double
  + getCurrency() : Currency
}

class Currency {
  + getSymbol() : String
}

' ===== ENTITIES =====
class Publication {
  - publicationID : int
  - title : String
  - author : String
}

class Item {
  - itemID : int
  - publication : Publication
  - condition : Condition
  - directSale : DirectSale

  + Item(publication : Publication, condition : Condition)
  + setDirectSale(d : DirectSale)
}

class DirectSale {
  - price : Price
  - timeLimit : DateTime

  + DirectSale(price : Price, timeLimit : DateTime)
  + validateSaleConditions(condition : Condition)
}

' ===== REPOSITORIES =====
class PublicationRepo {
  + getPublication(publicationID : int) : Publication
}

class ItemRepo {
  + createItem(publication : Publication, condition : Condition) : Item
  + save(item : Item)
}

class LibraryRepo {
  + getPublicationsList(userID : int) : List<Publication>
}

' ===== RELATIONSHIPS =====
Item --> Condition
Item --> Publication
Item --> DirectSale
DirectSale --> Price
Price --> Currency

PublicationRepo --> Publication
ItemRepo --> Item
LibraryRepo --> Publication

@enduml