@startuml
title Class Diagram - US015 - "As a User, I want to put for sale a publication %n() in my library in a direct sale"

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class PublicationInLibraryForDirectSaleUI {
}

class PublicationInLibraryForDirectSaleController {
  - libraryRepo: LibraryRepo
  - directSaleRepo: DirectSaleRepo
  + getItemsInLibrary(user: User): List<Item>
  + addItemForDirectSale(item: Item, price: Price, timeLimit: Period): DirectSale
}

class LibraryRepo {
  - _libraries: List<Library>
  + findLibraryByUser(user: User): Library
}

class Library {
  - _owner: User
  - _items: List<Item>
  + getItemsInLibrary(): List<Item>
  + addItemToLibrary(item: Item): boolean
}

class Item {
  - publication: Publication
  - condition: Condition
  + getPublication(): Publication
  + getCondition(): Condition
  + setDirectSale(directSale: DirectSale): void
  + getDirectSale(): DirectSale
}

class DirectSaleRepo {
  - _directSales: List<DirectSale>
  - _factory: DirectSaleFactory
  + createDirectSale(item: Item, price: Price, timeLimit: Period): DirectSale
}

class DirectSaleFactory {
  + createDirectSale(item: Item, price: Price, timeLimit: Period): DirectSale
}

class DirectSale {
  - item: Item
  - price: Price
  - timeLimit: Period
  + DirectSale(item: Item, price: Price, timeLimit: Period)
  + getItem(): Item
  + getPrice(): Price
  + getTimeLimit(): Period
}

class User
class Publication

PublicationInLibraryForDirectSaleUI "1" ..> "1" PublicationInLibraryForDirectSaleController : invokes
PublicationInLibraryForDirectSaleController "1" ..> "1" LibraryRepo : calls
PublicationInLibraryForDirectSaleController "1" ..> "1" DirectSaleRepo : calls

LibraryRepo "1" --> "*" Library : uses
Library "1" --> "*" Item : contains

DirectSaleRepo "1" --> "1" DirectSaleFactory : uses
DirectSaleFactory "1" --> "*" DirectSale : instantiates

Item "1" --> "1" Publication : has
Item "1" --> "0..1" DirectSale : references
DirectSale "1" --> "1" Item : refers to
Library "1" --> "1" User : belongs to

@enduml