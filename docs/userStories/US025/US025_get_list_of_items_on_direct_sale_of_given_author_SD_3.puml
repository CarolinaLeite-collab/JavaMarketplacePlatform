@startuml
title US025 – "As a Buyer, I want to get the list of items on direct sale of a given author" - Level 4 SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor Buyer
participant ":GetDirectSaleItemsByAuthorUI" as UI
participant ":GetDirectSaleItemsByAuthorController" as CTL
participant "dsr:MemoDirectSaleRepo" as DSR
participant "directSale:DirectSale" as DS
participant "item:Item" as IT
participant "publication:Publication" as PUB



' --- Dialog ---
Buyer -> UI: I want the list of items on direct sale of a given author
activate UI
UI --> Buyer: What is the author's name?
deactivate UI
Buyer -> UI: authorName
activate UI
UI -> CTL: getDirectSaleItemsByAuthor(authorName)
activate CTL
CTL -> DSR: getDirectSaleItemsByAuthor(authorName)
activate DSR

create "listOfDirectSaleItemsByAuthor: List<Item>" as List
DSR -->> List: create()

loop for each directSale in dsr
    DSR -> DS: isByAuthor(authorName)
    activate DS
    DS -> IT: isByAuthor(authorName)
    activate IT
    IT -> PUB: isByAuthor(authorName)
    activate PUB
    PUB --> IT: true
    deactivate PUB
    IT --> DS: true
    deactivate IT
    DS --> DSR: true
    deactivate DS
    DSR -> List: add(directSale.getItem())
    activate List
    List --> DSR: true
    deactivate List
end



create "copyOfListOfDirectSaleItemsByAuthor: List<Item>" as Copy
DSR -> Copy: List.copyOf(listOfDirectSaleItemsByAuthor)

'participant "author:Author" as AUT


DSR --> CTL: copyOfListOfDirectSaleItemsByAuthor
deactivate DSR
CTL --> UI: copyOfListOfDirectSaleItemsByAuthor
deactivate CTL
UI --> Buyer: Here's the list! done!
deactivate UI

@enduml