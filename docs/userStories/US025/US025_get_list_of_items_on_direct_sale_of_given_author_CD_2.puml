skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class GetDirectSaleItemsByAuthorUI {

}

class GetDirectSaleItemsByAuthorController {

- _dsr : DirectSaleRepo
+ getDirectSaleItemsByAuthor(author: Author) : List<Item>
}

class DirectSaleRepo {

- _directSales : List<DirectSale>
+getDirectSaleItemsByAuthor(author: Author) : List<Item>

}

class DirectSale {

- item : Item
+isByAuthor(author: Author) : boolean
+getItem() : Item

}

class Item {

+getPublication() : Publication

}

class Publication {

+getAuthor() : Author

}

class Author {

}

GetDirectSaleItemsByAuthorUI "1" ..> "1" GetDirectSaleItemsByAuthorController : invokes
GetDirectSaleItemsByAuthorController "1" ..> "1" DirectSaleRepo : calls
DirectSaleRepo "1" --> "*" DirectSale : contains
DirectSale "1" --> "1" Item : contains
Item "1" --> "1" Publication : contains
Publication "1" --> "1" Author : contains

@enduml