@startuml
title US025 – "As a Buyer, I want to get the list of items on direct sale of a given author" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor Buyer
participant ":Mitelovers" as System

' --- System dialog ---
Buyer -> System: I want the list of items on direct sale of a given author
activate "System"
System --> Buyer: What is the author's name?
deactivate "System"
Buyer -> System: authorName
activate "System"
System --> Buyer: Here's the list! done!
deactivate "System"

@enduml