@startuml
'https://plantuml.com/sequence-diagram
'==== basic style ====

'hides unwanted text
hide stereotype

skinparam monochrome false

skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

'undefined objects
skinparam object {
  BackgroundColor<<highlight>> 91C6BCAA
  BorderColor<<highlight>> 4B9DA9AA
  FontColor<<highlight>> 547792AA
}
skinparam shadowing<<highlight>> false


title US022 "As a Buyer, I want to get the list of items on auction of a given genre - SSD"

actor User
participant ": Mitelovers"

hidefootbox

User -> ": Mitelovers" : I want the list of items on auction of a given genre
activate ": Mitelovers"
": Mitelovers" --> User : Which genre?
deactivate ": Mitelovers"
User -> ": Mitelovers" : genreName
activate ": Mitelovers"
": Mitelovers" --> User : Here's the list!
deactivate ": Mitelovers"


@enduml