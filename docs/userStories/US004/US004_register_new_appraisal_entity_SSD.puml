@startuml
title US004 - "Register a new Appraisal Entity, including \nthe genres and publication types it can appraise" - SSD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber


actor Administrator
participant "MiteLovers" as System

Administrator -> System: I want to register an Appraisal Entity
activate "System"
System --> Administrator: What is the Appraisal Entity's name?
Administrator -> System: HelpingzTM
System --> Administrator: Here's the list of Publication Types, \n which one(s) can it appraise?
Administrator -> System: Books
System --> Administrator: Here's the list of Genres, which \n one(s) can it appraise?
Administrator -> System: Self-Help
System --> Administrator: Done!
deactivate "System"

@enduml