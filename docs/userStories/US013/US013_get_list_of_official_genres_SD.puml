@startuml
title US013 - "As a user, I want to get the list of official genres" - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant ":GetListOfOfficialGenresUI" as UI
participant ":GetListOfOfficialGenresController" as CTL
participant "_gr:GenreRepo" as GR

' --- UI interaction ---
User -> UI: I want to get the list of official genres
activate UI


' --- Use case execution ---
UI -> CTL: getListOfOfficialGenres()
activate CTL
CTL -> GR: getListOfOfficialGenres()
activate GR

create "ListOfOfficialGenres:List<Genres>" as LO
GR -> LO: create()


GR --> CTL: ListOfOfficialGenres
deactivate GR
CTL --> UI: ListOfOfficialGenres
deactivate CTL
UI --> User: Here's the list! Done!
deactivate UI

@enduml