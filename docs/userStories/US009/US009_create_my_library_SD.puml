@startuml
title US009 - "As a user, I want to create my library" - SD
hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---
actor User
participant "UI1:CreateLibraryUI"
participant "Ctl1:CreateLibraryController"
participant "_lr:LibraryRepo"

' --- UI interaction ---
User -> "UI1:CreateLibraryUI": I want to create my library
activate "UI1:CreateLibraryUI"


' --- Use case execution ---
"UI1:CreateLibraryUI" -> "Ctl1:CreateLibraryController": createMyLibrary(userID)
activate "Ctl1:CreateLibraryController"
"Ctl1:CreateLibraryController" -> "_lr:LibraryRepo": createMyLibrary(userID)
activate "_lr:LibraryRepo"
"_lr:LibraryRepo" -> "_lr:LibraryRepo": myLibraryExists(userID)
create "myLibrary:Library"
"_lr:LibraryRepo" -> "myLibrary:Library": create(userID)
activate "myLibrary:Library"
"myLibrary:Library" --> "_lr:LibraryRepo": myLibrary
deactivate "myLibrary:Library"
"_lr:LibraryRepo" --> "Ctl1:CreateLibraryController": myLibrary
deactivate "_lr:LibraryRepo"
"Ctl1:CreateLibraryController" --> "UI1:CreateLibraryUI": myLibrary
deactivate "Ctl1:CreateLibraryController"
"UI1:CreateLibraryUI" --> User: done!
deactivate "UI1:CreateLibraryUI"

@enduml