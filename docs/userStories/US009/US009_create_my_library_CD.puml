@startuml
'https://plantuml.com/class-diagram
title US009 – "As a user, I want to create my library" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class CreateLibraryUI {
}

class CreateLibraryController {
  -_lr: LibraryRepo
  + createMyLibrary(user:User) : Library
}

class LibraryRepo {
  + create(user:User) : Library
  - myLibraryExists(user:User) : boolean
}

class Library {
  - _owner:User
  + Library(owner:User)
}

'class User {
'}

CreateLibraryUI "1" ..> "1" CreateLibraryController : invokes
CreateLibraryController "1" ..> "1" LibraryRepo : calls
LibraryRepo "1" --> "*" Library : creates
'User "1" --> "1" Library: owns

@enduml