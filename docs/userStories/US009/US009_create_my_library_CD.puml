@startuml
'https://plantuml.com/class-diagram
title US009 – "As a user, I want to create my library" - CD

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class CreateLibraryUI {
}

class CreateLibraryController {
  + createMyLibrary(user:User) : Library
}

class LibraryRepo {
  - myLibraryExists(user:User) : boolean
  + createMyLibrary(user:User) : Library
 '+ save(library: Library) : Library'

}
class LibraryFactory {
+ createMyLibrary(user:User) : Library
}

class Library {
  - _owner:User
  + Library(user:User)
  +belongsTo(user:User)
}

'class User {
'}

CreateLibraryUI "1" ..> "1" CreateLibraryController : invokes
'CreateLibraryController "1" ..> "1" FactoryLibrary : calls
CreateLibraryController "1" ..> "1" LibraryRepo : calls
'CreateLibraryController "1" --> "1" LibraryRepo : saves
LibraryRepo "1" --> "1" LibraryFactory : uses
LibraryFactory "1" --> "*" Library : creates
LibraryRepo "1" --> "*" Library : manages
'User "1" --> "1" Library: owns

@enduml