@startuml
'==== Title ====
title US007 - "As an Administrator, I want to register a new country in the system" - CD
top to bottom direction

'==== basic style ====
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA
skinparam classAttributeIconSize 0

'==== entities ====

Class Country {
- _countryName : String
- _admin : User
}
Class CountryRepo {
- _countries :List<Country>
+ registerCountry(countryName : String, admin : User) : Country
- existsCountry(country :Country) : boolean
}
Class RegisterCountryController {
+ registerCountry(countryName : String, admin : User) : Country
}
Class RegisterCountryUI {}

'==== connections ====

CountryRepo "1" --> "*" Country: instantiates through
RegisterCountryController  "1" ..> "1" CountryRepo: uses
RegisterCountryUI "1" ..> "1" RegisterCountryController: invokes

@enduml
