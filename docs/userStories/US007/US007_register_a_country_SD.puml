@startuml
'==== Title ====
title US007 - "As an Administrator, I want to register a new country in the system" - SD

'==== basic style ====
skinparam monochrome false

skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

hidefootbox
autonumber
autoactivate off

' ==== Actor and participants ====
actor Administrator as Adm
participant ":RegisterCountryUI" as UI
participant ":RegisterCountryController" as Ctl
participant ":CountryRepo" as _cr

'==== Processes ====

Adm -> UI: I want to register a country
activate UI
UI --> Adm: What is the country name?
deactivate UI
Adm -> UI: Country Name
activate UI

UI -> Ctl: registerCountry (countryName, admin)
activate Ctl

Ctl -> _cr: registerCountry (countryName, admin)
activate _cr
_cr -> _cr: findCountry (country)

create "c1:Country"
_cr -> "c1:Country": create (countryName, admin)

_cr -> _cr: add.(c1)

'==== Return ====

_cr --> Ctl: c1
deactivate _cr

Ctl --> UI: c1
deactivate Ctl

UI --> Adm : Country registered successfully!
deactivate UI
@enduml