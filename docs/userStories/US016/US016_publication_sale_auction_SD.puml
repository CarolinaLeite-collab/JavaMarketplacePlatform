@startuml
title US016 – "As a User, I want to put for sale a publication in my library in an auction" %n() SD
hide footbox
autonumber
autoactivate off

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

' ==== Actor and participants ====
actor "User" as User
participant "UI:PublicationSaleAuctionUI" as UI
participant "Ctl:PublicationSaleAuctionController" as Controller
participant ":ILibraryRepo" as ILibraryRepo
participant ":MemoAuctionRepo" as MemoAuction
participant ":AuctionFactory" as AuctionFactory
participant "item:Item" as selectedItem
participant "auction:Auction" as newAuction

'==== Initial UI interaction ====
User -> UI : I want to put an item from my library\nfor sale in an auction
activate UI

'==== Get the list of items in the user's library ====
UI -> Controller : getLibraryItemsList(user)
activate Controller

Controller -> ILibraryRepo : getItemsInLibraryByUser \n(userID)
activate ILibraryRepo

ILibraryRepo --> Controller : ListOfItemsInUserLibrary
deactivate ILibraryRepo

Controller --> UI : itemsList
deactivate Controller

'==== User selects the item and provides necessary details ====
UI --> User : Select the item to sell
deactivate UI

User -> UI : selectedItem
activate UI

UI --> User : Provide auction details
deactivate UI

User -> UI : startPrice, startDate, endDate
activate UI

'==== Put item up for auction ====
UI -> Controller : putItemOnAuction(selectedItem,\nstartPrice, startDate, endDate)
activate Controller

Controller -> MemoAuction : addAuction(selectedItem, \nstartPrice, startDate, endDate)
activate MemoAuction

MemoAuction -> AuctionFactory : createAuction(selectedItem, \nstartPrice, startDate, endDate)
activate AuctionFactory
create newAuction

AuctionFactory -->> newAuction : <<create>>
AuctionFactory --> MemoAuction : auction
deactivate AuctionFactory

MemoAuction --> Controller : auction
deactivate MemoAuction

Controller -> selectedItem : setAuction(auction)
activate selectedItem

selectedItem --> Controller : ok
deactivate selectedItem

Controller --> UI : ok
deactivate Controller

'==== Return message ====
UI --> User : Item successfully put up for auction
deactivate UI

@enduml