@startuml
'https://plantuml.com/class-diagram
title US019 – "As a user, I want to publicly share a List of mine.

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class ShareListPubliclyUI

class ShareListPubliclyController {
    - _listOfPublicationsRepo : ListOfPublicationsRepo
    + findListsByUser(user : User) : List<ListOfPublications>
    + shareListPublicly(list : ListOfPublications) : boolean
}

class ListOfPublicationsRepo {
    - _listsOfListOfPublications : List<ListOfPublications>
    + addListOnRep() : boolean
}

class ListOfPublications {
    - _name : String
    - _user : User
    - _publications : List<Publication>
    - _isPrivate : Boolean
    + switchVisibility() : void
    + getPublications() : void
}

"ShareListPubliclyUI" "1" --> "1" "ShareListPubliclyController" : request
"ShareListPubliclyController" "1" --> "1" "ListOfPublicationsRepo" : uses
"ListOfPublicationsRepo" "1" --> "1" "ListOfPublications" : stores

@enduml