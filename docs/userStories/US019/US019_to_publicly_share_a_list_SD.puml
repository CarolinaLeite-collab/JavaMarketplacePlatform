@startuml
'https://plantuml.com/sequence-diagram
hide footbox
title US019 - "As a User, I want to publicly share a list of mine" - SD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black


actor User
participant "UI : ShareListPubliclyUI" as UI
participant "CTL : ShareListPubliclyController" as CTL
participant "_lr : IListOfPublicationsRepo" as LPR
participant "selectedList : ListOfPublications" as SLP


User -> UI : I want to publicly share one List of mine.
activate UI
UI -> CTL : findListsByUser()
activate CTL
CTL -> LPR : findListsByUser()
activate LPR
LPR -> LPR : copy
LPR --> CTL : listOfLists
deactivate LPR
CTL --> UI : listOfLists
deactivate CTL
UI --> User : What List do you want to share?
deactivate UI
User -> UI : Selected List
activate UI
UI -> CTL : shareListPublicly(selectedList)
activate CTL
CTL -> SLP : switchVisibility()
CTL --> UI : true
deactivate CTL
UI --> User : List is now public
deactivate UI


@enduml