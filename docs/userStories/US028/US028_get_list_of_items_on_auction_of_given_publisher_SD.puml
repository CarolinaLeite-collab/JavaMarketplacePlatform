@startuml
'https://plantuml.com/sequence-diagram

autonumber
title US028 "As a Buyer, I want to get the list of items on auction of a given publisher" - SD

hidefootbox

'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black

autonumber
autoactivate off

' --- Actor and participants ---'

actor Buyer
participant "UI1:GetAuctionItemsByPublisherUI" as UI
participant "Ctl1:GetAuctionItemsByPublisherController" as Ctl
participant "_ar: AuctionRepo" as AuctionRepo
participant "_auction:Auction" as auction

Buyer -> UI:  I want to get the list of items\n on auction of a given publisher
activate UI
UI --> Buyer: What is the publisher?
deactivate UI

Buyer -> UI: publisher
activate UI

UI -> Ctl: getAuctionItemsByPublisher(publisher)
activate Ctl

Ctl -> AuctionRepo: getAuctionItemsByPublisher(publisher)
activate AuctionRepo


create "listOfAuctionItemsByPublisher: List<Item>" as List
AuctionRepo -> List : createListOfItems()
loop for each Auction in AuctionRepo
     AuctionRepo -> auction: isByPublisher(publisher)
    opt isByPublisher== true
        AuctionRepo -> List: add(auction.getItem())
        List --> AuctionRepo :true
    end
end

create "copyOfListOfAuctionItemsByPublisher: List<Item>" as Copy
AuctionRepo -> Copy:List.copyOf(listOfAuctionItemsByPublisher)

AuctionRepo --> Ctl : copyOfListOfAuctionItemsByPublisher
deactivate AuctionRepo
Ctl --> UI: copyOfListOfAuctionItemsByPublisher
deactivate Ctl
UI --> Buyer: Here's the list of items!
deactivate UI

@enduml