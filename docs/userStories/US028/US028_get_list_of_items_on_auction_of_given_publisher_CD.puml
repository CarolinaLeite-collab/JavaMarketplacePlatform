@startuml
'https://plantuml.com/class-diagram

title US028 "As a Buyer, I want to get the list of items on auction of a given publisher" - SD


'==== basic style ====
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0

class getAuctionItemsByPublisherUI{}

class GetAuctionItemsByPublishingCompanyController {
-_auctionRepo : AuctionRepo
-_buyer : User
-_publisher : Publisher
+getAuctionItemsByPublishingCompany(publisher : Publisher) : List<Item>
}

class AuctionRepo {
-_auctionList : List<Auction>
+getAuctionItemsByPublishingCompany(publisher : Publisher) : List<Item>
}

class Auction {
-_item : Item
+isByPublisher(publisher : Publisher) : boolean
}

getAuctionItemsByPublisherUI "1"..>"1" GetAuctionItemsByPublishingCompanyController:uses
GetAuctionItemsByPublishingCompanyController "1"..> "1"AuctionRepo : uses
AuctionRepo "1" --> "*"Auction: uses


@enduml