@startuml
title MiteLovers Logical View %n() Level 1

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam PackageBorderColor #4B9DA9
top to bottom direction

' Single component with two provided interfaces
component "MiteLovers" as MiteLovers <<System>>

interface "UI"  as UI_Interface
interface "API" as API_Interface

' MiteLovers provides these interfaces (lollipops on the component)
MiteLovers -- UI_Interface
MiteLovers -- API_Interface
@enduml