'========================
'title MiteLovers – OOA-G2 (Organizado)
top to bottom direction

'========================
'==== STYLE ====
hide stereotype
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Futura
skinparam objectFontSize 18
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ArrowColor #57595BAA

skinparam object {
  BackgroundColor<<highlight>> 91C6BCAA
  BorderColor<<highlight>> 4B9DA9AA
  FontColor<<highlight>> 547792AA
}
skinparam shadowing<<highlight>> false

'========================
'==== CORE USERS & ROLES ====
together {

  object User

  object Buyer
  object Seller
  object Bidder
  object Administrator
  object AppraisalEntity
  object SupportService <<highlight>>

}

  object logisticService <<highlight>>
  object CommunityMember <<highlight>>

'========================
'==== SERVICES ====



'========================
'==== MARKETPLACE CORE ====

  object Library
  object Bid

together {

  object Item
  object Publication
  object Auction
  object DirectSale
  object shoppingCart <<highlight>>
  object transaction <<highlight>>

  }

'========================
'==== RELATIONSHIPS ====

'---User---
User "1" -[#4B9DA9AA] "0..1" SupportService: < <font color="547792AA">supports</font>
User "1" -[#4B9DA9AA] "0..1" CommunityMember: < <font color="547792AA">is a</font>
User "1" -- "0..1" Bidder: < is a
User "1" -- "0..1" Seller: < is a
User "1" -- "0..1" Buyer: < is a
User "1" -- "0..1"Administrator: < is a

'--- Publications & Items ---
Publication "1" --- "*" Item : < embodies
Library "1" --- "*" Item : contains
User "1" --- "0..1" Library : owns
User "1" -- "*" Publication : registers
'User "1" ---- "*" ListOfPublications : creates
'ListOfPublications "1" -- "*" Item : owns

'--- Sales Types ---

Item "1" -- "1" DirectSale : is put on
Item "1" -- "1" Auction : is put on

shoppingCart "1" -- "0..1" transaction: < processes

Auction "1" - "*" Bid : > receives
Bid "*" - "1" Bidder : places

Buyer "1" --- "1..*" Item : buys
Buyer "1" - "1" shoppingCart: > owns

'--- Seller relations ---
Seller "1" ---- "1..*" Item : sells

'--- Appraisal & Support ---
Seller "1" -- "*" AppraisalEntity : requests
AppraisalEntity "*" -- "*" Item : appraises
Administrator "1" -- "*" AppraisalEntity : registers
AppraisalEntity "0..1" -- "1" SupportService : > is a

'--- Shopping Cart ---

Auction "*" -- "1" shoppingCart : added to
DirectSale "*" -- "1" shoppingCart : added to


User "*" --[#4B9DA9AA] "0..1" logisticService: <  <font color="547792AA">delivers to</font>


@enduml