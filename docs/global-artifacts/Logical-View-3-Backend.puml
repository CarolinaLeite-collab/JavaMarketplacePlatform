@startuml
title MiteLovers Logical View Shopping Cart%n() Level 3

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam PackageBorderColor #4B9DA9
top to bottom direction

component "Backend" as FE <<Component>> {
    port " " as API_Port

    component "Frameworks and drivers" as FRAME <<Component>> {
    port " " as API_frame_Port
    }
    component "Interface and adapters" as  INTER <<Component>>
    component "Enterprise Application Rules" as SERV <<Component>>
    component "Enterprise Business Rules" as BUSI <<Component>>

}

interface "API"

API_frame_Port -- API_Port
API -- API_Port
FRAME ..> INTER
INTER ..> SERV
SERV ..> BUSI
INTER ..> BUSI

}

@enduml