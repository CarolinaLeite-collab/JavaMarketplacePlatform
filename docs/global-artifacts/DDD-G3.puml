@startuml

'==== Title ====
title MiteLovers – DDD - Granularity 3
top to bottom direction

'==== basic style ====

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Futura
skinparam objectFontSize 20
skinparam backgroundColor CornSilk
skinparam objectBackgroundColor WhiteSmoke
skinparam noteBackgroundColor #FFFFE0
skinparam ArrowFontColor #3B4953
skinparam ActivationBackgroundColor black
skinparam classAttributeIconSize 0
skinparam PackageBorderColor #4B9DA9

hide circle

'--- Aggregate Roots ---'

Package "DOMAIN" {

    together {
        Package "USER" <<Folder>> #b0c4d4 {

            object User <<Aggregate Root>>

        }
        Package "CITY" <<Folder>> #b0c4d4 {

            object City <<Aggregate Root>>

        }
        Package "COUNTRY" <<Folder>> #b0c4d4 {

            object Country <<Aggregate Root>>

        }

        '== Value Objects (Ids) ==
        object UserId <<Value Object>> #LightPink
        object CityId <<Value Object>> #LightPink
        object CountryId <<Value Object>> #LightPink

        '== Value Objects (other) ==
        object Address <<Value Object>> #FFE6EE
    }

    together {


        Package "AUTHOR" <<Folder>> #b0c4d4 {

            object Author <<Aggregate Root>>

        }

        '== Value Objects (Ids) ==
        object AuthorId <<Value Object>> #LightPink


    }

    together {

        Package "APPRAISALENTITY" <<Folder>> #b0c4d4 {

            object AppraisalEntity <<Aggregate Root>>

        }

        object AppraisalEntityId <<Value Object>> #LightPink

    }


    together{
        Package "PUBLICATIONTYPE" <<Folder>> #b0c4d4 {

            object PublicationType <<Aggregate Root>>

        }

        Package "GENRE" <<Folder>> #b0c4d4 {

            object Genre <<Aggregate Root>>

        }

        '== Value Objects (Ids) ==
        object GenreId <<Value Object>> #LightPink
        object PublicationTypeId <<ValueObject>> #LightPink

    }

        together {

            Package "PUBLICATION" <<Folder>> #b0c4d4 {

                object Publication <<Aggregate Root>>

            }

            Package "EDITION" <<Folder>> #b0c4d4 {

                object Edition <<AggregateRoot>>


            }

            Package "PUBLISHINGCOMPANY" <<Folder>> #b0c4d4 {

                object PublishingCompany <<Aggregate Root>>


            }

            '== Value Object (Id) ==
            object EditionId <<Value Object>> #LightPink
            object PublishingCompanyId <<Value Object>> #LightPink

            '=== Value Objects (other) ===


            object PublicationId <<Value Object>> #LightPink

        }

'=== B4 ==
    together {

        Package "LIBRARY" <<Folder>> #b0c4d4 {

            object Library <<Aggregate Root>>

        }

        Package "LISTOFITEMS" <<Folder>> #b0c4d4 {

            object ListOfItems <<Aggregate Root>>

        }


    together {

        Package "ITEM" <<Folder>> #b0c4d4 {

            object Item <<Aggregate Root>>

        }

        Package "DIRECTSALE" <<Folder>> #b0c4d4 {

            object DirectSale <<Aggregate Root>>

        }

        Package "AUCTION" <<Folder>> #b0c4d4 {

            object Auction <<Aggregate Root>>
            object Bid <<Entity>>
        }

        together {
        Package "SHOPPINGCART" <<Folder>> #b0c4d4 {
            object ShoppingCart <<Aggregate Root>>
            object ShoppingCartLine <<Entity>>
}

        Package "SALE" <<Folder>> #b0c4d4 {
            object Sale <<Aggregate Root>>
            object SaleLine <<Entity>>
}
}

    }



    }

    object ItemId <<Value Object>> #LightPink
    object LibraryId <<Value Object>> #LightPink
    object DirectSaleId <<Value Object>> #LightPink
    object AuctionId <<Value Object>> #LightPink
    object ListOfItemsId <<Value Object>> #LightPink
    object ShoppingCartId <<Value Object>> #LightPink
    object SaleId <<Value Object>> #LightPink

}

'=== Correlations ==='

'--- Edition ---'
Edition "*" ..> "1" PublishingCompanyId : references
Edition "*" ..> "1" PublicationId : references
Edition "1" --> "1" EditionId : has
Edition "*" ..> "1" PublicationTypeId : references




'--- User ---'
User "1" --> "1" UserId : has
User "1" --> "1" Address : has

'--- Publication ---'
Publication "1" ..> "1" AuthorId : references
Publication "*" ..> "1" GenreId : references
Publication "1" --> "1" PublicationId : has

'--- PublicationType ---'
PublicationType "1" --> "1" PublicationTypeId : has

'--- PublishingCompany ---'
PublishingCompany "1" --> "1" PublishingCompanyId : has

'--- Author ---'
Author "1" --> "1" AuthorId : has

'--- Genre ---'
Genre "1" --> "1" GenreId : has

'--- AppraisalEntity ---'
AppraisalEntity "*" ..> "1..*" PublicationTypeId : references
AppraisalEntity "*" ..> "1..*" GenreId : references
AppraisalEntity "1" --> "1" AppraisalEntityId : has

'--- City ---'
City "1" ---> "1" CityId : has
City "*" ..> "1" CountryId : references

'--- Country ---'
Country "1" --> "1" CountryId : has

'--- Address ---'
Address "*" ..> "1" CityId : references

'--- Item ---'
Item "1" ..> "1" EditionId: references
Item "1" --> "1" ItemId: has
Item "1" ...> "1" UserId: references

'--- Library ---'
Library "*" ..> "1" ItemId: references
Library "1" ---> "1" LibraryId: has

'--- Auction ---'
Auction "1" -> "*" Bid
Auction "1" ..> "*" ItemId: references
Auction "1" ---> "1" AuctionId: has

'--- DirectSale ---'
DirectSale "1" .> "*" ItemId: references
DirectSale "1" ---> "1" DirectSaleId: has

'--- ListOfItems ---'
ListOfItems "1" ....> "*" ItemId: references
ListOfItems "1" ---> "1" ListOfItemsId: has

'--- ShoppingCart ---'
ShoppingCart "1" -> "1" ShoppingCartId : has
ShoppingCart "1" -> "*" ShoppingCartLine : contains
ShoppingCart "1" ..> "1" UserId : references
ShoppingCartLine "*" ..> "1" DirectSaleId : references
ShoppingCart "1" ..> "1" UserId : references

'--- Sale ---'
Sale "1" -> "1" SaleId : has
Sale "1" -> "*" SaleLine : contains
Sale "*" .> "1" UserId : references
SaleLine "*" .> "1" UserId : references
SaleLine "*" .> "1" DirectSaleId : references


@enduml